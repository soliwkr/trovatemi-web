{
  "name": "trovatemi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "wrangler types && astro check && wrangler types --check",
    "verify:v13": "node scripts/verify-v13.mjs",
    "qa:v13": "npm run check && npm run build && npm run verify:v13",
    "verify:reset": "node scripts/verify-v13.mjs",
    "qa:reset": "npm run check && npm run build && npm run verify:reset",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.3",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "astro": "7.1.1",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
