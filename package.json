{
  "name": "trovatemi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "qa:beauty": "node scripts/verify-beauty-production.mjs",
    "preview": "astro preview",
    "check": "wrangler types && astro check && wrangler types --check",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "preview:beauty:dry": "npm run build && wrangler deploy --dry-run --config wrangler.beauty-preview.jsonc",
    "preview:beauty:deploy": "npm run build && wrangler deploy --config wrangler.beauty-preview.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "astro": "7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
