---
import V4Layout from '../../../layouts/V4Layout.astro';
import { v4Categories, v4Posts } from '../../../data/v4';
export const prerender = true;
---

<V4Layout title="Product intelligence — TROVATEMI.IT" description="Analisi TROVATEMI per trasformare recensioni, reputazione e informazioni reali in segnali utili per persone, Google e ricerca AI.">
  <section class="v4-page-hero" data-watermark="GUIDE">
    <div class="v4-wrap"><div class="v4-breadcrumb"><a href="/brand-demo-v4/">Home</a> / Intelligence</div><p class="v4-kicker"><span>★</span> PRODUCT INTELLIGENCE</p><h1>CAPIRE COME AVVIENE LA SCELTA.</h1><p class="v4-lede">Problemi reali delle categorie, tradotti nelle informazioni, nelle prove e nelle automazioni che il prodotto deve mettere in movimento.</p></div>
  </section>
  <section class="v4-section v4-surface">
    <div class="v4-wrap v4-post-grid">
      {v4Posts.map((post) => {
        const category = v4Categories.find((item) => item.slug === post.categorySlug)!;
        return <article class="v4-post-card v4-reveal"><div><span>{category.name.toUpperCase()}</span><span>{post.readTime}</span></div><h3>{post.title}</h3><p>{post.excerpt}</p><a href={`/brand-demo-v4/blog/${post.slug}/`}>Leggi la guida ↗</a></article>;
      })}
    </div>
  </section>
</V4Layout>
