---
import V4Layout from '../../layouts/V4Layout.astro';
import { v4Categories } from '../../data/v4';
export const prerender = true;
---

<V4Layout title="Come funziona TROVATEMI — Dal cliente alla nuova scelta" description="Scopri come TROVATEMI raccoglie recensioni reali e le trasforma in risposte, contenuti e presenza comprensibile da persone, Google e assistenti AI.">
  <section class="v4-page-hero" data-watermark="SYSTEM">
    <div class="v4-wrap">
      <div class="v4-breadcrumb"><a href="/brand-demo-v4/">Home</a> / Prodotto</div>
      <p class="v4-kicker"><span>★</span> UN INPUT REALE. PIÙ OUTPUT UTILI.</p>
      <h1>IL CLIENTE ESCE SODDISFATTO. TROVATEMI INIZIA A LAVORARE.</h1>
      <p class="v4-lede">Il prodotto raccoglie la sua esperienza, prepara la risposta, crea prova sociale e mantiene aggiornate le informazioni che persone e motori usano per scegliere.</p>
    </div>
  </section>

  <section class="v4-problem-solution">
    <article class="v4-problem"><span>01 / SENZA SISTEMA</span><h2>LA FIDUCIA SPARISCE APPENA IL CLIENTE ESCE.</h2><p>Il lavoro è stato fatto bene, ma nessuno chiede la recensione, le risposte restano indietro e i contenuti dipendono dal tempo libero.</p></article>
    <article class="v4-solution"><span>02 / CON TROVATEMI</span><h2>OGNI ESPERIENZA DIVENTA MATERIALE PER LA PROSSIMA SCELTA.</h2><p>Un solo flusso collega richiesta, recensione, risposta, contenuto e pagina. L’AI esegue il lavoro ripetitivo; tu controlli ciò che richiede giudizio.</p></article>
  </section>

  <section class="v4-section v4-surface">
    <div class="v4-wrap v4-rule-heading v4-reveal"><span>03 / IL FLUSSO</span><h2 class="v4-section-title">QUATTRO PASSAGGI.<br /><em>UN SOLO SISTEMA.</em></h2><p>Non una collezione di servizi. Una sequenza che riparte ogni volta che entra una nuova esperienza reale.</p></div>
    <div class="v4-wrap v4-module-grid">
      <article><span>01</span><i>⌁</i><h3>Chiedi</h3><p>NFC, QR, SMS, email o WhatsApp nel momento giusto.</p></article>
      <article><span>02</span><i>★</i><h3>Raccogli</h3><p>La recensione entra senza filtri sul voto o sull’umore.</p></article>
      <article><span>03</span><i>✦</i><h3>Trasforma</h3><p>Gli agenti preparano risposta, contenuto e aggiornamento.</p></article>
      <article><span>04</span><i>◎</i><h3>Distribuisci</h3><p>La prova arriva nei luoghi in cui il prossimo cliente decide.</p></article>
    </div>
  </section>

  <section class="v4-section v4-proof-section">
    <div class="v4-wrap v4-rule-heading v4-reveal"><span>04 / CASI D’USO</span><h2 class="v4-section-title">IL MOTORE È UNO.<br /><em>IL MOMENTO CAMBIA.</em></h2><p>Entra nella configurazione più vicina alla tua attività. Nessuna città: il problema appartiene alla categoria, non al CAP.</p></div>
    <div class="v4-wrap v4-category-grid">{v4Categories.map((category) => <article class="v4-category-card v4-reveal" style={`--card-accent:${category.accent}`}><span>{category.code}</span><i>↗</i><h3>{category.name}</h3><p>{category.solutionBody}</p><a href={`/brand-demo-v4/per/${category.slug}/`}>Apri il caso d’uso</a></article>)}</div>
  </section>

  <section class="v4-cta-band v4-product-cta"><div class="v4-wrap"><div><span>NON UNA SLIDE.</span><h2>VEDI IL FLUSSO SULLA TUA ATTIVITÀ.</h2></div><button class="v4-button v4-button-dark js-v4-contact" type="button">Chiedi la demo a Chris <span>↗</span></button></div></section>
</V4Layout>
