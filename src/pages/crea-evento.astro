---
const title = 'Crea evento — Trovatemi';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#12161b" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #12161b;
        --paper: #f7f5ef;
        --star: #f5b301;
        --muted: #6b7280;
        --line: rgba(18, 22, 27, .13);
        --danger: #b42318;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; background: var(--paper); color: var(--ink); }
      button, input { font: inherit; }
      .shell { width: min(100%, 560px); margin: 0 auto; padding: 24px 18px 48px; }
      .brand { display: flex; align-items: center; gap: 8px; font-weight: 900; letter-spacing: -.03em; text-transform: uppercase; }
      .star { color: var(--star); }
      h1 { margin: 54px 0 10px; font-size: clamp(2.6rem, 11vw, 4.5rem); line-height: .91; letter-spacing: -.065em; max-width: 9ch; }
      .lead { margin: 0 0 30px; color: #424950; font-size: 1.08rem; line-height: 1.45; max-width: 34ch; }
      .upload { display: grid; gap: 12px; }
      .pick {
        min-height: 76px; border: 0; border-radius: 18px; padding: 0 22px;
        background: var(--ink); color: white; font-weight: 850; font-size: 1.04rem;
        display: flex; align-items: center; justify-content: space-between; cursor: pointer;
      }
      .pick.secondary { background: white; color: var(--ink); border: 1px solid var(--line); }
      .pick span:last-child { font-size: 1.5rem; }
      input[type=file] { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }
      .status { min-height: 24px; margin-top: 18px; color: var(--muted); font-size: .93rem; }
      .status.error { color: var(--danger); }
      .preview { display: none; margin-top: 26px; }
      .preview.visible { display: block; }
      .photo { width: 100%; max-height: 340px; object-fit: cover; border-radius: 22px; background: #e8e5dc; display: block; }
      .working {
        margin: 18px 0; padding: 14px 16px; border-radius: 14px; background: #fff4cf; font-weight: 750;
      }
      .result { display: none; margin-top: 34px; }
      .result.visible { display: block; }
      .eyebrow { text-transform: uppercase; letter-spacing: .1em; font-size: .72rem; font-weight: 900; color: #666; }
      h2 { margin: 7px 0 22px; font-size: 2rem; letter-spacing: -.045em; }
      .fields { display: grid; gap: 16px; }
      label { display: grid; gap: 7px; font-size: .76rem; font-weight: 900; text-transform: uppercase; letter-spacing: .06em; }
      input[type=text], input[type=date] {
        width: 100%; min-height: 54px; border-radius: 14px; border: 1px solid var(--line);
        background: white; color: var(--ink); padding: 0 15px; font-size: 1rem; outline: none;
      }
      input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(18,22,27,.08); }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .confidence { margin-top: 16px; font-size: .83rem; color: var(--muted); }
      .notes { margin-top: 8px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,.55); font-size: .9rem; line-height: 1.4; }
      .reset {
        margin-top: 22px; width: 100%; min-height: 52px; border: 1px solid var(--line);
        border-radius: 14px; background: transparent; font-weight: 800; cursor: pointer;
      }
      .gate { margin-top: 34px; border-top: 1px solid var(--line); padding-top: 18px; font-size: .82rem; color: var(--muted); }
      @media (max-width: 380px) { .two { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main class="shell">
      <div class="brand"><span>TROVATEMI.IT</span><span class="star">★</span></div>

      <section id="start">
        <h1>Metti il tuo evento.</h1>
        <p class="lead">Fai una foto alla locandina o carica uno screenshot. Tiriamo fuori i dati, tu controlli.</p>

        <div class="upload">
          <label class="pick" for="camera">
            <span>Fai una foto</span><span>＋</span>
          </label>
          <input id="camera" type="file" accept="image/*" capture="environment" />

          <label class="pick secondary" for="gallery">
            <span>Carica screenshot</span><span>↑</span>
          </label>
          <input id="gallery" type="file" accept="image/*" />
        </div>
        <div id="status" class="status" aria-live="polite"></div>
      </section>

      <section id="preview" class="preview" aria-live="polite">
        <img id="photo" class="photo" alt="Anteprima locandina caricata" />
        <div id="working" class="working">Sto leggendo la locandina…</div>
      </section>

      <section id="result" class="result">
        <div class="eyebrow">Abbiamo trovato questo</div>
        <h2>Controlla i dati.</h2>

        <div class="fields">
          <label>
            Titolo
            <input id="title" type="text" autocomplete="off" />
          </label>

          <div class="two">
            <label>
              Data
              <input id="date" type="date" />
            </label>
            <label>
              Ora
              <input id="time" type="text" inputmode="numeric" placeholder="21:00" autocomplete="off" />
            </label>
          </div>

          <label>
            Luogo
            <input id="venue" type="text" autocomplete="off" />
          </label>

          <label>
            Città
            <input id="city" type="text" autocomplete="address-level2" />
          </label>
        </div>

        <div id="confidence" class="confidence"></div>
        <div id="notes" class="notes" hidden></div>
        <button id="reset" class="reset" type="button">Usa un'altra immagine</button>
      </section>

      <p class="gate">Gate 1 · Nessun evento viene ancora pubblicato o salvato.</p>
    </main>

    <script>
      type ExtractedEvent = {
        title: string;
        date: string;
        time: string;
        venue: string;
        city: string;
        confidence: number;
        notes: string;
      };

      type ExtractionPayload = {
        event?: ExtractedEvent;
        error?: string;
        detail?: string;
      };

      function qs<T extends Element>(selector: string): T {
        const element = document.querySelector<T>(selector);
        if (!element) throw new Error('Missing element: ' + selector);
        return element;
      }

      const camera = qs<HTMLInputElement>('#camera');
      const gallery = qs<HTMLInputElement>('#gallery');
      const status = qs<HTMLDivElement>('#status');
      const preview = qs<HTMLElement>('#preview');
      const photo = qs<HTMLImageElement>('#photo');
      const working = qs<HTMLDivElement>('#working');
      const result = qs<HTMLElement>('#result');
      const reset = qs<HTMLButtonElement>('#reset');

      const fields: Record<'title' | 'date' | 'time' | 'venue' | 'city', HTMLInputElement> = {
        title: qs<HTMLInputElement>('#title'),
        date: qs<HTMLInputElement>('#date'),
        time: qs<HTMLInputElement>('#time'),
        venue: qs<HTMLInputElement>('#venue'),
        city: qs<HTMLInputElement>('#city'),
      };

      const confidence = qs<HTMLDivElement>('#confidence');
      const notes = qs<HTMLDivElement>('#notes');

      async function resizeImage(file: File) {
        const source = await createImageBitmap(file);
        const max = 1600;
        const scale = Math.min(1, max / Math.max(source.width, source.height));
        const width = Math.max(1, Math.round(source.width * scale));
        const height = Math.max(1, Math.round(source.height * scale));

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d', { alpha: false });
        if (!ctx) throw new Error('canvas_context_unavailable');
        ctx.drawImage(source, 0, 0, width, height);
        source.close();

        return canvas.toDataURL('image/jpeg', .82);
      }

      async function handleFile(file?: File) {
        if (!file || !file.type.startsWith('image/')) return;

        status.textContent = '';
        status.className = 'status';
        result.classList.remove('visible');

        try {
          const dataUrl = await resizeImage(file);
          photo.src = dataUrl;
          preview.classList.add('visible');
          working.hidden = false;

          const response = await fetch('/api/event-extract', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ image: dataUrl }),
          });

          const payload = await response.json() as ExtractionPayload;
          if (!response.ok || !payload.event) {
            const message = payload.detail
              ? (payload.error || 'extraction_failed') + ': ' + payload.detail
              : (payload.error || 'extraction_failed');
            throw new Error(message);
          }

          const event = payload.event;
          for (const key of ['title', 'date', 'time', 'venue', 'city'] as const) {
            fields[key].value = event[key] || '';
          }

          confidence.textContent = event.confidence
            ? 'Confidenza estrazione: ' + Math.round(event.confidence * 100) + '%'
            : 'Controlla con attenzione i dati estratti.';

          notes.textContent = event.notes || '';
          notes.hidden = !event.notes;

          working.hidden = true;
          result.classList.add('visible');
          result.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          working.hidden = true;
          const message = error instanceof Error ? error.message : String(error);
          status.textContent = message.includes('model_license_required')
            ? 'Sto attivando il modello Vision. Riprova tra un attimo.'
            : message.includes('vision_image_error')
              ? 'Il modello Vision ha rifiutato questa immagine. Riprova: se succede ancora, il codice errore qui sotto ci dice perché.'
              : 'Estrazione non riuscita. Dettaglio: ' + message.slice(0, 180);
          status.className = 'status error';
          console.error(error);
        }
      }

      camera.addEventListener('change', () => handleFile(camera.files?.[0]));
      gallery.addEventListener('change', () => handleFile(gallery.files?.[0]));

      reset.addEventListener('click', () => {
        camera.value = '';
        gallery.value = '';
        preview.classList.remove('visible');
        result.classList.remove('visible');
        status.textContent = '';
        photo.removeAttribute('src');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
