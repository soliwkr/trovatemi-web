---
import '@fontsource-variable/archivo';
import '@fontsource/anton';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta
      name="description"
      content="Cerca la tua attività e guarda come appari quando una persona deve scegliere tra te e le alternative che trova nella stessa ricerca."
    />
    <title>Trovatemi | Guarda come appari quando ti cercano</title>
  </head>

  <body>
    <main class="lookup">
      <header class="topbar">
        <a class="brand" href="/">TROVATEMI.IT <span>★</span></a>
        <a class="back-home" href="/">← Torna al sito</a>
      </header>

      <section class="search-screen" data-search-screen>
        <div class="search-copy">
          <p class="eyebrow">LA TUA ATTIVITÀ. COME APPARE OGGI.</p>
          <h1>GUARDA COME APPARI<br />QUANDO <mark>TI CERCANO.</mark></h1>
          <p>
            Scrivi nome e città. Trovatemi trova la tua scheda e ti mostra cosa vede una persona
            quando confronta la tua attività con altri risultati della stessa ricerca.
          </p>

          <form data-search-form>
            <label>
              <span>Nome attività + città</span>
              <input
                data-search-input
                type="search"
                placeholder="Es. Pizzeria Formia"
                autocomplete="organization"
                minlength="3"
                maxlength="120"
                required
              />
            </label>
            <button type="submit">CERCA LA TUA ATTIVITÀ →</button>
          </form>
          <small data-search-status>Dati Google reali quando disponibili.</small>
        </div>

        <div class="result-list" data-result-list>
          <div class="empty">
            <strong>SEI GIÀ BRAVO.</strong>
            <span>Adesso vediamo se online si capisce.</span>
          </div>
        </div>
      </section>

      <section class="snapshot" data-snapshot hidden>
        <div class="snapshot-head">
          <div>
            <p class="eyebrow">ECCO COME APPARI OGGI</p>
            <h2 data-business-name>La tua attività</h2>
            <p data-business-meta></p>
          </div>
          <button type="button" data-restart>CAMBIA ATTIVITÀ</button>
        </div>

        <div class="you-card">
          <span class="tag">TU</span>
          <div class="metric">
            <strong data-rating>—</strong>
            <small>valutazione</small>
          </div>
          <div class="metric">
            <strong data-reviews>—</strong>
            <small>recensioni visibili</small>
          </div>
        </div>

        <section class="same-query">
          <header>
            <p class="eyebrow">NELLA STESSA RICERCA</p>
            <h3>IL CLIENTE NON VEDE SOLO TE.</h3>
            <p>
              Questi sono altri risultati restituiti dalla stessa ricerca.
              Non è una classifica e non dice chi lavora meglio.
            </p>
          </header>
          <div class="other-grid" data-other-grid></div>
        </section>

        <section class="readout">
          <p class="eyebrow">LA LETTURA TROVATEMI</p>
          <h3 data-readout-title>La qualità non basta se la prova resta invisibile.</h3>
          <p data-readout-copy></p>
        </section>

        <section class="next">
          <div>
            <p class="eyebrow">ORA SAI DA DOVE PARTI.</p>
            <h3>IL PASSAPAROLA CHE HAI GIÀ.<br /><mark>MESSO AL LAVORO.</mark></h3>
            <p>
              Trovatemi lavora su raccolta recensioni, risposte e riuso della prova.
              Senza inventare ranking. Senza review gating.
            </p>
          </div>
          <div class="next-actions">
            <a class="primary" href="/#come-funziona">VEDI COME FUNZIONA →</a>
            <a class="secondary" href="/#contatto">VOGLIO PARLARNE →</a>
          </div>
        </section>
      </section>
    </main>

    <script>
      type Source = 'google_maps' | 'demo';

      type SearchCandidate = {
        id: string;
        name: string;
        address: string;
        category: string;
        source: Source;
      };

      type Business = {
        id: string;
        placeId?: string;
        name: string;
        address: string;
        category: string;
        rating: number | null;
        reviews: number | null;
        source: Source;
      };

      type ContextPlace = {
        id: string;
        name: string;
        address: string;
        category: string;
        rating: number | null;
        reviews: number | null;
      };

      const form = document.querySelector<HTMLFormElement>('[data-search-form]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const status = document.querySelector<HTMLElement>('[data-search-status]');
      const list = document.querySelector<HTMLElement>('[data-result-list]');
      const searchScreen = document.querySelector<HTMLElement>('[data-search-screen]');
      const snapshot = document.querySelector<HTMLElement>('[data-snapshot]');
      const otherGrid = document.querySelector<HTMLElement>('[data-other-grid]');

      let query = '';
      let business: Business | null = null;

      const text = (selector: string, value: string) => {
        const el = document.querySelector<HTMLElement>(selector);
        if (el) el.textContent = value;
      };

      const metric = (value: number | null, decimals = 0) => {
        if (value === null || Number.isNaN(value)) return '—';
        return decimals ? value.toFixed(decimals) : String(value);
      };

      const renderCandidates = (items: SearchCandidate[]) => {
        if (!list) return;
        list.replaceChildren();

        if (!items.length) {
          const p = document.createElement('p');
          p.className = 'no-results';
          p.textContent = 'Nessun risultato. Prova con nome attività + città.';
          list.appendChild(p);
          return;
        }

        items.forEach((item) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'result-row';

          const copy = document.createElement('span');
          const name = document.createElement('strong');
          const meta = document.createElement('small');
          name.textContent = item.name;
          meta.textContent = item.category + ' · ' + item.address;
          copy.appendChild(name);
          copy.appendChild(meta);

          const source = document.createElement('em');
          source.textContent = item.source === 'google_maps' ? 'Google Maps' : 'Demo';

          button.appendChild(copy);
          button.appendChild(source);
          button.addEventListener('click', () => void choose(item));
          list.appendChild(button);
        });
      };

      const search = async () => {
        query = input?.value.trim() ?? '';
        if (query.length < 3) return;
        if (status) status.textContent = 'Ricerca in corso…';

        try {
          const response = await fetch('/api/places/search?q=' + encodeURIComponent(query), {
            headers: { accept: 'application/json' },
          });

          if (!response.ok) throw new Error('search_failed');
          const payload = await response.json() as { places?: SearchCandidate[] };
          renderCandidates(Array.isArray(payload.places) ? payload.places : []);
          if (status) status.textContent = 'Seleziona la tua attività.';
        } catch {
          if (status) status.textContent = 'La ricerca non è disponibile in questo momento. Riprova.';
        }
      };

      const choose = async (candidate: SearchCandidate) => {
        try {
          const response = await fetch('/api/places/details?id=' + encodeURIComponent(candidate.id), {
            headers: { accept: 'application/json' },
          });
          if (!response.ok) throw new Error('details_failed');
          const payload = await response.json() as { business?: Business };
          if (!payload.business) throw new Error('missing_business');

          business = payload.business;

          const contextResponse = await fetch('/api/places/context?q=' + encodeURIComponent(query), {
            headers: { accept: 'application/json' },
          });
          const contextPayload = contextResponse.ok
            ? await contextResponse.json() as { places?: ContextPlace[] }
            : { places: [] };

          renderSnapshot(Array.isArray(contextPayload.places) ? contextPayload.places : []);
        } catch {
          if (status) status.textContent = 'Ho trovato l’attività, ma non riesco a leggere i dettagli. Riprova.';
        }
      };

      const renderSnapshot = (context: ContextPlace[]) => {
        if (!business) return;

        text('[data-business-name]', business.name);
        text('[data-business-meta]', business.category + ' · ' + business.address);
        text('[data-rating]', business.rating === null ? '—' : business.rating.toFixed(1) + ' ★');
        text('[data-reviews]', metric(business.reviews));

        const others = context
          .filter((item) => item.id !== business?.placeId && item.name !== business?.name)
          .slice(0, 3);

        if (otherGrid) {
          otherGrid.replaceChildren();

          others.forEach((item) => {
            const card = document.createElement('article');
            const name = document.createElement('strong');
            const meta = document.createElement('span');
            const metrics = document.createElement('div');

            name.textContent = item.name;
            meta.textContent = item.category || item.address;
            metrics.textContent =
              (item.rating === null ? '—' : item.rating.toFixed(1) + ' ★') +
              ' · ' +
              (item.reviews === null ? '—' : String(item.reviews)) +
              ' recensioni';

            card.appendChild(name);
            card.appendChild(meta);
            card.appendChild(metrics);
            otherGrid.appendChild(card);
          });

          if (!others.length) {
            const p = document.createElement('p');
            p.className = 'no-context';
            p.textContent = 'Google non ci ha restituito altri risultati abbastanza chiari da mostrare. Non inventiamo il confronto.';
            otherGrid.appendChild(p);
          }
        }

        const knownReviewCounts = others
          .map((item) => item.reviews)
          .filter((value): value is number => Number.isInteger(value));

        const ownReviews = Number.isInteger(business.reviews) ? Number(business.reviews) : null;
        const maxOther = knownReviewCounts.length ? Math.max(...knownReviewCounts) : null;

        if (ownReviews !== null && maxOther !== null && maxOther > ownReviews) {
          const gap = maxOther - ownReviews;
          text('[data-readout-title]', 'SEI PIÙ BRAVO? PUÒ DARSI. MA ONLINE DEVE VEDERSI.');
          text(
            '[data-readout-copy]',
            'In questa stessa ricerca compare almeno un’altra attività con ' +
            gap +
            ' recensioni visibili in più. Non significa che lavori meglio. Significa che, prima di conoscerti, il cliente vede più prova.'
          );
        } else {
          text('[data-readout-title]', 'LA PROVA C’È. ADESSO DEVE LAVORARE.');
          text(
            '[data-readout-copy]',
            'Sul numero di recensioni non emerge qui uno svantaggio evidente. Il passo successivo è capire quanto bene raccogli, rispondi e riusi la prova che i clienti ti stanno già dando.'
          );
        }

        if (searchScreen) searchScreen.hidden = true;
        if (snapshot) snapshot.hidden = false;
        window.scrollTo({ top: 0, behavior: 'instant' });
      };

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        void search();
      });

      document.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
        if (snapshot) snapshot.hidden = true;
        if (searchScreen) searchScreen.hidden = false;
        if (list) {
          list.innerHTML = '<div class="empty"><strong>SEI GIÀ BRAVO.</strong><span>Adesso vediamo se online si capisce.</span></div>';
        }
        if (input) {
          input.value = '';
          input.focus();
        }
        if (status) status.textContent = 'Dati Google reali quando disponibili.';
      });
    </script>
  </body>
</html>

<style>
  :root {
    --black: #08090a;
    --white: #fff;
    --paper: #f7f5ef;
    --yellow: #f6c400;
    --grey: #6d6d67;
    --line: #d9d5cb;
  }

  * { box-sizing: border-box; }

  html { background: var(--black); }

  body {
    margin: 0;
    color: var(--black);
    background: var(--paper);
    font-family: "Archivo Variable", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  [hidden] { display: none !important; }

  .lookup { min-height: 100dvh; }

  .topbar {
    display: flex;
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 clamp(18px, 4vw, 60px);
    color: white;
    background: var(--black);
  }

  .brand {
    color: white;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: 1.35rem;
    text-decoration: none;
  }

  .brand span { color: var(--yellow); }

  .back-home {
    color: #b9b9b4;
    font-size: .72rem;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #987700;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .11em;
  }

  .search-screen {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
    max-width: 1500px;
    min-height: calc(100dvh - 70px);
    margin: 0 auto;
    padding: clamp(60px, 8vw, 120px) clamp(20px, 5vw, 76px);
  }

  .search-copy h1,
  .snapshot h2,
  .same-query h3,
  .readout h3,
  .next h3 {
    margin: 0;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-weight: 400;
    line-height: .92;
  }

  .search-copy h1 {
    max-width: 11ch;
    font-size: clamp(4.2rem, 8vw, 8rem);
  }

  mark {
    color: var(--black);
    background: var(--yellow);
    padding-inline: .08em;
  }

  .search-copy > p:not(.eyebrow) {
    max-width: 650px;
    margin: 1.6rem 0 2rem;
    color: var(--grey);
    line-height: 1.6;
  }

  form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .8rem;
    align-items: end;
  }

  label {
    display: grid;
    gap: .45rem;
  }

  label span {
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  input {
    min-height: 58px;
    border: 1px solid var(--black);
    border-radius: 0;
    padding: 0 1rem;
    font: inherit;
    background: white;
  }

  button,
  .primary,
  .secondary {
    min-height: 58px;
    border: 1px solid var(--black);
    padding: .95rem 1.15rem;
    font: inherit;
    font-size: .74rem;
    font-weight: 900;
    cursor: pointer;
  }

  form button,
  .primary {
    color: var(--black);
    background: var(--yellow);
    text-decoration: none;
  }

  form + small {
    display: block;
    margin-top: .7rem;
    color: var(--grey);
    font-size: .68rem;
  }

  .result-list {
    border-top: 3px solid var(--black);
  }

  .empty {
    display: grid;
    min-height: 320px;
    align-content: center;
  }

  .empty strong {
    max-width: 7ch;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(3.5rem, 6vw, 6rem);
    font-weight: 400;
    line-height: .93;
  }

  .empty span {
    margin-top: 1rem;
    color: var(--grey);
  }

  .result-row {
    display: grid;
    width: 100%;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    text-align: left;
  }

  .result-row:hover {
    background: white;
  }

  .result-row > span {
    display: grid;
    gap: .25rem;
  }

  .result-row strong { font-size: .98rem; }
  .result-row small { color: var(--grey); font-size: .72rem; }
  .result-row em { color: var(--grey); font-size: .64rem; font-style: normal; text-transform: uppercase; }

  .snapshot {
    color: white;
    background: var(--black);
  }

  .snapshot-head,
  .same-query,
  .readout,
  .next {
    padding: clamp(60px, 8vw, 120px) clamp(20px, 5vw, 76px);
  }

  .snapshot-head {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    max-width: 1500px;
    margin: 0 auto;
  }

  .snapshot .eyebrow { color: var(--yellow); }

  .snapshot h2 {
    max-width: 12ch;
    font-size: clamp(4.2rem, 8vw, 8rem);
  }

  .snapshot-head > div > p:last-child {
    margin: 1rem 0 0;
    color: #aaa9a4;
  }

  .snapshot-head button {
    color: white;
    border-color: #444;
    background: transparent;
  }

  .you-card {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 1500px;
    margin: 0 auto;
    border-top: 1px solid #333;
    border-bottom: 1px solid #333;
    padding: 2rem clamp(20px, 5vw, 76px);
  }

  .tag {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 50%;
    color: var(--black);
    background: var(--yellow);
    font-size: .72rem;
    font-weight: 900;
  }

  .metric strong {
    display: block;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(3.5rem, 6vw, 6rem);
    font-weight: 400;
    line-height: .9;
  }

  .metric small {
    color: #999994;
    font-size: .68rem;
    text-transform: uppercase;
  }

  .same-query {
    max-width: 1500px;
    margin: 0 auto;
  }

  .same-query header {
    display: grid;
    grid-template-columns: .8fr 1fr;
    gap: 2rem 5rem;
    align-items: end;
  }

  .same-query header .eyebrow { grid-column: 1 / -1; }

  .same-query h3 {
    font-size: clamp(3.2rem, 6vw, 6rem);
  }

  .same-query header > p:last-child {
    margin: 0;
    color: #aaa9a4;
    line-height: 1.55;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 2rem;
    border-top: 1px solid #333;
    border-bottom: 1px solid #333;
  }

  .other-grid article {
    min-height: 220px;
    border-right: 1px solid #333;
    padding: 1.3rem;
  }

  .other-grid article:last-child { border-right: 0; }

  .other-grid strong {
    display: block;
    font-size: 1rem;
  }

  .other-grid span {
    display: block;
    min-height: 3em;
    margin-top: .4rem;
    color: #8f8f8a;
    font-size: .72rem;
  }

  .other-grid div {
    margin-top: 3rem;
    color: var(--yellow);
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: 1.8rem;
  }

  .readout {
    color: var(--black);
    background: var(--yellow);
  }

  .readout .eyebrow { color: #5f4d00; }

  .readout h3 {
    max-width: 15ch;
    font-size: clamp(3.8rem, 7vw, 7rem);
  }

  .readout > p:last-child {
    max-width: 800px;
    margin: 1.5rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  .next {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
    max-width: 1500px;
    margin: 0 auto;
  }

  .next h3 {
    max-width: 12ch;
    font-size: clamp(3.5rem, 6vw, 6rem);
  }

  .next h3 mark {
    color: var(--yellow);
    background: transparent;
    padding: 0;
  }

  .next > div > p:last-child {
    max-width: 650px;
    margin: 1.4rem 0 0;
    color: #aaa9a4;
    line-height: 1.55;
  }

  .next-actions {
    display: grid;
    gap: .7rem;
    min-width: 260px;
  }

  .primary,
  .secondary {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .secondary {
    color: white;
    border-color: #555;
    background: transparent;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .search-screen,
    .same-query header,
    .next {
      grid-template-columns: 1fr;
    }

    .same-query header .eyebrow { grid-column: 1; }

    .other-grid { grid-template-columns: 1fr; }

    .other-grid article {
      border-right: 0;
      border-bottom: 1px solid #333;
    }

    .other-grid article:last-child { border-bottom: 0; }

    .you-card { grid-template-columns: auto 1fr; }
    .you-card .metric:last-child { grid-column: 2; }

    .next-actions { min-width: 0; }
  }

  @media (max-width: 620px) {
    .topbar { min-height: 62px; padding-inline: 16px; }
    .brand { font-size: 1.05rem; }

    .search-screen,
    .snapshot-head,
    .same-query,
    .readout,
    .next {
      padding-inline: 18px;
    }

    .search-screen { min-height: auto; padding-top: 54px; padding-bottom: 70px; }

    .search-copy h1,
    .snapshot h2,
    .same-query h3,
    .readout h3,
    .next h3 {
      font-size: clamp(3.3rem, 16vw, 5rem);
    }

    form { grid-template-columns: 1fr; }
    form button { width: 100%; }

    .snapshot-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .you-card {
      grid-template-columns: 1fr 1fr;
      padding-inline: 18px;
    }

    .tag { grid-column: 1 / -1; }
    .you-card .metric:last-child { grid-column: auto; }
  }
</style>
