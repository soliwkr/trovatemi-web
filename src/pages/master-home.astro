---
import '@fontsource/anton/latin.css';
import '@fontsource-variable/archivo';
import '../styles/master-home-v2.css';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Trovatemi fa vedere online quanto sei bravo davvero. Il passaparola che hai già, messo al lavoro."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#11110f" />
    <title>Trovatemi.it ★ — Fai vedere online quanto sei bravo davvero.</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>

    <header class="topbar">
      <a class="wordmark" href="/master-home/" aria-label="Trovatemi.it, home">TROVATEMI.IT <span>★</span></a>
      <a class="top-cta" href="#la-tua-attivita">LA TUA ATTIVITÀ ↓</a>
    </header>

    <main id="contenuto">
      <section class="beat beat-hero" aria-labelledby="hero-title">
        <img class="beat-bg" src="/images/master-home-hero-v3.webp" width="1536" height="1024" alt="Cliente che lascia un’attività locale" fetchpriority="high" />
        <div class="shade shade-left" aria-hidden="true"></div>
        <div class="shell hero-copy">
          <p class="eyebrow">PER LE ATTIVITÀ CHE LAVORANO BENE</p>
          <h1 id="hero-title">Hai già<br />clienti felici.<br /><em>Fai in modo<br />che si veda.</em></h1>
          <p class="product-truth">Trovatemi fa vedere online quanto sei bravo davvero.</p>
          <p class="quiet">Il passaparola c’è. Solo che gira male.</p>
          <a class="beat-link" href="#storia-1">GUARDA COSA SUCCEDE <span>↓</span></a>
        </div>
      </section>

      <section id="storia-1" class="beat beat-dark story-compliment" aria-labelledby="story1-title">
        <div class="shell story-grid">
          <div class="story-copy">
            <p class="story-no">STORIA 01</p>
            <blockquote id="story1-title">“Mi sono trovata<br /><em>benissimo.</em>”</blockquote>
            <div class="beats" aria-label="La scena">
              <span>Grazie ❤️</span>
              <span>Paga.</span>
              <span>Esce.</span>
              <span>Fine.</span>
            </div>
          </div>
          <figure class="story-photo">
            <img src="/images/master-home-goodbye.webp" width="1536" height="1024" alt="Una cliente saluta ed esce" loading="lazy" />
            <figcaption>NESSUNA TRACCIA.</figcaption>
          </figure>
        </div>
        <div class="punch punch-gold"><div class="shell"><span>Peccato che</span><strong>Google non era lì.</strong><b>★</b></div></div>
      </section>

      <section id="storia-2" class="beat beat-missing" aria-labelledby="story2-title">
        <img class="beat-bg" src="/images/master-home-missing-v3.webp" width="1536" height="1024" alt="Scontrini e prove che si perdono" loading="lazy" />
        <div class="shade shade-left" aria-hidden="true"></div>
        <div class="shell missing-copy">
          <p class="story-no">STORIA 02</p>
          <div class="big-stat"><strong>50</strong><span>clienti<br />felici.</span></div>
          <div class="big-stat accent"><strong>4</strong><span>recensioni.</span></div>
          <h2 id="story2-title">Dove sono finite<br /><em>le altre 46?</em></h2>
          <p class="quiet">Quattro prove restano. Il resto della giornata sparisce.</p>
        </div>
      </section>

      <section id="storia-3" class="beat beat-paper compare" aria-labelledby="story3-title">
        <div class="shell compare-wrap">
          <p class="story-no">STORIA 03</p>
          <div class="compare-head">
            <h2 id="story3-title">Sei più bravo.</h2>
            <p>Lui ha <strong>384</strong> recensioni.<br />Tu <strong>41</strong>.</p>
            <h3>Indovina chi sembra più bravo.</h3>
          </div>
          <div class="compare-visual">
            <figure>
              <img src="/images/master-home-compare-v3.webp" width="1536" height="1024" alt="Confronto tra due attività locali" loading="lazy" />
            </figure>
            <div class="count-card count-them"><span>LUI</span><strong>384</strong><small>RECENSIONI</small></div>
            <div class="count-card count-you"><span>TU</span><strong>41</strong><small>RECENSIONI</small></div>
          </div>
          <div class="yellow-strip">Essere più bravo non basta.<br /><strong>Devi sembrarlo quando scelgono.</strong></div>
        </div>
      </section>

      <section id="storia-4" class="beat beat-dark solution" aria-labelledby="story4-title">
        <div class="shell solution-grid">
          <div class="solution-copy">
            <p class="story-no">STORIA 04</p>
            <h2 id="story4-title">Quando il passaparola<br /><em>non sparisce.</em></h2>
            <p class="product-truth compact">Trovatemi fa vedere online quanto sei bravo davvero.</p>
          </div>
          <figure class="solution-photo">
            <img src="/images/master-home-proof-v2.webp" width="1536" height="1024" alt="Cliente che usa il telefono sul bancone" loading="lazy" />
          </figure>
          <ol class="story-flow" aria-label="Come continua a lavorare il passaparola">
            <li><b>01</b><strong>Cliente contento</strong><span>Succede già.</span></li>
            <li><b>02</b><strong>Richiesta</strong><span>Arriva al momento giusto.</span></li>
            <li><b>03</b><strong>Recensione</strong><span>Diventa visibile.</span></li>
            <li><b>04</b><strong>Risposta</strong><span>Non resta sola.</span></li>
            <li><b>05</b><strong>Riuso</strong><span>Continua a parlare di te.</span></li>
          </ol>
          <div class="brand-signature"><span>★</span><p>Il passaparola che hai già.<br /><strong>Messo al lavoro.</strong></p></div>
        </div>
      </section>

      <section id="la-tua-attivita" class="beat beat-gold lookup" aria-labelledby="lookup-title">
        <div class="shell lookup-wrap">
          <p class="story-no">ADESSO TOCCA A TE</p>
          <h2 id="lookup-title">Cerca la tua attività.</h2>
          <p>Il punto è vedere cosa vede davvero un cliente quando cerca te, non una demo generica.</p>
          <div class="fake-search" aria-label="Anteprima della futura ricerca attività">
            <span>Nome attività o città</span><button type="button" disabled aria-disabled="true">CERCA →</button>
          </div>
          <small>La ricerca reale verrà attivata con L2. Qui non mostriamo dati inventati.</small>
        </div>
      </section>

      <section id="prezzo" class="beat beat-paper offer" aria-labelledby="offer-title">
        <div class="shell offer-grid">
          <div>
            <p class="story-no">UNA SOLA OFFERTA</p>
            <h2 id="offer-title">21 giorni.<br /><em>Zero teoria.</em></h2>
            <p>Mettiamo Trovatemi sulla tua attività. Tu guardi cosa succede davvero.</p>
          </div>
          <div class="price-poster">
            <span>DURANTE IL TRIAL</span>
            <strong>€0</strong>
            <small>PER 21 GIORNI</small>
            <hr />
            <span>DAL GIORNO 22</span>
            <strong>€149<small>/MESE</small></strong>
            <p>per sede, salvo cancellazione prima del rinnovo</p>
          </div>
        </div>
      </section>

      <section class="beat beat-dark final-cta" aria-labelledby="final-title">
        <div class="shell final-wrap">
          <h2 id="final-title">Hai già clienti felici.<br /><em>Fai in modo che si veda.</em></h2>
          <div class="route-row">
            <a href="/" class="route-primary">BEAUTY &amp; WELLNESS → <small>Fai il Beauty Check</small></a>
            <a href="#la-tua-attivita" class="route-secondary">ALTRA ATTIVITÀ LOCALE → <small>Partiamo dalla tua attività</small></a>
          </div>
          <div class="footer-line"><strong>TROVATEMI.IT ★</strong><span>21 GIORNI · €0 DURANTE IL TRIAL · POI €149/MESE</span></div>
        </div>
      </section>
    </main>
  </body>
</html>
