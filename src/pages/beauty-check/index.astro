---
import BeautyLeanLayout from '../../layouts/BeautyLeanLayout.astro';
import { diagnosticQuestions } from '../../data/beauty-check-v2.mjs';
import '../../styles/beauty-check-v2.css';
---

<BeautyLeanLayout
  title="Trovatemi | Il passaparola che hai già. Messo al lavoro."
  description="Cerca la tua attività. Guarda cosa vede chi deve scegliere. Scopri dove il tuo passaparola smette di diventare prova visibile."
>
  <div class="proof-app" data-proof-app>
    <header class="proof-topbar">
      <a class="proof-brand" href="/" aria-label="Trovatemi home">TROVATEMI.IT <span>★</span></a>
      <div class="proof-progress" aria-label="Avanzamento">
        <span data-progress-label>Trova</span>
        <b data-progress-count>01 / 05</b>
      </div>
      <button class="proof-back" type="button" data-back hidden>Indietro</button>
    </header>

    <main>
      <section class="proof-step proof-search" data-step="search">
        <div class="proof-hero-copy">
          <p class="eyebrow">IL PASSAPAROLA CHE HAI GIÀ. MESSO AL LAVORO.</p>
          <h1>Ti cercano.<br />Ti confrontano.<br /><em>Ti scelgono in pochi secondi.</em></h1>
          <p class="lead">
            Cerca la tua attività. Prima di parlare di marketing, guardiamo cosa vede davvero
            una persona quando deve scegliere.
          </p>

          <form class="search-form" data-search-form>
            <label>
              <span>Nome attività + città</span>
              <input
                type="search"
                data-search-input
                placeholder="Es. Nails Formia"
                autocomplete="organization"
                minlength="3"
                maxlength="120"
                required
              />
            </label>
            <button class="cta" type="submit">CERCA LA TUA ATTIVITÀ →</button>
          </form>
          <p class="microcopy" data-search-message>Google Maps · dati pubblici correnti quando disponibili.</p>
        </div>

        <div class="search-results" data-search-results aria-live="polite">
          <div class="search-placeholder">
            <strong>SEI GIÀ BRAVO.</strong>
            <p>Adesso vediamo se online si capisce.</p>
          </div>
        </div>
      </section>

      <section class="proof-step proof-compare" data-step="compare" hidden>
        <header class="section-intro">
          <p class="eyebrow">QUELLO CHE VEDE IL CLIENTE</p>
          <h2>Sei più bravo?<br /><em>Può darsi.</em></h2>
          <p>Ma prima di entrare nel tuo locale, il cliente può giudicare solo le prove che trova.</p>
        </header>

        <div class="comparison-grid">
          <article class="google-card google-card--you">
            <span class="card-kicker">TU</span>
            <h3 data-you-name>La tua attività</h3>
            <p data-you-category>Attività locale</p>
            <div class="google-metrics">
              <strong><span data-you-rating>—</span> ★</strong>
              <span><b data-you-reviews>—</b> recensioni</span>
            </div>
            <small data-you-address></small>
          </article>

          <div class="comparison-vs">VS</div>

          <article class="google-card google-card--other" data-other-card>
            <span class="card-kicker">UN ALTRO RISULTATO DELLA STESSA RICERCA</span>
            <h3 data-other-name>—</h3>
            <p data-other-category>—</p>
            <div class="google-metrics">
              <strong><span data-other-rating>—</span> ★</strong>
              <span><b data-other-reviews>—</b> recensioni</span>
            </div>
            <small data-other-address></small>
          </article>
        </div>

        <p class="evidence-note" data-comparison-note>
          Non è una classifica e non misura chi lavora meglio. È semplicemente ciò che Google
          mostra nella stessa ricerca.
        </p>

        <div class="campaign-line">
          <span>ESSERE PIÙ BRAVO NON BASTA.</span>
          <strong>DEVI SEMBRARLO QUANDO SCELGONO.</strong>
        </div>

        <button class="cta" type="button" data-next="numbers">VEDI QUANTO PASSAPAROLA STAI LASCIANDO FERMO →</button>
      </section>

      <section class="proof-step proof-numbers" data-step="numbers" hidden>
        <header class="section-intro">
          <p class="eyebrow">PASSAPAROLA PERSO</p>
          <h2>Quanti clienti felici<br />diventano <em>prova visibile?</em></h2>
          <p>Qui non indoviniamo: ci servono due numeri tuoi.</p>
        </header>

        <form class="numbers-form" data-numbers-form>
          <label>
            <span>Clienti serviti in una settimana normale</span>
            <input type="number" name="weeklyClients" min="1" max="5000" inputmode="numeric" placeholder="50" required />
          </label>
          <label>
            <span>Nuove recensioni ricevute circa negli ultimi 30 giorni</span>
            <input type="number" name="recentReviews" min="0" max="10000" inputmode="numeric" placeholder="4" required />
          </label>
          <button class="cta" type="submit">FAMMI VEDERE →</button>
        </form>

        <div class="loss-board" data-loss-board hidden>
          <div>
            <span>ESPERIENZE CLIENTE / MESE</span>
            <strong data-monthly-clients>—</strong>
            <small>stima da clienti settimanali × 4,33</small>
          </div>
          <div>
            <span>NUOVE RECENSIONI / 30 GIORNI</span>
            <strong data-recent-reviews>—</strong>
            <small>numero indicato da te</small>
          </div>
          <div class="loss-question">
            <span>IL PUNTO NON È CHE TUTTI DOVREBBERO RECENSIRE.</span>
            <strong>È quanta soddisfazione resta invisibile.</strong>
          </div>
          <p data-math-disclaimer></p>
          <button class="cta cta--light" type="button" data-next="questions">VEDI DOVE SI SPEZZA →</button>
        </div>
      </section>

      <section class="proof-step proof-questions" data-step="questions" hidden>
        <header class="section-intro">
          <p class="eyebrow">TRE DOMANDE. FINE.</p>
          <h2>Dove si ferma<br />il tuo <em>passaparola?</em></h2>
          <p>Rispondi su quello che succede normalmente, non sul giorno migliore.</p>
        </header>

        <div class="question-stack">
          {diagnosticQuestions.map((question, index) => (
            <article class="question-block" data-question-block={question.id}>
              <header>
                <span>0{index + 1} · {question.eyebrow}</span>
                <h3>{question.title}</h3>
              </header>
              <div class="answer-grid">
                {question.options.map(([value, label]) => (
                  <button
                    class="answer-option"
                    type="button"
                    data-question={question.id}
                    data-answer={value}
                  >
                    {label}
                  </button>
                ))}
              </div>
            </article>
          ))}
        </div>

        <button class="cta" type="button" data-diagnose disabled>DIMMI DOVE SI SPEZZA →</button>
      </section>

      <section class="proof-step proof-diagnosis" data-step="diagnosis" hidden>
        <div class="diagnosis-hero">
          <p class="eyebrow">ECCO IL PUNTO</p>
          <span class="diagnosis-label" data-diagnosis-label>PASSAPAROLA</span>
          <h2 data-diagnosis-headline>Il tuo passaparola si ferma all’uscita.</h2>
          <p data-diagnosis-why></p>
        </div>

        <div class="diagnosis-proof">
          <article>
            <span>GOOGLE OGGI</span>
            <strong><b data-diagnosis-reviews>—</b> recensioni</strong>
            <small data-diagnosis-rating>—</small>
          </article>
          <article>
            <span>IL TUO VOLUME</span>
            <strong><b data-diagnosis-monthly>—</b> esperienze / mese</strong>
            <small>stima orientativa dal volume dichiarato</small>
          </article>
        </div>

        <section class="action-plan">
          <header>
            <p class="eyebrow">ECCO COSA FAREI AL POSTO TUO</p>
            <h3>Prima questo.<br />Poi il resto.</h3>
          </header>
          <ol data-actions></ol>
        </section>

        <button class="cta cta--light" type="button" data-next="system">METTILO A SISTEMA →</button>
      </section>

      <section class="proof-step proof-system" data-step="system" hidden>
        <header class="system-head">
          <p class="eyebrow">TROVATEMI</p>
          <h2>Le persone lo dicono.<br />Noi lo facciamo <em>lavorare.</em></h2>
          <p>
            Trovatemi trasforma il passaparola che hai già in un processo: raccolta,
            risposta e riuso della prova, senza review gating e senza promettere posizioni su Google.
          </p>
        </header>

        <div class="system-flow" aria-label="Come lavora Trovatemi">
          <article><span>01</span><strong>CLIENTE FELICE</strong><p>L’esperienza succede già.</p></article>
          <i>→</i>
          <article><span>02</span><strong>RECENSIONE</strong><p>La soddisfazione lascia una traccia.</p></article>
          <i>→</i>
          <article><span>03</span><strong>RISPOSTA</strong><p>La prova viene curata.</p></article>
          <i>→</i>
          <article><span>04</span><strong>CONTENUTO</strong><p>La prova torna visibile dove è operativo.</p></article>
          <i>→</i>
          <article><span>05</span><strong>SCELTA</strong><p>Il prossimo cliente ha più elementi per fidarsi.</p></article>
        </div>

        <div class="offer-board">
          <div>
            <span>PROVALO NEL LAVORO VERO</span>
            <strong>21 GIORNI · €0</strong>
            <p>Poi €149/mese per sede. Cancelli prima del rinnovo se non fa per te.</p>
          </div>
          <a class="cta cta--light" href="/#offerta">VEDI L’OFFERTA →</a>
        </div>

        <footer class="proof-close">
          <strong>TROVATEMI.IT <span>★</span></strong>
          <p>IL PASSAPAROLA CHE HAI GIÀ. MESSO AL LAVORO.</p>
          <button class="proof-restart" type="button" data-restart>Rifai la dimostrazione</button>
        </footer>
      </section>
    </main>

    <footer class="proof-legal">
      <p>Dati Google mostrati come evidenza pubblica. Gli altri risultati sono contesto della stessa ricerca, non una classifica.</p>
      <p>Questa preview non salva i dati inseriti.</p>
    </footer>
  </div>

  <noscript><div class="no-script">Per eseguire la dimostrazione serve JavaScript.</div></noscript>

  <script>
    import {
      buildPassaparolaDiagnosis,
      buildPassaparolaMath,
      demoBusinesses,
      diagnosticQuestions,
    } from '../../data/beauty-check-v2.mjs';

    type Source = 'google_maps' | 'demo';
    type Step = 'search' | 'compare' | 'numbers' | 'questions' | 'diagnosis' | 'system';

    type SearchCandidate = {
      id: string;
      name: string;
      address: string;
      category: string;
      source: Source;
    };

    type Business = {
      id: string;
      placeId?: string;
      name: string;
      address: string;
      category: string;
      rating: number | null;
      reviews: number | null;
      cohortMedianReviews: number | null;
      source: Source;
      sourceLabel: string;
    };

    type ContextPlace = {
      id: string;
      name: string;
      address: string;
      category: string;
      rating: number | null;
      reviews: number | null;
      source: 'google_maps';
    };

    const app = document.querySelector<HTMLElement>('[data-proof-app]');
    const stepEls = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
    const back = document.querySelector<HTMLButtonElement>('[data-back]');
    const progressLabel = document.querySelector<HTMLElement>('[data-progress-label]');
    const progressCount = document.querySelector<HTMLElement>('[data-progress-count]');

    let currentStep: Step = 'search';
    let query = '';
    let business: Business | null = null;
    let context: ContextPlace[] = [];
    let math: ReturnType<typeof buildPassaparolaMath> | null = null;
    const answers: Record<string, string> = {};

    const stepMeta: Record<Step, [string, string]> = {
      search: ['Trova', '01 / 05'],
      compare: ['Confronta', '02 / 05'],
      numbers: ['Conta', '03 / 05'],
      questions: ['Capisci', '04 / 05'],
      diagnosis: ['Diagnosi', '05 / 05'],
      system: ['Trovatemi', 'TROVATEMI'],
    };

    const setText = (selector: string, value: string) => {
      const el = document.querySelector<HTMLElement>(selector);
      if (el) el.textContent = value;
    };

    const setStep = (step: Step) => {
      currentStep = step;
      stepEls.forEach((el) => {
        el.hidden = el.dataset.step !== step;
      });
      const meta = stepMeta[step];
      if (progressLabel) progressLabel.textContent = meta[0];
      if (progressCount) progressCount.textContent = meta[1];
      if (back) back.hidden = step === 'search' || step === 'system';
      if (app) app.dataset.currentStep = step;
      window.scrollTo({ top: 0, behavior: 'instant' });
    };

    const demoCandidates = (value: string): SearchCandidate[] => {
      const needle = value.trim().toLocaleLowerCase('it');
      return demoBusinesses
        .filter((item) => !needle || (item.name + ' ' + item.city + ' ' + item.category).toLocaleLowerCase('it').includes(needle))
        .slice(0, 5)
        .map((item) => ({
          id: item.id,
          name: item.name,
          address: item.address,
          category: item.category,
          source: 'demo' as const,
        }));
    };

    const demoAsBusiness = (id: string): Business | null => {
      const item = demoBusinesses.find((candidate) => candidate.id === id);
      if (!item) return null;
      return {
        id: item.id,
        name: item.name,
        address: item.address,
        category: item.category,
        rating: item.rating,
        reviews: item.reviews,
        cohortMedianReviews: item.cohortMedianReviews,
        source: 'demo',
        sourceLabel: 'Dati demo',
      };
    };

    const renderSearchResults = (items: SearchCandidate[]) => {
      const root = document.querySelector<HTMLElement>('[data-search-results]');
      if (!root) return;
      root.replaceChildren();

      if (!items.length) {
        const p = document.createElement('p');
        p.className = 'empty-state';
        p.textContent = 'Nessun risultato. Prova con nome attività + città.';
        root.append(p);
        return;
      }

      items.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'result-row';

        const copy = document.createElement('span');
        copy.className = 'result-copy';

        const name = document.createElement('strong');
        name.textContent = item.name;
        const detail = document.createElement('small');
        detail.textContent = item.category + ' · ' + item.address;
        copy.append(name, detail);

        const source = document.createElement('span');
        source.className = 'result-source';
        source.textContent = item.source === 'google_maps' ? 'Google Maps' : 'Demo';

        button.append(copy, source);
        button.addEventListener('click', () => void selectBusiness(item));
        root.append(button);
      });
    };

    const searchBusinesses = async () => {
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const message = document.querySelector<HTMLElement>('[data-search-message]');
      query = input?.value.trim() ?? '';

      if (query.length < 3) return;

      if (message) message.textContent = 'Ricerca in corso…';

      try {
        const response = await fetch('/api/places/search?q=' + encodeURIComponent(query), {
          headers: { accept: 'application/json' },
        });

        if (response.status === 503) {
          renderSearchResults(demoCandidates(query));
          if (message) message.textContent = 'Ambiente demo: Google Places non è configurato.';
          return;
        }

        if (!response.ok) throw new Error('search_failed');
        const payload = await response.json() as { places?: SearchCandidate[] };
        renderSearchResults(Array.isArray(payload.places) ? payload.places : []);
        if (message) message.textContent = 'Seleziona la tua attività.';
      } catch {
        if (message) message.textContent = 'La ricerca non è disponibile in questo momento. Riprova.';
      }
    };

    const loadContext = async () => {
      context = [];
      if (!business || business.source !== 'google_maps' || query.length < 3) return;

      try {
        const response = await fetch('/api/places/context?q=' + encodeURIComponent(query), {
          headers: { accept: 'application/json' },
        });
        if (!response.ok) return;
        const payload = await response.json() as { places?: ContextPlace[] };
        context = Array.isArray(payload.places) ? payload.places : [];
      } catch {
        context = [];
      }
    };

    const selectBusiness = async (candidate: SearchCandidate) => {
      if (candidate.source === 'demo') {
        business = demoAsBusiness(candidate.id);
        context = [];
        renderComparison();
        setStep('compare');
        return;
      }

      try {
        const response = await fetch('/api/places/details?id=' + encodeURIComponent(candidate.id), {
          headers: { accept: 'application/json' },
        });
        if (!response.ok) throw new Error('details_failed');
        const payload = await response.json() as { business?: Business };
        if (!payload.business) throw new Error('missing_business');
        business = payload.business;
        await loadContext();
        renderComparison();
        setStep('compare');
      } catch {
        const message = document.querySelector<HTMLElement>('[data-search-message]');
        if (message) message.textContent = 'Ho trovato l’attività, ma non riesco a leggere i dettagli. Riprova.';
      }
    };

    const chooseOther = () => {
      if (!business) return null;
      const others = context.filter((item) => item.id !== business?.placeId && item.name !== business?.name);
      if (!others.length) return null;
      const stronger = others
        .filter((item) => Number.isInteger(item.reviews) && Number.isInteger(business?.reviews) && Number(item.reviews) > Number(business?.reviews))
        .sort((a, b) => Number(b.reviews ?? 0) - Number(a.reviews ?? 0));
      return stronger[0] ?? others[0];
    };

    const metric = (value: number | null, decimals = 0) => {
      if (value === null || Number.isNaN(value)) return '—';
      return decimals ? value.toFixed(decimals) : String(value);
    };

    const renderComparison = () => {
      if (!business) return;
      setText('[data-you-name]', business.name);
      setText('[data-you-category]', business.category);
      setText('[data-you-address]', business.address);
      setText('[data-you-rating]', metric(business.rating, 1));
      setText('[data-you-reviews]', metric(business.reviews));

      const other = chooseOther();
      const card = document.querySelector<HTMLElement>('[data-other-card]');
      const note = document.querySelector<HTMLElement>('[data-comparison-note]');

      if (!other) {
        if (card) card.hidden = true;
        if (note) note.textContent = 'Google non ci ha restituito un secondo risultato abbastanza chiaro da mostrare. Non inventiamo il confronto.';
        return;
      }

      if (card) card.hidden = false;
      setText('[data-other-name]', other.name);
      setText('[data-other-category]', other.category);
      setText('[data-other-address]', other.address);
      setText('[data-other-rating]', metric(other.rating, 1));
      setText('[data-other-reviews]', metric(other.reviews));
      if (note) note.textContent = 'Questo è uno degli altri risultati emersi dalla stessa ricerca. Non è una classifica e non dice chi lavora meglio.';
    };

    const renderMath = () => {
      if (!math) return;
      setText('[data-monthly-clients]', String(math.estimatedMonthlyClients));
      setText('[data-recent-reviews]', String(math.recentReviews));
      setText('[data-math-disclaimer]', math.disclaimer);
      const board = document.querySelector<HTMLElement>('[data-loss-board]');
      if (board) board.hidden = false;
    };

    const renderDiagnosis = () => {
      if (!business || !math) return;
      const diagnosis = buildPassaparolaDiagnosis(business, answers);
      setText('[data-diagnosis-label]', diagnosis.shortLabel);
      setText('[data-diagnosis-headline]', diagnosis.headline);
      setText('[data-diagnosis-why]', diagnosis.why);
      setText('[data-diagnosis-reviews]', metric(diagnosis.evidence.reviews));
      setText('[data-diagnosis-rating]', diagnosis.evidence.rating === null ? 'Valutazione non disponibile' : metric(diagnosis.evidence.rating, 1) + ' ★ su Google');
      setText('[data-diagnosis-monthly]', String(math.estimatedMonthlyClients));

      const list = document.querySelector<HTMLOListElement>('[data-actions]');
      if (list) {
        list.replaceChildren();
        diagnosis.actions.forEach((action, index) => {
          const li = document.createElement('li');
          const n = document.createElement('span');
          n.textContent = '0' + String(index + 1);
          const p = document.createElement('p');
          p.textContent = action;
          li.append(n, p);
          list.append(li);
        });
      }
    };

    const updateDiagnoseButton = () => {
      const button = document.querySelector<HTMLButtonElement>('[data-diagnose]');
      if (!button) return;
      button.disabled = !diagnosticQuestions.every((question) => Boolean(answers[question.id]));
    };

    document.querySelector<HTMLFormElement>('[data-search-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      void searchBusinesses();
    });

    document.querySelector<HTMLFormElement>('[data-numbers-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const data = new FormData(form);
      math = buildPassaparolaMath({
        weeklyClients: data.get('weeklyClients'),
        recentReviews: data.get('recentReviews'),
      });
      renderMath();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((button) => {
      button.addEventListener('click', () => {
        const step = button.dataset.next as Step;
        setStep(step);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-question][data-answer]').forEach((button) => {
      button.addEventListener('click', () => {
        const question = button.dataset.question ?? '';
        const value = button.dataset.answer ?? '';
        answers[question] = value;

        document.querySelectorAll<HTMLButtonElement>('[data-question="' + question + '"]').forEach((option) => {
          option.classList.toggle('is-selected', option === button);
        });
        updateDiagnoseButton();
      });
    });

    document.querySelector<HTMLButtonElement>('[data-diagnose]')?.addEventListener('click', () => {
      renderDiagnosis();
      setStep('diagnosis');
    });

    document.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
      window.location.reload();
    });

    back?.addEventListener('click', () => {
      const previous: Partial<Record<Step, Step>> = {
        compare: 'search',
        numbers: 'compare',
        questions: 'numbers',
        diagnosis: 'questions',
      };
      const target = previous[currentStep];
      if (target) setStep(target);
    });

    setStep('search');
  </script>
</BeautyLeanLayout>
