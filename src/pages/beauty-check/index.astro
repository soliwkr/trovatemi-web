---
import BeautyLeanLayout from '../../layouts/BeautyLeanLayout.astro';
import '../../styles/beauty-check-v2.css';
---

<BeautyLeanLayout
  title="Trovatemi | Guarda cosa vede chi ti cerca"
  description="Cerca la tua attività, guarda i dati pubblici visibili e scopri dove il passaparola smette di diventare prova."
>
  <div class="funnel-app" data-funnel-app>
    <header class="funnel-topbar">
      <a class="wordmark" href="/" aria-label="Trovatemi home">
        <span>TROVATEMI.IT</span><b>★</b>
      </a>
      <div class="stage-meta" aria-hidden="true">
        <span data-stage-label>Analisi</span>
        <b data-stage-count>01 / 07</b>
      </div>
      <button class="quiet-button" type="button" data-back hidden>Indietro</button>
    </header>

    <div class="progress-rail" aria-hidden="true"><i data-progress></i></div>
    <main id="funnel-stage" class="funnel-stage" data-stage tabindex="-1" aria-live="polite"></main>

    <footer class="funnel-foot">
      <p>Dati pubblici quando disponibili · nessuna classifica inventata</p>
      <p>Preview diagnostica · nessun dato personale salvato</p>
    </footer>
  </div>

  <noscript><div class="no-script">Per eseguire l’analisi serve JavaScript.</div></noscript>

  <script>
    import {
      auditQuestions,
      buildPassaparolaDiagnosis,
      demoBusinesses,
    } from '../../data/beauty-check-v2.mjs';

    type Stage = 'intro' | 'search' | 'confirm' | 'quiz' | 'flash' | 'capture' | 'report';
    type Source = 'google_maps' | 'demo';
    type SearchStatus = 'idle' | 'loading' | 'ready' | 'error' | 'demo';
    type ContextStatus = 'idle' | 'loading' | 'ready' | 'error';

    type SearchCandidate = {
      id: string;
      name: string;
      address: string;
      category: string;
      source: Source;
    };

    type Business = {
      id: string;
      externalId?: string;
      placeId?: string;
      name: string;
      address: string;
      category: string;
      rating: number | null;
      reviews: number | null;
      cohortMedianReviews: number | null;
      source: Source;
      sourceLabel: string;
    };

    type ContextPlace = {
      id: string;
      name: string;
      address: string;
      category: string;
      rating: number | null;
      reviews: number | null;
      source: 'google_maps';
    };

    type SearchPayload = { places?: SearchCandidate[] };
    type DetailsPayload = { business?: Business };
    type ContextPayload = { places?: ContextPlace[] };

    const app = document.querySelector<HTMLElement>('[data-funnel-app]');
    const stageElement = document.querySelector<HTMLElement>('[data-stage]');
    const backButton = document.querySelector<HTMLButtonElement>('[data-back]');
    const progressElement = document.querySelector<HTMLElement>('[data-progress]');
    const stageLabel = document.querySelector<HTMLElement>('[data-stage-label]');
    const stageCount = document.querySelector<HTMLElement>('[data-stage-count]');

    const state: {
      stage: Stage;
      query: string;
      searchStatus: SearchStatus;
      searchMessage: string;
      searchResults: SearchCandidate[];
      business: Business | null;
      contextStatus: ContextStatus;
      contextResults: ContextPlace[];
      step: number;
      answers: Record<string, string>;
    } = {
      stage: 'intro',
      query: '',
      searchStatus: 'idle',
      searchMessage: '',
      searchResults: [],
      business: null,
      contextStatus: 'idle',
      contextResults: [],
      step: 0,
      answers: {},
    };

    const meta: Record<Stage, { label: string; count: string }> = {
      intro: { label: 'Analisi', count: '01 / 07' },
      search: { label: 'Attività', count: '02 / 07' },
      confirm: { label: 'Evidenza pubblica', count: '03 / 07' },
      quiz: { label: 'Processo', count: '04 / 07' },
      flash: { label: 'Diagnosi', count: '05 / 07' },
      capture: { label: 'Azioni', count: '06 / 07' },
      report: { label: 'Sintesi', count: '07 / 07' },
    };

    const h = (value: unknown) => String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const gmpAttribution = '<span class="gmp-attribution" translate="no">Google Maps</span>';

    const progress = () => {
      if (state.stage === 'intro') return 5;
      if (state.stage === 'search') return 15;
      if (state.stage === 'confirm') return 30;
      if (state.stage === 'quiz') return 35 + ((state.step + 1) / auditQuestions.length) * 35;
      if (state.stage === 'flash') return 78;
      if (state.stage === 'capture') return 90;
      return 100;
    };

    const setStage = (next: Stage) => {
      state.stage = next;
      render();
    };

    const demoAsBusiness = (business: (typeof demoBusinesses)[number]): Business => ({
      id: business.id,
      name: business.name,
      address: business.address,
      category: business.category,
      rating: business.rating,
      reviews: business.reviews,
      cohortMedianReviews: business.cohortMedianReviews,
      source: 'demo',
      sourceLabel: 'Dati demo',
    });

    const demoCandidates = (query: string): SearchCandidate[] => {
      const needle = query.trim().toLocaleLowerCase('it');
      return demoBusinesses
        .filter((business) => !needle || `${business.name} ${business.city} ${business.category}`.toLocaleLowerCase('it').includes(needle))
        .slice(0, 5)
        .map((business) => ({
          id: business.id,
          name: business.name,
          address: business.address,
          category: business.category,
          source: 'demo',
        }));
    };

    const renderIntro = () => `
      <section class="stage-layout stage-intro" data-state="intro">
        <div class="intro-copy">
          <p class="eyebrow">ANALISI TROVATEMI · BEAUTY &amp; WELLNESS</p>
          <h1>Guarda la tua attività come la vede chi deve scegliere.</h1>
          <p class="lede">
            Partiamo dai dati pubblici. Poi ti facciamo cinque domande sul modo in cui gestisci
            clienti soddisfatti e recensioni. Alla fine ti diciamo qual è il primo punto che oggi
            disperde più prova.
          </p>
          <button class="primary-action" type="button" data-next="search">Analizza la mia attività</button>
        </div>
        <aside class="intro-note">
          <span>COME LAVORIAMO</span>
          <p>Nessun punteggio inventato. Nessuna promessa di posizione. Solo dati visibili, risposte tue e una conclusione spiegabile.</p>
        </aside>
      </section>`;

    const businessRows = (items: SearchCandidate[]) => items.length
      ? items.map((business) => `
          <button class="business-row" type="button" data-business-id="${h(business.id)}" data-source="${business.source}">
            <span class="row-name">
              <b>${h(business.name)}</b>
              <small>${h(business.category)} · ${h(business.address)}</small>
            </span>
            <span class="row-source">${business.source === 'google_maps' ? 'Google Maps' : 'Demo'}</span>
          </button>`).join('')
      : '<p class="empty-state">Nessun risultato. Prova con nome attività + città.</p>';

    const renderSearchResults = () => {
      if (state.searchStatus === 'idle') return '<p class="lookup-status">Inserisci nome e città.</p>';
      if (state.searchStatus === 'loading') return '<p class="lookup-status">Ricerca in corso…</p>';
      if (state.searchStatus === 'error') return `<p class="lookup-status lookup-status--error">${h(state.searchMessage)}</p>`;

      return `
        ${businessRows(state.searchResults)}
        <div class="lookup-provenance">
          ${state.searchStatus === 'ready'
            ? `${gmpAttribution}<span>Dati pubblici correnti.</span>`
            : '<span>Ambiente demo: nessun dato Google utilizzato.</span>'}
        </div>`;
    };

    const renderSearch = () => `
      <section class="stage-layout stage-search" data-state="search">
        <div class="stage-copy">
          <p class="eyebrow">01 · ATTIVITÀ</p>
          <h1>Cerca la tua attività.</h1>
          <p class="stage-explainer">Scrivi il nome con la città e seleziona il risultato corretto.</p>
          <form class="lookup-form" data-search-form>
            <label class="search-field">
              <span class="sr-only">Nome attività e città</span>
              <input data-search-input type="search" autocomplete="organization" placeholder="Es. Nails Formia" minlength="3" maxlength="120" required />
            </label>
            <button class="primary-action lookup-submit" type="submit">Cerca</button>
          </form>
          ${state.searchStatus === 'demo'
            ? '<p class="demo-warning">La ricerca live non è disponibile in questo ambiente. I risultati seguenti sono esplicitamente demo.</p>'
            : ''}
        </div>
        <div class="business-list" data-business-list>${renderSearchResults()}</div>
      </section>`;

    const renderContext = (business: Business) => {
      if (business.source !== 'google_maps') return '';
      if (state.contextStatus === 'loading') return '<p class="context-status">Carico il contesto della stessa ricerca…</p>';
      if (state.contextStatus !== 'ready') return '';

      const rows = state.contextResults
        .filter((place) => place.id !== business.placeId && place.name !== business.name)
        .slice(0, 3);

      if (!rows.length) return '';

      return `
        <section class="same-query">
          <header>
            <span>ALTRI RISULTATI EMERSI DALLA STESSA RICERCA</span>
            <p>Contesto reale, non una classifica e non un benchmark.</p>
          </header>
          <div class="same-query-grid">
            ${rows.map((place) => `
              <article>
                <h3>${h(place.name)}</h3>
                <p>${h(place.category || place.address)}</p>
                <div>
                  <strong>${place.rating === null ? '—' : place.rating.toFixed(1)} ★</strong>
                  <span>${place.reviews === null ? '—' : h(place.reviews)} recensioni</span>
                </div>
              </article>`).join('')}
          </div>
        </section>`;
    };

    const renderConfirm = (business: Business) => {
      const rating = business.rating === null ? '—' : business.rating.toFixed(1);
      const reviews = business.reviews === null ? '—' : String(business.reviews);

      return `
        <section class="stage-layout stage-confirm" data-state="confirm">
          <div class="stage-copy confirm-copy">
            <p class="eyebrow">02 · EVIDENZA PUBBLICA</p>
            <h1>Questo è ciò che vede chi ti cerca.</h1>

            <article class="business-confirmation">
              <div class="business-identity">
                <span>${h(business.category)}</span>
                <h2>${h(business.name)}</h2>
                <p>${h(business.address)}</p>
              </div>
              <dl>
                <div><dt>Valutazione</dt><dd>${rating} ★</dd></div>
                <div><dt>Recensioni visibili</dt><dd>${reviews}</dd></div>
              </dl>
              <footer>${business.source === 'google_maps' ? gmpAttribution : '<span>Dati demo</span>'}</footer>
            </article>

            ${renderContext(business)}

            <p class="plain-clarifier">
              Questi numeri non misurano la qualità del tuo lavoro. Misurano solo la prova che una persona può vedere prima di contattarti.
            </p>

            <div class="action-pair">
              <button class="primary-action" type="button" data-next="quiz">Continua</button>
              <button class="text-action" type="button" data-next="search">Non è questa attività</button>
            </div>
          </div>
        </section>`;
    };

    const renderQuiz = () => {
      const question = auditQuestions[state.step];
      const selected = state.answers[question.id];

      return `
        <section class="stage-layout stage-quiz" data-state="quiz">
          <div class="quiz-copy">
            <p class="eyebrow">03 · PROCESSO · ${state.step + 1} DI 5</p>
            <h1>${question.title}</h1>
            <p class="private-note">Rispondi in base a quello che succede normalmente, non al caso migliore.</p>
          </div>
          <div class="answer-list">
            ${question.options.map(([value, label]) => `
              <button class="answer-row${selected === value ? ' is-selected' : ''}" type="button" data-answer="${value}">
                <b>${label}</b>
              </button>`).join('')}
          </div>
        </section>`;
    };

    const renderEvidenceCard = (business: Business, diagnosis: ReturnType<typeof buildPassaparolaDiagnosis>) => {
      const reviews = business.reviews === null ? '—' : String(business.reviews);
      const rating = business.rating === null ? '—' : business.rating.toFixed(1);

      return `
        <article class="evidence-card">
          <header>DATI PUBBLICI</header>
          <div class="evidence-numbers">
            <div><strong>${rating} ★</strong><small>valutazione</small></div>
            <div><strong>${reviews}</strong><small>recensioni</small></div>
          </div>
          <p>${h(diagnosis.evidence.note)}</p>
          ${business.source === 'google_maps' ? `<footer>${gmpAttribution}</footer>` : ''}
        </article>`;
    };

    const renderFlash = (business: Business) => {
      const diagnosis = buildPassaparolaDiagnosis(business, state.answers);

      return `
        <section class="stage-layout stage-flash" data-state="flash">
          <div class="flash-copy">
            <p class="eyebrow">04 · DIAGNOSI</p>
            <h1>${diagnosis.headline}</h1>
            <p class="diagnosis-why">${diagnosis.why}</p>
          </div>

          <div class="diagnosis-board">
            <span>PRIMO PUNTO DA CORREGGERE</span>
            <strong>${diagnosis.shortLabel}</strong>
            <p>${h(diagnosis.answerSummary)}.</p>
          </div>

          ${renderEvidenceCard(business, diagnosis)}

          <div class="flash-cta">
            <p>La diagnosi non è un voto. È una priorità operativa basata su ciò che si vede e su ciò che hai dichiarato.</p>
            <button class="primary-action primary-action--light" type="button" data-next="capture">Vedi cosa fare</button>
          </div>
        </section>`;
    };

    const renderCapture = (business: Business) => {
      const diagnosis = buildPassaparolaDiagnosis(business, state.answers);

      return `
        <section class="stage-layout stage-actions" data-state="capture">
          <div class="actions-copy">
            <p class="eyebrow">05 · AZIONI</p>
            <h1>Tre priorità. In quest’ordine.</h1>
            <p>Non servono altre idee. Serve correggere prima il punto che disperde più prova.</p>
          </div>

          <ol class="action-list">
            ${diagnosis.actions.map((action: string, index: number) => `
              <li>
                <span>0${index + 1}</span>
                <p>${h(action)}</p>
              </li>`).join('')}
          </ol>

          <div class="actions-next">
            <p>Ora puoi vedere la sintesi completa dell’analisi di ${h(business.name)}.</p>
            <button class="primary-action" type="button" data-next="report">Apri la sintesi</button>
          </div>
        </section>`;
    };

    const renderReport = (business: Business) => {
      const diagnosis = buildPassaparolaDiagnosis(business, state.answers);

      return `
        <section class="stage-report" data-state="report">
          <header class="report-hero">
            <p class="eyebrow">ANALISI TROVATEMI · ${h(business.name)}</p>
            <h1>${diagnosis.headline}</h1>
            <p>${diagnosis.why}</p>
          </header>

          <section class="report-grid">
            ${renderEvidenceCard(business, diagnosis)}

            <article class="report-private">
              <header>QUELLO CHE CI HAI DETTO</header>
              <p>${h(diagnosis.answerSummary)}.</p>
              <small>Volume indicato: ${h(diagnosis.weeklyVolumeLabel)}.</small>
            </article>
          </section>

          <section class="report-actions">
            <header>
              <p class="eyebrow">PRIORITÀ OPERATIVE</p>
              <h2>Prima questo. Poi il resto.</h2>
            </header>
            <ol>
              ${diagnosis.actions.map((action: string, index: number) => `
                <li><span>0${index + 1}</span><p>${h(action)}</p></li>`).join('')}
            </ol>
          </section>

          <section class="report-system">
            <div>
              <p class="eyebrow">DOVE ENTRA TROVATEMI</p>
              <h2>Il problema non è sapere cosa fare. È farlo con continuità.</h2>
            </div>
            <div>
              <p>
                Trovatemi mette a sistema richiesta recensioni, routine di risposta e riuso della prova
                dove il canale è operativo. Senza review gating e senza promettere posizioni su Google.
              </p>
              <a class="primary-action primary-action--light" href="/#offerta">Vedi l’offerta</a>
            </div>
          </section>

          <footer class="report-close">
            <p>Ti facciamo trovare dove conta.</p>
            <button class="text-action" type="button" data-restart>Rifai l’analisi</button>
          </footer>
        </section>`;
    };

    const render = () => {
      if (!stageElement || !app) return;
      const business = state.business;
      let markup = renderIntro();

      if (state.stage === 'search') markup = renderSearch();
      if (state.stage === 'confirm' && business) markup = renderConfirm(business);
      if (state.stage === 'quiz') markup = renderQuiz();
      if (state.stage === 'flash' && business) markup = renderFlash(business);
      if (state.stage === 'capture' && business) markup = renderCapture(business);
      if (state.stage === 'report' && business) markup = renderReport(business);

      stageElement.setAttribute('aria-live', state.stage === 'report' ? 'off' : 'polite');
      stageElement.innerHTML = markup;
      app.dataset.currentStage = state.stage;
      stageLabel!.textContent = meta[state.stage].label;
      stageCount!.textContent = meta[state.stage].count;
      progressElement!.style.width = `${progress()}%`;
      if (backButton) backButton.hidden = state.stage === 'intro' || state.stage === 'report';
      bindStage();
      window.scrollTo({ top: 0, behavior: 'instant' });
      requestAnimationFrame(() => stageElement.focus({ preventScroll: true }));
    };

    const loadContext = async () => {
      if (!state.business || state.business.source !== 'google_maps' || state.query.trim().length < 3) {
        state.contextStatus = 'idle';
        state.contextResults = [];
        return;
      }

      state.contextStatus = 'loading';
      render();

      try {
        const response = await fetch(`/api/places/context?q=${encodeURIComponent(state.query.trim())}`, {
          headers: { accept: 'application/json' },
        });

        if (!response.ok) throw new Error('context_failed');
        const payload = await response.json() as ContextPayload;
        state.contextResults = Array.isArray(payload.places) ? payload.places : [];
        state.contextStatus = 'ready';
      } catch {
        state.contextResults = [];
        state.contextStatus = 'error';
      }

      render();
    };

    const searchBusinesses = async () => {
      const query = state.query.trim();

      if (query.length < 3) {
        state.searchStatus = 'error';
        state.searchMessage = 'Inserisci almeno 3 caratteri.';
        return render();
      }

      state.searchStatus = 'loading';
      state.searchMessage = '';
      state.searchResults = [];
      render();

      try {
        const response = await fetch(`/api/places/search?q=${encodeURIComponent(query)}`, {
          headers: { accept: 'application/json' },
        });

        if (response.status === 503) {
          state.searchResults = demoCandidates(query);
          state.searchStatus = 'demo';
          return render();
        }

        if (!response.ok) throw new Error('search_failed');
        const payload = await response.json() as SearchPayload;
        state.searchResults = Array.isArray(payload.places) ? payload.places : [];
        state.searchStatus = 'ready';
        render();
      } catch {
        state.searchStatus = 'error';
        state.searchMessage = 'La ricerca non è disponibile in questo momento. Riprova.';
        render();
      }
    };

    const selectBusiness = async (id: string, source: Source) => {
      state.contextStatus = 'idle';
      state.contextResults = [];

      if (source === 'demo') {
        const demo = demoBusinesses.find((business) => business.id === id);
        if (demo) {
          state.business = demoAsBusiness(demo);
          setStage('confirm');
        }
        return;
      }

      state.searchStatus = 'loading';
      state.searchMessage = 'Carico i dati pubblici…';
      render();

      try {
        const response = await fetch(`/api/places/details?id=${encodeURIComponent(id)}`, {
          headers: { accept: 'application/json' },
        });

        if (!response.ok) throw new Error('details_failed');
        const payload = await response.json() as DetailsPayload;
        if (!payload.business) throw new Error('invalid_details');

        state.business = payload.business;
        state.stage = 'confirm';
        render();
        void loadContext();
      } catch {
        state.searchStatus = 'error';
        state.searchMessage = 'Ho trovato l’attività, ma non riesco a leggere i dettagli. Riprova.';
        state.stage = 'search';
        render();
      }
    };

    const bindStage = () => {
      if (!stageElement) return;

      stageElement.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((button) => {
        button.addEventListener('click', () => setStage(button.dataset.next as Stage));
      });

      const searchForm = stageElement.querySelector<HTMLFormElement>('[data-search-form]');
      const searchInput = stageElement.querySelector<HTMLInputElement>('[data-search-input]');
      if (searchInput) searchInput.value = state.query;

      searchInput?.addEventListener('input', () => {
        state.query = searchInput.value;
      });

      searchForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!searchForm.reportValidity()) return;
        state.query = searchInput?.value ?? state.query;
        void searchBusinesses();
      });

      stageElement.querySelectorAll<HTMLButtonElement>('[data-business-id]').forEach((button) => {
        button.addEventListener('click', () => {
          void selectBusiness(button.dataset.businessId ?? '', (button.dataset.source ?? 'demo') as Source);
        });
      });

      stageElement.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((button) => {
        button.addEventListener('click', () => {
          const question = auditQuestions[state.step];
          state.answers[question.id] = button.dataset.answer ?? '';

          if (state.step < auditQuestions.length - 1) {
            state.step += 1;
            render();
          } else {
            setStage('flash');
          }
        });
      });

      stageElement.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
        state.stage = 'intro';
        state.query = '';
        state.searchStatus = 'idle';
        state.searchMessage = '';
        state.searchResults = [];
        state.business = null;
        state.contextStatus = 'idle';
        state.contextResults = [];
        state.step = 0;
        state.answers = {};
        render();
      });
    };

    backButton?.addEventListener('click', () => {
      if (state.stage === 'search') return setStage('intro');
      if (state.stage === 'confirm') return setStage('search');

      if (state.stage === 'quiz') {
        if (state.step > 0) {
          state.step -= 1;
          return render();
        }
        return setStage('confirm');
      }

      if (state.stage === 'flash') {
        state.step = auditQuestions.length - 1;
        return setStage('quiz');
      }

      if (state.stage === 'capture') return setStage('flash');
    });

    render();
  </script>
</BeautyLeanLayout>
