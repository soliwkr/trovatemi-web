---
import BioLinkExperience from '../../components/v13-rebuild/BioLinkExperience';
import { demoTenants, type DemoTenant } from '../../data/demo-tenants';
import { getVerticalMessaging, type VerticalMessaging } from '../../data/vertical-messaging';
import V13AceternityLayout from '../../layouts/V13AceternityLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return demoTenants.flatMap((demo) => {
    const message = getVerticalMessaging(demo.id);
    return message ? [{ params: { slug: demo.id }, props: { demo, message } }] : [];
  });
}

type Props = { demo: DemoTenant; message: VerticalMessaging };
const { demo, message } = Astro.props;
---

<V13AceternityLayout
  title={`${message.bioHeadline} | Trovatemi`}
  description={message.bioBody}
  bodyClass="v13a-bio-page-body"
>
  <BioLinkExperience demo={demo} message={message} client:load />
</V13AceternityLayout>
