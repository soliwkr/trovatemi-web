---
import V12Layout from '../../layouts/V12Layout.astro';
import V12Experience from '../../components/v12/V12Experience';

export const prerender = true;

const faqs = [
  ['È un software che devo imparare a usare?', 'No. Trovatemi configura il sistema sulla tua attività, prepara gli strumenti e ti accompagna nell’utilizzo.'],
  ['Cosa succede nei 14 giorni?', 'Partiamo dalla situazione reale, attiviamo la prima richiesta, controlliamo l’utilizzo al giorno 7 e leggiamo gli output al giorno 14.'],
  ['Filtrate le recensioni negative?', 'No. Ogni cliente riceve lo stesso percorso e non utilizziamo review gating.'],
  ['Che differenza c’è tra TROVATO e INEVITABILE?', 'TROVATO raccoglie e gestisce richieste, recensioni e risposte. INEVITABILE trasforma e distribuisce la stessa prova anche su Google, social e contenuti locali.'],
  ['Mi garantite il primo posto su Google o una citazione nelle risposte AI?', 'No. Trovatemi rende le informazioni più chiare e continuative, ma non può garantire posizioni, citazioni o risposte specifiche.'],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<V12Layout
  title="Trovatemi V12 | Recensioni e presenza locale per attività che lavorano bene"
  description="Trovatemi installa e segue il sistema che trasforma clienti soddisfatti in recensioni, risposte e prove pubbliche per Google, social e contenuti locali."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <V12Experience client:load />
</V12Layout>
