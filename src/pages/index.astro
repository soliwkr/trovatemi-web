---
import '@fontsource-variable/archivo';
import '@fontsource-variable/space-grotesk';
export const prerender = true;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Trovatemi Radar osserva la tua presenza locale, la confronta con il mercato e trova le opportunità che vale davvero la pena sistemare."
    />
    <meta name="theme-color" content="#101216" />
    <meta property="og:title" content="Trovatemi Radar — Dove stai perdendo clienti locali?" />
    <meta property="og:description" content="Segnali locali, confronto e 3 opportunità concrete da sistemare." />
    <link rel="canonical" href="https://trovatemi.it/" />
    <title>Trovatemi Radar — Opportunità locali</title>
  </head>

  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Trovatemi.it home">
          <span class="brand-mark">T</span>
          <span class="brand-word">TROVATEMI.IT</span>
          <b>★</b>
        </a>

        <nav class="top-nav" aria-label="Navigazione principale">
          <a href="#come-funziona">Come funziona</a>
          <a href="#cosa-controlla">Cosa controlla</a>
          <a href="#radar">Radar</a>
        </nav>

        <a class="header-cta" href="#analizza">Analizza la tua attività <span>↗</span></a>
      </header>

      <main>
        <section class="hero">
          <div class="hero-grid">
            <div class="hero-copy">
              <div class="eyebrow">
                <span class="live-dot"></span>
                TROVATEMI RADAR · LOCAL INTELLIGENCE
              </div>

              <h1>DOVE STAI PERDENDO<br /><em>CLIENTI LOCALI?</em></h1>

              <p class="hero-lede">
                Trovatemi guarda la tua attività come farebbe un cliente, la confronta con ciò che trova intorno
                e trasforma i segnali pubblici in <strong>poche priorità concrete.</strong>
              </p>

              <div class="hero-actions">
                <a class="button button-primary" href="#analizza">Scopri le tue opportunità <span>→</span></a>
                <a class="button button-ghost" href="#come-funziona">Guarda come funziona</a>
              </div>

              <div class="hero-trust">
                <div><strong>30 sec</strong><span>per iniziare</span></div>
                <div><strong>0 account</strong><span>per il primo check</span></div>
                <div><strong>3 priorità</strong><span>non 40 grafici</span></div>
              </div>
            </div>

            <div class="hero-product" aria-label="Anteprima Trovatemi Radar">
              <div class="product-window">
                <div class="window-bar">
                  <div class="window-dots"><i></i><i></i><i></i></div>
                  <span>trovatemi radar</span>
                  <b>LIVE</b>
                </div>

                <div class="product-body">
                  <div class="product-business">
                    <div>
                      <small>ATTIVITÀ OSSERVATA</small>
                      <strong>Studio Demo · Formia</strong>
                    </div>
                    <span class="score-pill">3 opportunità</span>
                  </div>

                  <div class="signal-grid">
                    <article>
                      <small>RATING</small>
                      <strong>4,7 <i>★</i></strong>
                      <span>buona reputazione</span>
                    </article>
                    <article>
                      <small>RECENSIONI</small>
                      <strong>43</strong>
                      <span>vs ~128 mediana</span>
                    </article>
                    <article>
                      <small>CONTATTO</small>
                      <strong>2 / 3</strong>
                      <span>un attrito rilevato</span>
                    </article>
                  </div>

                  <div class="opportunity-preview">
                    <div class="preview-head">
                      <span>PRIORITÀ #1</span>
                      <b>ALTA</b>
                    </div>
                    <h3>Le recensioni stanno pesando meno dei concorrenti.</h3>
                    <p>La qualità percepita è buona, ma la prova pubblica è nettamente più debole rispetto al contesto osservato.</p>
                    <div class="preview-action">
                      <span>AZIONE</span>
                      <strong>Avvia raccolta recensioni</strong>
                      <b>→</b>
                    </div>
                  </div>

                  <div class="product-foot">
                    <span>Segnali osservati → decisione → azione</span>
                    <span>Decision layer</span>
                  </div>
                </div>
              </div>

              <div class="floating-note note-one">
                <span>01</span>
                <div><b>OSSERVA</b><small>dati pubblici</small></div>
              </div>
              <div class="floating-note note-two">
                <span>02</span>
                <div><b>DECIDE</b><small>solo ciò che conta</small></div>
              </div>
            </div>
          </div>

          <div class="hero-marquee" aria-hidden="true">
            <span>RECENSIONI</span><i>✦</i>
            <span>GOOGLE PROFILE</span><i>✦</i>
            <span>CONCORRENTI</span><i>✦</i>
            <span>PERCORSO DI CONTATTO</span><i>✦</i>
            <span>OPPORTUNITÀ</span><i>✦</i>
          </div>
        </section>

        <section id="come-funziona" class="principles">
          <div class="section-shell">
            <div class="section-kicker">UN RADAR, NON UN ALTRO AUDIT</div>
            <div class="principles-grid">
              <div class="principles-copy">
                <h2>Prima guardiamo.<br />Poi decidiamo.<br /><em>Infine agiamo.</em></h2>
                <p>
                  Trovatemi non parte da una lista di servizi da venderti. Parte da quello che un cliente vede oggi
                  e prova a capire quale singola cosa merita attenzione per prima.
                </p>
              </div>

              <div class="principles-steps">
                <article>
                  <span>01</span>
                  <div><small>OBSERVE</small><strong>Legge segnali reali.</strong><p>Presenza, recensioni, contatti e confronto locale.</p></div>
                </article>
                <article>
                  <span>02</span>
                  <div><small>JUDGE</small><strong>Riduce il rumore.</strong><p>Trasforma i segnali in poche opportunità difendibili.</p></div>
                </article>
                <article>
                  <span>03</span>
                  <div><small>ACT</small><strong>Mette in moto un’azione.</strong><p>Recensioni, contatto, presenza: una priorità alla volta.</p></div>
                </article>
              </div>
            </div>
          </div>
        </section>

        <section id="analizza" class="analyze-section">
          <div class="section-shell">
            <div class="analyze-head">
              <div>
                <span class="section-kicker">IL TUO PRIMO RADAR</span>
                <h2>Parti da una ricerca reale.</h2>
              </div>
              <p>Dimmi cosa fai e dove lavori. Ti mostro alcune attività osservate e scegli la tua.</p>
            </div>

            <div class="search-stage">
              <aside class="search-panel" aria-label="Cerca la tua attività">
                <div class="panel-top">
                  <div class="panel-progress">
                    <span class="step-badge active">1</span>
                    <span class="step-line"></span>
                    <span class="step-badge">2</span>
                    <span class="step-line"></span>
                    <span class="step-badge">3</span>
                  </div>
                  <span class="panel-status">LIVE SEARCH</span>
                </div>

                <div class="panel-copy">
                  <small>PASSO 1 DI 3</small>
                  <h3>Cerca la tua attività.</h3>
                  <p>Due dati. Nessun account. Nessun questionario infinito.</p>
                </div>

                <form id="search-form" class="search-form">
                  <label>
                    <span>COSA FAI?</span>
                    <div class="input-shell">
                      <i>⌕</i>
                      <input id="category" name="category" autocomplete="organization-title" placeholder="es. barbiere" required />
                    </div>
                  </label>

                  <label>
                    <span>DOVE?</span>
                    <div class="input-shell">
                      <i>⌖</i>
                      <input id="city" name="city" autocomplete="address-level2" placeholder="es. Formia" required />
                    </div>
                  </label>

                  <button id="search-button" class="primary-button" type="submit">
                    <span>Cerca la mia attività</span>
                    <b>→</b>
                  </button>
                </form>

                <div class="examples">
                  <span>PROVA AL VOLO</span>
                  <button type="button" data-example-category="barbiere" data-example-city="Formia">barbiere · Formia</button>
                  <button type="button" data-example-category="dentista" data-example-city="Gaeta">dentista · Gaeta</button>
                  <button type="button" data-example-category="serramenti" data-example-city="Formia">serramenti · Formia</button>
                </div>
              </aside>

              <div class="search-explainer">
                <div class="explainer-number">01</div>
                <p>Non devi sapere nulla di SEO, Google Business Profile o automazioni.</p>
                <strong>Devi solo riconoscere la tua attività quando la troviamo.</strong>
              </div>
            </div>
          </div>
        </section>

        <section id="loading" class="loading-state" hidden>
          <div class="loading-inner">
            <div class="pulse-ring"><span></span></div>
            <div>
              <small>RICERCA IN CORSO</small>
              <strong>Ti sto cercando come farebbe un cliente.</strong>
              <p>Sto confrontando presenza, recensioni e percorso di contatto.</p>
            </div>
          </div>
        </section>

        <section id="results-section" class="results-section" hidden>
          <div class="section-shell">
            <div class="section-intro">
              <div class="section-step">
                <span>2</span>
                <div>
                  <small>PASSO 2 DI 3</small>
                  <b>Riconosciti.</b>
                </div>
              </div>
              <h2 id="query-title"></h2>
              <p>Queste sono alcune attività incontrate nella ricerca osservata. Qual è la tua?</p>
            </div>

            <div class="results-frame">
              <div class="results-toolbar">
                <span>RISULTATI OSSERVATI</span>
                <span>rating · recensioni · presenza</span>
              </div>
              <div id="results-list" class="results-list"></div>
            </div>

            <p class="claim-rule">
              L'ordine mostrato è quello restituito nella specifica ricerca osservata e non rappresenta un ranking Google assoluto.
            </p>
          </div>
        </section>

        <section id="selected-section" class="selected-section" hidden>
          <div class="section-shell">
            <div class="selected-top">
              <div class="section-intro compact">
                <div class="section-step inverse">
                  <span>3</span>
                  <div>
                    <small>PASSO 3 DI 3</small>
                    <b>Trova le opportunità.</b>
                  </div>
                </div>
                <h2 id="selected-name"></h2>
                <p id="selected-address" class="address"></p>
              </div>
              <span class="selected-badge">RADAR ATTIVO</span>
            </div>

            <div class="diagnostic-grid">
              <article class="diagnostic-card main-metric">
                <div class="card-label">PROVA SOCIALE</div>
                <div class="metric-head">
                  <div>
                    <small>Rating osservato</small>
                    <strong id="selected-rating">—</strong>
                  </div>
                  <div>
                    <small>Recensioni</small>
                    <strong id="selected-reviews">—</strong>
                  </div>
                </div>

                <div class="benchmark">
                  <div class="benchmark-head">
                    <span>Tu</span>
                    <span id="benchmark-you">—</span>
                  </div>
                  <div class="bar"><i id="selected-review-bar"></i></div>

                  <div class="benchmark-head">
                    <span>Mediana osservata</span>
                    <span id="median-reviews">—</span>
                  </div>
                  <div class="bar muted"><i id="median-review-bar"></i></div>
                </div>

                <p class="card-foot">Non dice chi lavora meglio. Dice quanto pesa la prova pubblica prima della chiamata.</p>
              </article>

              <article class="diagnostic-card contact-card">
                <div class="card-label">PERCORSO DI CONTATTO</div>
                <h3>Quanto è facile passare da “mi interessa” a “ti contatto”?</h3>

                <div class="signal-list">
                  <div class="signal-row"><span><i>☎</i> Telefono</span><b id="signal-phone">—</b></div>
                  <div class="signal-row"><span><i>↗</i> Sito</span><b id="signal-site">—</b></div>
                  <div class="signal-row"><span><i>✦</i> Contatto diretto</span><b id="signal-direct">—</b></div>
                </div>

                <p class="card-foot">Ogni passaggio inutile è lavoro che chiedi al cliente.</p>
              </article>
            </div>

            <div id="radar" class="opportunity-radar" aria-live="polite">
              <div class="radar-heading">
                <div>
                  <small>TROVATEMI RADAR</small>
                  <h3>Le opportunità che meritano attenzione.</h3>
                  <p>Non una checklist. Non un punteggio. Solo ciò che vale davvero la pena fare adesso.</p>
                </div>
                <span id="decision-mode" class="decision-mode">Analisi in corso…</span>
              </div>
              <div id="opportunity-list" class="opportunity-list">
                <article class="opportunity-card loading-card"><span></span><b>Sto leggendo i segnali…</b></article>
              </div>
            </div>
          </div>
        </section>

        <section id="verdict-section" class="verdict-section" hidden>
          <div class="verdict-shell">
            <div class="verdict-copy">
              <div class="verdict-kicker">QUELLO CHE VEDO</div>
              <h2 id="verdict-title">SEI MEGLIO<br /><em>DI COME APPARI.</em></h2>
              <p id="verdict-copy"></p>
            </div>

            <div class="cta-card">
              <small>IL PASSO SUCCESSIVO</small>
              <h3>Vuoi sistemare la priorità?</h3>
              <p>Ti preparo il Check privato con prove, confronto e il primo intervento da mettere in moto.</p>
              <button id="check-button" class="cta-button" type="button">
                <span>Sistemami la priorità</span>
                <b>→</b>
              </button>
              <div class="cta-proof">Gratis · link privato · niente account</div>
            </div>
          </div>
        </section>

        <section id="cosa-controlla" class="coverage-section">
          <div class="section-shell">
            <div class="coverage-head">
              <span class="section-kicker">COSA OSSERVA TROVATEMI</span>
              <h2>Il cliente vede un insieme.<br />Il Radar lo scompone.</h2>
            </div>

            <div class="coverage-grid">
              <article>
                <span>01</span>
                <div class="coverage-icon">★</div>
                <h3>Reputazione</h3>
                <p>Rating, volume recensioni e differenza rispetto al contesto locale osservato.</p>
              </article>
              <article>
                <span>02</span>
                <div class="coverage-icon">⌖</div>
                <h3>Presenza locale</h3>
                <p>Come e dove l’attività compare nella specifica ricerca osservata.</p>
              </article>
              <article>
                <span>03</span>
                <div class="coverage-icon">↗</div>
                <h3>Contatto</h3>
                <p>Sito, telefono e percorsi diretti che riducono o aumentano la frizione.</p>
              </article>
              <article>
                <span>04</span>
                <div class="coverage-icon">◎</div>
                <h3>Concorrenza</h3>
                <p>Il benchmark locale che rende un numero utile invece che isolato.</p>
              </article>
            </div>
          </div>
        </section>

        <section class="manifesto">
          <div class="section-shell manifesto-grid">
            <div>
              <span class="section-kicker">LA FILOSOFIA</span>
              <h2>Il problema non è avere più dati.<br /><em>È sapere cosa fare.</em></h2>
            </div>
            <div class="manifesto-copy">
              <p>
                Trovatemi nasce per attività locali che lavorano bene ma non vogliono diventare esperti di marketing.
                Il sistema osserva, ordina e porta in superficie una priorità comprensibile.
              </p>
              <div class="manifesto-rule">
                <span>REGOLA 01</span>
                <strong>Nessuna promessa di primo posto.</strong>
              </div>
              <div class="manifesto-rule">
                <span>REGOLA 02</span>
                <strong>Nessun problema inventato per vendere un servizio.</strong>
              </div>
              <div class="manifesto-rule">
                <span>REGOLA 03</span>
                <strong>Ogni consiglio deve partire da un segnale osservato.</strong>
              </div>
            </div>
          </div>
        </section>

        <section class="final-cta">
          <div class="section-shell final-cta-inner">
            <div>
              <span class="section-kicker">IL TUO MERCATO È GIÀ ONLINE</span>
              <h2>Scopri cosa vede oggi<br />chi potrebbe sceglierti.</h2>
            </div>
            <a class="button button-primary button-large" href="#analizza">Apri Trovatemi Radar <span>→</span></a>
          </div>
        </section>
      </main>

      <footer>
        <div class="footer-main">
          <div>
            <a class="brand footer-brand" href="/">
              <span class="brand-mark">T</span>
              <span class="brand-word">TROVATEMI.IT</span>
              <b>★</b>
            </a>
            <p>Local intelligence per attività che vogliono essere trovate, capite e scelte.</p>
          </div>

          <div class="footer-meta">
            <span>PRODOTTO</span>
            <a href="#come-funziona">Come funziona</a>
            <a href="#cosa-controlla">Cosa osserva</a>
            <a href="#analizza">Analizza la tua attività</a>
          </div>

          <div class="footer-meta">
            <span>PRINCIPI</span>
            <p>Dati pubblici osservati.</p>
            <p>Nessun ranking assoluto.</p>
            <p>Nessuna promessa garantita.</p>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© 2026 TROVATEMI.IT</span>
          <span>Costruito per attività locali italiane.</span>
        </div>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const form = document.getElementById('search-form');
        const categoryInput = document.getElementById('category');
        const cityInput = document.getElementById('city');
        const searchButton = document.getElementById('search-button');
        const loading = document.getElementById('loading');
        const resultsSection = document.getElementById('results-section');
        const selectedSection = document.getElementById('selected-section');
        const verdictSection = document.getElementById('verdict-section');
        const resultsList = document.getElementById('results-list');
        const queryTitle = document.getElementById('query-title');
        const checkButton = document.getElementById('check-button');
        const opportunityList = document.getElementById('opportunity-list');
        const decisionMode = document.getElementById('decision-mode');

        let currentRun = null;
        let selected = null;

        const escapeHtml = (value) => String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#39;');

        function setLoading(state) {
          loading.hidden = !state;
          searchButton.disabled = state;
          searchButton.querySelector('span').textContent = state ? 'Sto cercando…' : 'Cerca la mia attività';
        }

        function yesNo(value) {
          return value ? '✓' : '—';
        }

        function formatRating(value) {
          if (typeof value !== 'number') return '—';
          return value.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' ★';
        }

        function formatNumber(value) {
          if (typeof value !== 'number') return '—';
          return value.toLocaleString('it-IT');
        }

        function renderResults(data) {
          currentRun = data;
          selected = null;
          selectedSection.hidden = true;
          verdictSection.hidden = true;

          queryTitle.textContent = '“' + data.query + '”';

          resultsList.innerHTML = data.results.map((item, index) => {
            const rating = formatRating(item.rating);
            const reviews = typeof item.reviews === 'number'
              ? item.reviews.toLocaleString('it-IT') + ' recensioni'
              : 'recensioni non disponibili';

            return '<article class="result-card">' +
              '<div class="position-chip">#' + (index + 1) + '</div>' +
              '<div class="result-main">' +
                '<strong>' + escapeHtml(item.name) + '</strong>' +
                '<span>' + escapeHtml(item.address) + '</span>' +
                '<div class="result-meta">' +
                  '<b>' + escapeHtml(rating) + '</b>' +
                  '<i>•</i>' +
                  '<b>' + escapeHtml(reviews) + '</b>' +
                '</div>' +
              '</div>' +
              '<button type="button" data-select="' + escapeHtml(item.id) + '">Questa è la mia attività <span>→</span></button>' +
            '</article>';
          }).join('');

          resultsSection.hidden = false;
          resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function setBenchmark(mine, median) {
          const mineValue = typeof mine === 'number' ? mine : 0;
          const medianValue = typeof median === 'number' ? median : 0;
          const max = Math.max(mineValue, medianValue, 1);

          document.getElementById('benchmark-you').textContent = typeof mine === 'number' ? formatNumber(mine) : '—';
          document.getElementById('selected-review-bar').style.width = Math.max(8, Math.round((mineValue / max) * 100)) + '%';
          document.getElementById('median-review-bar').style.width = Math.max(8, Math.round((medianValue / max) * 100)) + '%';
        }

        function severityLabel(value) {
          if (value === 'high') return 'ALTA PRIORITÀ';
          if (value === 'medium') return 'DA SISTEMARE';
          return 'MONITORA';
        }

        function renderOpportunities(data) {
          const opportunities = Array.isArray(data?.opportunities) ? data.opportunities : [];
          decisionMode.textContent = data?.decisionMode === 'jev' ? 'Decision layer · Jev' : 'Decision layer · regole';
          if (!opportunities.length) {
            opportunityList.innerHTML = '<article class="opportunity-card"><span class="opp-severity monitor">MONITORA</span><h4>Nessuna opportunità forte rilevata.</h4><p>Servono più segnali prima di consigliare un intervento.</p></article>';
            return;
          }

          opportunityList.innerHTML = opportunities.map((item, index) => {
            const severity = item.severity === 'high' ? 'high' : item.severity === 'medium' ? 'medium' : 'monitor';
            return '<article class="opportunity-card ' + severity + '">' +
              '<div class="opp-top"><span class="opp-index">0' + (index + 1) + '</span><span class="opp-severity ' + severity + '">' + escapeHtml(severityLabel(severity)) + '</span></div>' +
              '<h4>' + escapeHtml(item.title) + '</h4>' +
              '<p>' + escapeHtml(item.reason) + '</p>' +
              '<div class="opp-action"><span>' + escapeHtml(item.action) + '</span>' +
              (item.actionType !== 'monitor' ? '<button type="button" data-fix-opportunity="' + escapeHtml(item.id) + '">Sistemalo →</button>' : '') +
              '</div>' +
            '</article>';
          }).join('');
        }

        async function loadOpportunities(runId, prospectId) {
          opportunityList.innerHTML = '<article class="opportunity-card loading-card"><span></span><b>Sto leggendo i segnali…</b></article>';
          decisionMode.textContent = 'Analisi in corso…';
          try {
            const response = await fetch('/api/public-opportunities', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ runId, prospectId }),
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'opportunities_failed');
            renderOpportunities(data);
          } catch {
            decisionMode.textContent = 'Decision layer · non disponibile';
            opportunityList.innerHTML = '<article class="opportunity-card"><span class="opp-severity monitor">MONITORA</span><h4>Il Radar non è disponibile in questo momento.</h4><p>I dati osservati restano visibili sopra. Riprova tra poco per le priorità.</p></article>';
          }
        }

        function selectBusiness(id) {
          if (!currentRun) return;
          selected = currentRun.results.find((item) => item.id === id);
          if (!selected) return;


          fetch('/api/public-event', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ event: 'selection' }),
            keepalive: true,
          }).catch(() => {});

          document.getElementById('selected-name').textContent = selected.name;
          document.getElementById('selected-address').textContent = selected.address;
          document.getElementById('selected-rating').textContent = formatRating(selected.rating);
          document.getElementById('selected-reviews').textContent = formatNumber(selected.reviews);
          document.getElementById('median-reviews').textContent = currentRun.medianReviews == null
            ? '—'
            : '~' + formatNumber(Math.round(currentRun.medianReviews));

          setBenchmark(selected.reviews, currentRun.medianReviews);

          document.getElementById('signal-phone').textContent = yesNo(selected.phonePresent);
          document.getElementById('signal-site').textContent = yesNo(selected.websitePresent);
          document.getElementById('signal-direct').textContent = yesNo(selected.directActionPresent);

          const strongRating = typeof selected.rating === 'number' && selected.rating >= 4.4;
          const reviewGap = typeof selected.reviews === 'number'
            && typeof currentRun.medianReviews === 'number'
            && selected.reviews < currentRun.medianReviews;

          const title = document.getElementById('verdict-title');
          const copy = document.getElementById('verdict-copy');

          if (strongRating && reviewGap) {
            title.innerHTML = 'SEI MEGLIO<br><em>DI COME APPARI.</em>';
            copy.textContent = 'Chi ti ha già scelto sembra apprezzarti. Ma prima della chiamata altri possono sembrare più scelti.';
          } else if (strongRating) {
            title.innerHTML = 'SEI GIÀ CREDIBILE.<br><em>FALLO PESARE.</em>';
            copy.textContent = 'Le prove ci sono. Il punto è renderle più facili da vedere nel momento della scelta.';
          } else {
            title.innerHTML = 'TI HO TROVATO.<br><em>ORA GUARDIAMO MEGLIO.</em>';
            copy.textContent = 'Ci sono abbastanza segnali per capire cosa incontra una persona prima di contattarti.';
          }

          selectedSection.hidden = false;
          verdictSection.hidden = false;
          loadOpportunities(currentRun.runId, selected.id);
          selectedSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        async function search(category, city) {
          setLoading(true);
          resultsSection.hidden = true;
          selectedSection.hidden = true;
          verdictSection.hidden = true;

          try {
            const response = await fetch('/api/public-search', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ category, city }),
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'search_failed');
            if (!data.results?.length) throw new Error('no_results');
            renderResults(data);
          } catch {
            resultsList.innerHTML =
              '<div class="empty-state">' +
                '<div class="empty-icon">⌕</div>' +
                '<strong>Non ho trovato abbastanza.</strong>' +
                '<span>Prova una categoria più semplice o una città vicina.</span>' +
              '</div>';
            queryTitle.textContent = 'Nessun risultato utile';
            resultsSection.hidden = false;
            resultsSection.scrollIntoView({ behavior: 'smooth' });
          } finally {
            setLoading(false);
          }
        }

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const category = categoryInput.value.trim();
          const city = cityInput.value.trim();
          if (category.length < 2 || city.length < 2) return;
          search(category, city);
        });

        document.querySelectorAll('[data-example-category]').forEach((button) => {
          button.addEventListener('click', () => {
            categoryInput.value = button.dataset.exampleCategory || '';
            cityInput.value = button.dataset.exampleCity || '';
            search(categoryInput.value, cityInput.value);
          });
        });

        resultsList.addEventListener('click', (event) => {
          const button = event.target.closest('[data-select]');
          if (!button) return;
          selectBusiness(button.dataset.select);
        });

        opportunityList.addEventListener('click', (event) => {
          const button = event.target.closest('[data-fix-opportunity]');
          if (!button) return;
          checkButton.click();
        });

        checkButton.addEventListener('click', async () => {
          if (!currentRun || !selected) return;
          checkButton.disabled = true;
          checkButton.querySelector('span').textContent = 'Preparo il Check…';

          try {
            const response = await fetch('/api/public-check', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                runId: currentRun.runId,
                prospectId: selected.id,
              }),
            });
            const data = await response.json();
            if (!response.ok || !data.shareUrl) throw new Error(data.error || 'check_failed');
            window.location.href = data.shareUrl;
          } catch {
            checkButton.disabled = false;
            checkButton.querySelector('span').textContent = 'Riprova';
          }
        });
      })();
    </script>
  </body>
</html>

