---
export const prerender = true;

import '@fontsource-variable/archivo';
import '@fontsource/anton';

const instagramUrl = 'https://www.instagram.com/trovatemi.it/';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta
      name="description"
      content="Hai clienti felici. Fai in modo che si veda. Trovatemi mette al lavoro il passaparola che hai già."
    />
    <link rel="canonical" href="https://trovatemi.it/" />
    <title>Trovatemi.it — Il passaparola che hai già. Messo al lavoro.</title>
  </head>

  <body>
    <main>
      <header class="brand">TROVATEMI.IT <span>★</span></header>

      <section class="hero">
        <p class="kicker">IL PASSAPAROLA CHE HAI GIÀ. MESSO AL LAVORO.</p>

        <h1>
          HAI CLIENTI<br />
          FELICI.<br />
          <mark>FAI IN MODO<br />CHE SI VEDA.</mark>
        </h1>

        <p class="lead">
          Recensioni, risposte e contenuti.<br />
          Facciamo lavorare meglio quello che i clienti dicono già di te.
        </p>

        <div class="steps" aria-label="Come funziona">
          <article>
            <span>01</span>
            <strong>RACCOGLI</strong>
            <p>Il cliente è contento. Rendiamo semplice lasciare una recensione.</p>
          </article>

          <article>
            <span>02</span>
            <strong>RISPONDI</strong>
            <p>La recensione non resta lì da sola. La trasformi in relazione e fiducia.</p>
          </article>

          <article>
            <span>03</span>
            <strong>FALLA LAVORARE</strong>
            <p>Le parole migliori diventano prova visibile anche fuori da Google.</p>
          </article>
        </div>

        <div class="cta-block">
          <a class="cta" href={instagramUrl} target="_blank" rel="noreferrer">
            SCRIVICI SU INSTAGRAM <span>→</span>
          </a>
          <p>Mandaci solo il nome della tua attività.</p>
        </div>
      </section>

      <footer>
        <p>Non promettiamo posizioni. Non filtriamo recensioni. Partiamo da quello che hai già.</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    --black: #08090a;
    --yellow: #f2bd18;
    --white: #ffffff;
    --muted: #a6a6a0;
    --line: #292a2c;
  }

  * { box-sizing: border-box; }

  html {
    background: var(--black);
    color: var(--white);
    font-family: "Archivo Variable", Arial, sans-serif;
  }

  body { margin: 0; }

  main {
    width: min(1120px, 100%);
    min-height: 100dvh;
    margin: 0 auto;
    padding: 24px clamp(18px, 4vw, 52px) 28px;
  }

  .brand {
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    letter-spacing: .01em;
  }

  .brand span { color: var(--yellow); }

  .hero {
    display: flex;
    min-height: calc(100dvh - 110px);
    flex-direction: column;
    justify-content: center;
    padding: clamp(46px, 8vw, 90px) 0;
  }

  .kicker {
    margin: 0 0 18px;
    color: var(--yellow);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .12em;
  }

  h1 {
    max-width: 10ch;
    margin: 0;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(4.6rem, 11vw, 9rem);
    font-weight: 400;
    line-height: .86;
    letter-spacing: .005em;
  }

  mark {
    color: var(--black);
    background: var(--yellow);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 .08em .06em;
  }

  .lead {
    max-width: 660px;
    margin: 28px 0 0;
    color: #deded9;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.45;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(44px, 7vw, 72px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .steps article {
    min-height: 190px;
    padding: 22px 22px 22px 0;
  }

  .steps article + article {
    border-left: 1px solid var(--line);
    padding-left: 22px;
  }

  .steps span {
    display: block;
    margin-bottom: 18px;
    color: var(--yellow);
    font-size: .68rem;
    font-weight: 900;
  }

  .steps strong {
    display: block;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    line-height: 1;
  }

  .steps p {
    max-width: 28ch;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.5;
  }

  .cta-block {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    align-items: center;
    margin-top: 34px;
  }

  .cta {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 22px;
    color: var(--black);
    background: var(--yellow);
    font-size: .82rem;
    font-weight: 900;
    text-decoration: none;
  }

  .cta span { font-size: 1.45rem; }

  .cta-block p {
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
  }

  footer {
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }

  footer p {
    margin: 0;
    color: #7f7f7a;
    font-size: .66rem;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    main { padding-inline: 18px; }

    .hero {
      min-height: auto;
      padding: 54px 0 64px;
    }

    h1 {
      font-size: clamp(4rem, 21vw, 6.6rem);
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .steps article {
      min-height: 0;
      padding: 22px 0;
    }

    .steps article + article {
      border-top: 1px solid var(--line);
      border-left: 0;
      padding-left: 0;
    }

    .cta-block {
      align-items: stretch;
      flex-direction: column;
    }

    .cta {
      width: 100%;
    }
  }
</style>
