---
export const prerender = true;

import '@fontsource-variable/archivo';
import '@fontsource/anton';

const checkUrl = '/beauty-check/';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Trovatemi trasforma il passaparola che hai già in prova visibile: recensioni, risposte e contenuti che aiutano le persone a sceglierti."
    />
    <meta name="theme-color" content="#08090a" />
    <link rel="canonical" href="https://trovatemi.it/" />
    <title>Trovatemi.it — Il passaparola che hai già. Messo al lavoro.</title>
  </head>

  <body>
    <main class="landing">
      <section class="hero">
        <img class="hero-bg" src="/images/hero-local-business.webp" alt="" fetchpriority="high" />
        <div class="hero-overlay"></div>

        <header class="brand-row">
          <a class="brand" href="/" aria-label="Trovatemi.it home">TROVATEMI.IT <span>★</span></a>
          <p>BEAUTY BUSINESSES GROW</p>
        </header>

        <div class="hero-copy">
          <h1>
            TI CERCANO<br />
            SU GOOGLE.<br />
            <mark>TI SCELGONO</mark><br />
            IN 5 SECONDI.
          </h1>

          <div class="brush-line"></div>

          <p class="hero-sub">
            Il passaparola che hai già.<br />
            Messo al lavoro.
          </p>

          <div class="hero-actions">
            <a class="cta cta-yellow" href={checkUrl}>FAI IL CHECK <span>→</span></a>
            <a class="cta cta-whatsapp" href="#contatto">
              <span class="wa-dot">WA</span>
              <span>Scrivici su<br /><b>WhatsApp</b></span>
            </a>
          </div>

          <div class="micro-proof">
            <div><b>⚡</b><span>In 2 minuti<br />Senza impegno</span></div>
            <div><b>✓</b><span>21 giorni<br />di test gratuito</span></div>
            <div><b>●●●</b><span>Partiamo da<br />attività reali</span></div>
          </div>
        </div>

        <div class="hero-note">
          <p>Più visibili.<br />Più clienti.<br />Più libertà.</p>
          <span>♡</span>
        </div>
      </section>

      <section class="choice">
        <div class="phone-wrap">
          <div class="phone">
            <div class="phone-bar">9:41 <span>▰ ◔</span></div>
            <div class="google-search">
              <span class="g">G</span>
              <span>parrucchiere vicino a me</span>
              <span class="mic">●</span>
            </div>
            <div class="tabs"><b>Tutti</b><span>Maps</span><span>Immagini</span><span>Video</span><span>Notizie</span></div>
            <div class="map">
              <i class="pin p1">●</i>
              <i class="pin p2">●</i>
              <i class="pin p3">●</i>
              <i class="pin p4">●</i>
            </div>
            <div class="places">
              <article>
                <div class="thumb t1"></div>
                <div>
                  <strong>Hair Studio Glam</strong>
                  <span>4,8 <b>★★★★★</b> (384)</span>
                  <small>Parrucchiere · 1,2 km</small>
                  <small class="open">Aperto · Chiude alle 19:30</small>
                </div>
              </article>
              <article>
                <div class="thumb t2"></div>
                <div>
                  <strong>Il Tuo Salone</strong>
                  <span>4,3 <b>★★★★☆</b> (41)</span>
                  <small>Parrucchiere · 1,6 km</small>
                  <small class="open">Aperto · Chiude alle 19:00</small>
                </div>
              </article>
              <article>
                <div class="thumb t3"></div>
                <div>
                  <strong>Beauty Lab</strong>
                  <span>4,1 <b>★★★★☆</b> (27)</span>
                  <small>Parrucchiere · 2,1 km</small>
                  <small class="open">Aperto · Chiude alle 19:30</small>
                </div>
              </article>
            </div>
          </div>
        </div>

        <div class="choice-copy">
          <h2>TI CERCANO.<br />TI CONFRONTANO.</h2>
          <div class="brush-copy">SCELGONO QUELLO<br />CHE SEMBRA PIÙ SICURO.</div>
          <p>
            Le persone guardano recensioni, foto e contenuti prima ancora di contattarti.
            <strong>Fatti trovare nel modo giusto.</strong>
          </p>

          <div class="feature-icons">
            <div><span>★</span><b>Recensioni<br />vere</b></div>
            <div><span>▣</span><b>Foto<br />reali</b></div>
            <div><span>●</span><b>Posizione<br />chiara</b></div>
            <div><span>♟</span><b>Contenuti<br />aggiornati</b></div>
          </div>

          <div class="hand-note">Stessi clienti.<br />Scelte diverse. ↙</div>
        </div>
      </section>

      <section class="proof">
        <div class="proof-photo">
          <img src="/images/hero-local-business.webp" alt="" loading="lazy" />
          <div class="proof-shade"></div>

          <div class="bubble bubble-white">Mi sono trovata<br />benissimo! ❤️</div>
          <div class="bubble bubble-green">Grazie! 🙏</div>
          <div class="proof-hand">Questo<br />è il tuo vero<br />marketing. ♡</div>
        </div>

        <div class="proof-system">
          <header>
            <h2>DA CLIENTE FELICE<br />A <mark>PROVA VISIBILE.</mark></h2>
            <p>Con Trovatemi trasformi ogni esperienza in nuove recensioni, contenuti e clienti.</p>
          </header>

          <div class="steps">
            <article>
              <div class="step-title"><span>1</span><b>Raccogli</b></div>
              <p>Fai lasciare recensioni con QR code o NFC.</p>
              <div class="step-media">
                <img src="/images/proof-beauty-nfc-v1.webp" alt="Supporto QR per recensione" loading="lazy" />
              </div>
            </article>

            <article>
              <div class="step-title"><span>2</span><b>Rispondi</b></div>
              <p>Ti aiutiamo a gestire e rispondere.</p>
              <div class="reply-card">
                <small>Laura B. · ★★★★★ · 5 giorni fa</small>
                <strong>Servizio fantastico!<br />Tornerò sicuramente! ❤️</strong>
                <div>Grazie di cuore!<br />A presto! 💛</div>
              </div>
            </article>

            <article>
              <div class="step-title"><span>3</span><b>Condividi</b></div>
              <p>Trasforma le recensioni in contenuti social.</p>
              <div class="step-media">
                <img src="/images/proof-beauty-social-v1.webp" alt="Esempio di recensione trasformata in contenuto social" loading="lazy" />
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="final" id="contatto">
        <div class="final-copy">
          <h2>PIÙ PROVE.<br />PIÙ FIDUCIA.<br /><mark>PIÙ CLIENTI.</mark></h2>
          <a class="footer-brand" href="/">TROVATEMI.IT <span>★</span></a>
          <p>IL TUO SALONE. OVUNQUE LE PERSONE CERCANO.</p>
        </div>

        <div class="flow">
          <div><span>●●</span><b>Cliente felice</b></div>
          <i>→</i>
          <div><span>★</span><b>Recensione</b></div>
          <i>→</i>
          <div><span>☵</span><b>Risposta</b></div>
          <i>→</i>
          <div><span>▣</span><b>Contenuto<br />social</b></div>
          <i>→</i>
          <div><span>▥</span><b>Più clienti</b></div>
        </div>

        <div class="final-actions">
          <a class="cta cta-yellow cta-large" href={checkUrl}>INIZIA ORA <span>→</span></a>
          <div>
            <strong>21 GIORNI DI TEST</strong>
            <p>Zero sbatti. Zero vincoli.</p>
          </div>
        </div>

        <div class="final-note">Più<br />Bellezza<br />nel Mondo. ♡</div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --black: #08090a;
    --yellow: #f6c400;
    --paper: #f7f5ef;
    --grey: #6d6d67;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--black);
  }

  body {
    margin: 0;
    font-family: "Archivo Variable", Arial, sans-serif;
    color: var(--black);
    background: var(--paper);
    -webkit-font-smoothing: antialiased;
  }

  img { display: block; max-width: 100%; }

  .landing {
    width: 100%;
    overflow: hidden;
  }

  .hero {
    position: relative;
    min-height: 720px;
    color: white;
    background: var(--black);
  }

  .hero-bg {
    position: absolute;
    inset: 0 0 0 auto;
    width: 57%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #050607 0 37%, rgba(5,6,7,.96) 43%, rgba(5,6,7,.5) 62%, rgba(5,6,7,.12) 100%),
      linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.3));
  }

  .brand-row {
    position: relative;
    z-index: 2;
    padding: 24px clamp(24px, 4vw, 64px) 0;
  }

  .brand {
    display: inline-flex;
    gap: .4rem;
    align-items: center;
    color: white;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(1.65rem, 2.2vw, 2.3rem);
    text-decoration: none;
    letter-spacing: .01em;
  }

  .brand span { color: var(--yellow); }

  .brand-row p {
    margin: .2rem 0 0;
    font-size: .68rem;
    letter-spacing: .28em;
    font-weight: 700;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(54%, 760px);
    padding: 36px 0 54px clamp(24px, 4vw, 64px);
  }

  .hero h1,
  .choice h2,
  .proof-system h2,
  .final h2 {
    margin: 0;
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-weight: 400;
    line-height: .9;
    letter-spacing: .005em;
  }

  .hero h1 {
    font-size: clamp(4rem, 7vw, 7.3rem);
  }

  mark {
    color: var(--yellow);
    background: transparent;
  }

  .brush-line {
    width: 340px;
    max-width: 80%;
    height: 10px;
    margin: 18px 0 16px 28px;
    border-radius: 50%;
    background: var(--yellow);
    transform: rotate(-2deg);
  }

  .hero-sub {
    margin: 0;
    font-size: clamp(1.25rem, 1.8vw, 1.85rem);
    line-height: 1.25;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: stretch;
    margin-top: 28px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    min-height: 58px;
    border-radius: 14px;
    padding: .95rem 1.45rem;
    text-decoration: none;
    font-weight: 900;
  }

  .cta-yellow {
    min-width: 265px;
    color: var(--black);
    background: var(--yellow);
    font-size: 1rem;
  }

  .cta-yellow span {
    font-size: 1.5rem;
  }

  .cta-whatsapp {
    gap: .7rem;
    min-width: 200px;
    border: 2px solid rgba(255,255,255,.8);
    color: white;
    background: rgba(0,0,0,.35);
    font-size: .8rem;
    line-height: 1.05;
  }

  .wa-dot {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: #19bb4c;
    font-size: .72rem;
    font-weight: 900;
  }

  .micro-proof {
    display: flex;
    gap: 26px;
    margin-top: 18px;
    font-size: .72rem;
  }

  .micro-proof div {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .micro-proof b {
    color: var(--yellow);
    font-size: 1.1rem;
  }

  .hero-note {
    position: absolute;
    z-index: 2;
    top: 36px;
    right: 44px;
    max-width: 220px;
    color: white;
    font-size: 1.55rem;
    font-style: italic;
    transform: rotate(-5deg);
    text-align: center;
  }

  .hero-note p { margin: 0; line-height: 1.15; }
  .hero-note span { color: var(--yellow); font-size: 2.2rem; }

  .choice {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr .92fr;
    gap: clamp(44px, 6vw, 90px);
    align-items: center;
    min-height: 620px;
    padding: 54px clamp(24px, 4vw, 64px) 62px;
    background: white;
  }

  .choice::before,
  .proof::before,
  .final::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 24px;
    background: inherit;
    clip-path: polygon(0 45%, 4% 32%, 8% 54%, 13% 35%, 18% 52%, 23% 33%, 29% 50%, 35% 30%, 41% 52%, 47% 34%, 54% 51%, 61% 31%, 68% 53%, 76% 35%, 84% 50%, 91% 33%, 100% 45%, 100% 100%, 0 100%);
  }

  .phone-wrap {
    display: flex;
    justify-content: center;
  }

  .phone {
    width: min(440px, 88vw);
    border: 12px solid #111;
    border-radius: 46px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 50px rgba(0,0,0,.18);
    transform: rotate(-3deg);
  }

  .phone-bar {
    display: flex;
    justify-content: space-between;
    padding: 13px 20px 8px;
    font-size: .72rem;
    font-weight: 800;
  }

  .google-search {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 4px 14px 8px;
    border: 1px solid #ddd;
    border-radius: 28px;
    padding: 10px 13px;
    box-shadow: 0 3px 14px rgba(0,0,0,.08);
    font-size: .84rem;
  }

  .g { color: #4285f4; font-weight: 900; }
  .mic { margin-left: auto; color: #4285f4; }

  .tabs {
    display: flex;
    gap: 16px;
    padding: 0 18px 10px;
    color: #777;
    font-size: .6rem;
  }

  .tabs b { color: #4285f4; }

  .map {
    position: relative;
    height: 125px;
    background:
      linear-gradient(30deg, transparent 42%, rgba(255,255,255,.8) 44% 47%, transparent 49%),
      linear-gradient(-24deg, transparent 43%, rgba(255,255,255,.75) 45% 48%, transparent 50%),
      #dbe9d7;
  }

  .pin {
    position: absolute;
    color: #e64237;
    font-style: normal;
    font-size: 1.15rem;
  }

  .p1 { left: 16%; top: 44%; }
  .p2 { left: 45%; top: 28%; }
  .p3 { left: 72%; top: 56%; }
  .p4 { left: 82%; top: 18%; }

  .places article {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid #eee;
  }

  .thumb {
    border-radius: 7px;
    background:
      linear-gradient(135deg, rgba(0,0,0,.1), rgba(255,255,255,.05)),
      #c5ad8b;
  }

  .t2 { background-color: #d6d0c4; }
  .t3 { background-color: #b9a38b; }

  .places strong {
    display: block;
    font-size: .74rem;
  }

  .places span {
    display: block;
    font-size: .69rem;
  }

  .places span b { color: #f5b800; letter-spacing: -.08em; }

  .places small {
    display: block;
    color: #666;
    font-size: .59rem;
    line-height: 1.25;
  }

  .places .open { color: #22a344; }

  .choice-copy {
    position: relative;
    padding-right: 70px;
  }

  .choice h2 {
    font-size: clamp(3.1rem, 5.2vw, 5.5rem);
  }

  .brush-copy {
    width: fit-content;
    max-width: 100%;
    margin: 8px 0 14px;
    padding: .25rem .55rem .4rem;
    background: var(--yellow);
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: .96;
    transform: rotate(-1.5deg);
  }

  .choice-copy > p {
    max-width: 610px;
    margin: 0;
    color: #4d4d48;
    font-size: 1rem;
    line-height: 1.48;
  }

  .choice-copy > p strong {
    display: block;
    color: var(--black);
  }

  .feature-icons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 28px;
  }

  .feature-icons div {
    text-align: center;
    font-size: .7rem;
  }

  .feature-icons span {
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    margin: 0 auto 8px;
    border: 1px solid #ddd;
    border-radius: 50%;
    font-size: 1.35rem;
  }

  .feature-icons b { font-weight: 650; }

  .hand-note {
    position: absolute;
    right: -10px;
    top: -12px;
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.18;
    transform: rotate(-6deg);
  }

  .proof {
    position: relative;
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    min-height: 620px;
    color: white;
    background: var(--black);
  }

  .proof-photo {
    position: relative;
    min-height: 620px;
    overflow: hidden;
  }

  .proof-photo > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .proof-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.6));
  }

  .bubble {
    position: absolute;
    z-index: 2;
    border-radius: 14px;
    padding: .75rem 1rem;
    font-weight: 700;
    line-height: 1.12;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
  }

  .bubble-white {
    top: 90px;
    left: 28px;
    color: var(--black);
    background: white;
  }

  .bubble-green {
    top: 185px;
    left: 100px;
    color: var(--black);
    background: #c8f8a9;
  }

  .proof-hand {
    position: absolute;
    z-index: 2;
    left: 28px;
    bottom: 35px;
    color: var(--yellow);
    font-size: 1.7rem;
    font-style: italic;
    line-height: 1.05;
    transform: rotate(-6deg);
  }

  .proof-system {
    padding: 54px clamp(24px, 4vw, 60px) 50px;
  }

  .proof-system h2 {
    font-size: clamp(3.1rem, 5vw, 5.4rem);
  }

  .proof-system header > p {
    max-width: 690px;
    margin: 10px 0 0;
    color: #d3d3ce;
    line-height: 1.45;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 22px;
  }

  .steps article {
    overflow: hidden;
    border-radius: 12px;
    color: var(--black);
    background: white;
  }

  .step-title {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 12px 12px 4px;
  }

  .step-title span {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    font-weight: 900;
  }

  .step-title b { font-size: 1rem; }

  .steps article > p {
    min-height: 48px;
    margin: 0;
    padding: 0 12px 10px;
    color: #333;
    font-size: .74rem;
    line-height: 1.3;
  }

  .step-media {
    height: 240px;
    overflow: hidden;
  }

  .step-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reply-card {
    height: 240px;
    padding: 16px;
    background: #f4f4f4;
  }

  .reply-card small {
    color: #666;
    font-size: .62rem;
  }

  .reply-card strong {
    display: block;
    margin-top: 12px;
    font-size: .8rem;
    line-height: 1.4;
  }

  .reply-card div {
    margin-top: 22px;
    border-radius: 12px;
    padding: 12px;
    background: #c8f8a9;
    font-size: .76rem;
    line-height: 1.3;
  }

  .final {
    position: relative;
    display: grid;
    grid-template-columns: .9fr 1.5fr;
    gap: 38px 70px;
    padding: 58px clamp(24px, 4vw, 64px) 44px;
    background: white;
  }

  .final-copy h2 {
    font-size: clamp(3rem, 4.5vw, 4.8rem);
    line-height: .88;
  }

  .final-copy h2 mark {
    display: inline-block;
    margin-top: 3px;
    padding: .02em .1em .08em;
    color: var(--black);
    background: var(--yellow);
    transform: rotate(-1deg);
  }

  .footer-brand {
    display: inline-flex;
    gap: .35rem;
    margin-top: 26px;
    color: var(--black);
    font-family: "Anton", "Arial Narrow", sans-serif;
    font-size: 1.35rem;
    text-decoration: none;
  }

  .footer-brand span { color: var(--yellow); }

  .final-copy > p {
    margin: 2px 0 0;
    color: #5e5e58;
    font-size: .68rem;
    letter-spacing: .04em;
  }

  .flow {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    padding-top: 10px;
  }

  .flow div {
    min-width: 76px;
    text-align: center;
  }

  .flow div span {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    margin: 0 auto 8px;
    border: 1px solid #ddd;
    border-radius: 50%;
    font-size: 1.4rem;
  }

  .flow div b {
    font-size: .66rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .flow i {
    color: #9b7a00;
    font-style: normal;
    font-size: 1.2rem;
  }

  .final-actions {
    grid-column: 2;
