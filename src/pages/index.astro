---
export const prerender = true;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Cerca la tua attività e guarda cosa vede un cliente prima di chiamarti. Gratis, in pochi secondi, con dati pubblici osservati."
    />
    <meta name="theme-color" content="#f5f5ef" />
    <meta property="og:title" content="Trovatemi.it — Ti troveresti?" />
    <meta property="og:description" content="Cercati come ti cerca un cliente. Guarda cosa vede prima di sceglierti." />
    <link rel="canonical" href="https://trovatemi.it/" />
    <title>Trovatemi.it — Ti troveresti?</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Trovatemi.it home">
        <span>TROVATEMI.IT</span><b>★</b>
      </a>
      <div class="header-status">
        <span class="status-dot"></span>
        <span>Ricerca locale live</span>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <div class="hero-kicker">COME TI VEDE UN CLIENTE?</div>
          <h1>TI TROVERESTI?<br /><em>E TI SCEGLIERESTI?</em></h1>
          <p class="hero-lede">
            Cerca la tua attività e guarda cosa incontra una persona <strong>prima di chiamarti</strong>.
            Niente audit finto. Niente account. Solo segnali pubblici osservati.
          </p>

          <div class="trust-row">
            <span>✓ Gratis</span>
            <span>✓ 30 secondi</span>
            <span>✓ Nessun account</span>
          </div>
        </div>

        <aside class="search-panel" aria-label="Cerca la tua attività">
          <div class="panel-progress">
            <span class="step-badge active">1</span>
            <span class="step-line"></span>
            <span class="step-badge">2</span>
            <span class="step-line"></span>
            <span class="step-badge">3</span>
          </div>

          <div class="panel-copy">
            <small>PASSO 1 DI 3</small>
            <h2>Cercati come ti cerca lui.</h2>
            <p>Dimmi cosa fai e dove lavori.</p>
          </div>

          <form id="search-form" class="search-form">
            <label>
              <span>COSA FAI?</span>
              <div class="input-shell">
                <i>⌕</i>
                <input id="category" name="category" autocomplete="organization-title" placeholder="es. officina" required />
              </div>
            </label>

            <label>
              <span>DOVE?</span>
              <div class="input-shell">
                <i>⌖</i>
                <input id="city" name="city" autocomplete="address-level2" placeholder="es. Formia" required />
              </div>
            </label>

            <button id="search-button" class="primary-button" type="submit">
              <span>Cerca la mia attività</span>
              <b>→</b>
            </button>
          </form>

          <div class="examples">
            <span>PROVA AL VOLO</span>
            <button type="button" data-example-category="officina" data-example-city="Formia">officina · Formia</button>
            <button type="button" data-example-category="serramenti" data-example-city="Formia">serramenti · Formia</button>
            <button type="button" data-example-category="gommista" data-example-city="Gaeta">gommista · Gaeta</button>
          </div>
        </aside>
      </section>

      <section class="proof-strip">
        <div>
          <strong>Non ti stiamo dando un voto.</strong>
          <span>Ti mostriamo il contesto in cui vieni scelto.</span>
        </div>
        <div class="proof-strip-note">Google-like nella logica, non affiliato a Google.</div>
      </section>

      <section id="loading" class="loading-state" hidden>
        <div class="loading-inner">
          <div class="pulse-ring"><span></span></div>
          <div>
            <small>RICERCA IN CORSO</small>
            <strong>Ti sto cercando come farebbe un cliente.</strong>
            <p>Sto confrontando presenza, recensioni e percorso di contatto.</p>
          </div>
        </div>
      </section>

      <section id="results-section" class="results-section" hidden>
        <div class="section-shell">
          <div class="section-intro">
            <div class="section-step">
              <span>2</span>
              <div>
                <small>PASSO 2 DI 3</small>
                <b>Riconosciti.</b>
              </div>
            </div>
            <h2 id="query-title"></h2>
            <p>Queste sono alcune attività incontrate nella ricerca osservata. Qual è la tua?</p>
          </div>

          <div class="results-frame">
            <div class="results-toolbar">
              <span>RISULTATI OSSERVATI</span>
              <span>rating · recensioni · presenza</span>
            </div>
            <div id="results-list" class="results-list"></div>
          </div>

          <p class="claim-rule">
            L'ordine mostrato è quello restituito nella specifica ricerca osservata e non rappresenta un ranking Google assoluto.
          </p>
        </div>
      </section>

      <section id="selected-section" class="selected-section" hidden>
        <div class="section-shell">
          <div class="section-intro compact">
            <div class="section-step inverse">
              <span>3</span>
              <div>
                <small>PASSO 3 DI 3</small>
                <b>Guarda cosa vede.</b>
              </div>
            </div>
            <h2 id="selected-name"></h2>
            <p id="selected-address" class="address"></p>
          </div>

          <div class="diagnostic-grid">
            <article class="diagnostic-card main-metric">
              <div class="card-label">PROVA SOCIALE</div>
              <div class="metric-head">
                <div>
                  <small>Rating osservato</small>
                  <strong id="selected-rating">—</strong>
                </div>
                <div>
                  <small>Recensioni</small>
                  <strong id="selected-reviews">—</strong>
                </div>
              </div>

              <div class="benchmark">
                <div class="benchmark-head">
                  <span>Tu</span>
                  <span id="benchmark-you">—</span>
                </div>
                <div class="bar"><i id="selected-review-bar"></i></div>

                <div class="benchmark-head">
                  <span>Mediana osservata</span>
                  <span id="median-reviews">—</span>
                </div>
                <div class="bar muted"><i id="median-review-bar"></i></div>
              </div>

              <p class="card-foot">Non dice chi lavora meglio. Dice chi sembra più scelto prima della chiamata.</p>
            </article>

            <article class="diagnostic-card contact-card">
              <div class="card-label">FRIZIONE DI CONTATTO</div>
              <h3>Quanto è facile passare da “mi interessa” a “ti chiamo”?</h3>

              <div class="signal-list">
                <div class="signal-row"><span><i>☎</i> Telefono</span><b id="signal-phone">—</b></div>
                <div class="signal-row"><span><i>↗</i> Sito</span><b id="signal-site">—</b></div>
                <div class="signal-row"><span><i>✦</i> Contatto diretto</span><b id="signal-direct">—</b></div>
              </div>

              <p class="card-foot">Ogni passaggio in più è lavoro che chiedi al cliente.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="verdict-section" class="verdict-section" hidden>
        <div class="verdict-shell">
          <div class="verdict-copy">
            <div class="verdict-kicker">QUELLO CHE VEDO</div>
            <h2 id="verdict-title">SEI MEGLIO<br /><em>DI COME APPARI.</em></h2>
            <p id="verdict-copy"></p>
          </div>

          <div class="cta-card">
            <small>IL PASSO SUCCESSIVO</small>
            <h3>Vuoi vedere il percorso completo?</h3>
            <p>Ti preparo un Check privato con confronto, frizioni e le 3 cose che sistemerei per prime.</p>
            <button id="check-button" class="cta-button" type="button">
              <span>Fammi vedere il Check</span>
              <b>→</b>
            </button>
            <div class="cta-proof">Gratis · link privato · niente account</div>
          </div>
        </div>
      </section>

      <section class="how-it-works">
        <div class="section-shell">
          <div class="how-copy">
            <small>PERCHÉ FUNZIONA</small>
            <h2>Il cliente non legge il tuo curriculum.</h2>
            <p>Ti trova. Ti confronta. Decide se sembri una scelta facile.</p>
          </div>

          <div class="how-grid">
            <article>
              <span>01</span>
              <div><strong>TI TROVA?</strong><p>Compari nel momento giusto?</p></div>
            </article>
            <article>
              <span>02</span>
              <div><strong>TI SCEGLIE?</strong><p>Le prove fanno abbastanza peso?</p></div>
            </article>
            <article>
              <span>03</span>
              <div><strong>TI CONTATTA?</strong><p>Il prossimo passo è immediato?</p></div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand inverse" href="/">TROVATEMI.IT <b>★</b></a>
      <p>Ti cerco come ti cerca lui.</p>
      <span>© 2026</span>
    </footer>

    <script is:inline>
      (() => {
        const form = document.getElementById('search-form');
        const categoryInput = document.getElementById('category');
        const cityInput = document.getElementById('city');
        const searchButton = document.getElementById('search-button');
        const loading = document.getElementById('loading');
        const resultsSection = document.getElementById('results-section');
        const selectedSection = document.getElementById('selected-section');
        const verdictSection = document.getElementById('verdict-section');
        const resultsList = document.getElementById('results-list');
        const queryTitle = document.getElementById('query-title');
        const checkButton = document.getElementById('check-button');

        let currentRun = null;
        let selected = null;

        const escapeHtml = (value) => String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#39;');

        function setLoading(state) {
          loading.hidden = !state;
          searchButton.disabled = state;
          searchButton.querySelector('span').textContent = state ? 'Sto cercando…' : 'Cerca la mia attività';
        }

        function yesNo(value) {
          return value ? '✓' : '—';
        }

        function formatRating(value) {
          if (typeof value !== 'number') return '—';
          return value.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' ★';
        }

        function formatNumber(value) {
          if (typeof value !== 'number') return '—';
          return value.toLocaleString('it-IT');
        }

        function renderResults(data) {
          currentRun = data;
          selected = null;
          selectedSection.hidden = true;
          verdictSection.hidden = true;

          queryTitle.textContent = '“' + data.query + '”';

          resultsList.innerHTML = data.results.map((item, index) => {
            const rating = formatRating(item.rating);
            const reviews = typeof item.reviews === 'number'
              ? item.reviews.toLocaleString('it-IT') + ' recensioni'
              : 'recensioni non disponibili';

            return '<article class="result-card">' +
              '<div class="position-chip">#' + (index + 1) + '</div>' +
              '<div class="result-main">' +
                '<strong>' + escapeHtml(item.name) + '</strong>' +
                '<span>' + escapeHtml(item.address) + '</span>' +
                '<div class="result-meta">' +
                  '<b>' + escapeHtml(rating) + '</b>' +
                  '<i>•</i>' +
                  '<b>' + escapeHtml(reviews) + '</b>' +
                '</div>' +
              '</div>' +
              '<button type="button" data-select="' + escapeHtml(item.id) + '">Questa è la mia attività <span>→</span></button>' +
            '</article>';
          }).join('');

          resultsSection.hidden = false;
          resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function setBenchmark(mine, median) {
          const mineValue = typeof mine === 'number' ? mine : 0;
          const medianValue = typeof median === 'number' ? median : 0;
          const max = Math.max(mineValue, medianValue, 1);

          document.getElementById('benchmark-you').textContent = typeof mine === 'number' ? formatNumber(mine) : '—';
          document.getElementById('selected-review-bar').style.width = Math.max(8, Math.round((mineValue / max) * 100)) + '%';
          document.getElementById('median-review-bar').style.width = Math.max(8, Math.round((medianValue / max) * 100)) + '%';
        }

        function selectBusiness(id) {
          if (!currentRun) return;
          selected = currentRun.results.find((item) => item.id === id);
          if (!selected) return;

          document.getElementById('selected-name').textContent = selected.name;
          document.getElementById('selected-address').textContent = selected.address;
          document.getElementById('selected-rating').textContent = formatRating(selected.rating);
          document.getElementById('selected-reviews').textContent = formatNumber(selected.reviews);
          document.getElementById('median-reviews').textContent = currentRun.medianReviews == null
            ? '—'
            : '~' + formatNumber(Math.round(currentRun.medianReviews));

          setBenchmark(selected.reviews, currentRun.medianReviews);

          document.getElementById('signal-phone').textContent = yesNo(selected.phonePresent);
          document.getElementById('signal-site').textContent = yesNo(selected.websitePresent);
          document.getElementById('signal-direct').textContent = yesNo(selected.directActionPresent);

          const strongRating = typeof selected.rating === 'number' && selected.rating >= 4.4;
          const reviewGap = typeof selected.reviews === 'number'
            && typeof currentRun.medianReviews === 'number'
            && selected.reviews < currentRun.medianReviews;

          const title = document.getElementById('verdict-title');
          const copy = document.getElementById('verdict-copy');

          if (strongRating && reviewGap) {
            title.innerHTML = 'SEI MEGLIO<br><em>DI COME APPARI.</em>';
            copy.textContent = 'Chi ti ha già scelto sembra apprezzarti. Ma prima della chiamata altri possono sembrare più scelti.';
          } else if (strongRating) {
            title.innerHTML = 'SEI GIÀ CREDIBILE.<br><em>FALLO PESARE.</em>';
            copy.textContent = 'Le prove ci sono. Il punto è renderle più facili da vedere nel momento della scelta.';
          } else {
            title.innerHTML = 'TI HO TROVATO.<br><em>ORA GUARDIAMO MEGLIO.</em>';
            copy.textContent = 'Ci sono abbastanza segnali per capire cosa incontra una persona prima di contattarti.';
          }

          selectedSection.hidden = false;
          verdictSection.hidden = false;
          selectedSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        async function search(category, city) {
          setLoading(true);
          resultsSection.hidden = true;
          selectedSection.hidden = true;
          verdictSection.hidden = true;

          try {
            const response = await fetch('/api/public-search', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ category, city }),
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'search_failed');
            if (!data.results?.length) throw new Error('no_results');
            renderResults(data);
          } catch {
            resultsList.innerHTML =
              '<div class="empty-state">' +
                '<div class="empty-icon">⌕</div>' +
                '<strong>Non ho trovato abbastanza.</strong>' +
                '<span>Prova una categoria più semplice o una città vicina.</span>' +
              '</div>';
            queryTitle.textContent = 'Nessun risultato utile';
            resultsSection.hidden = false;
            resultsSection.scrollIntoView({ behavior: 'smooth' });
          } finally {
            setLoading(false);
          }
        }

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const category = categoryInput.value.trim();
          const city = cityInput.value.trim();
          if (category.length < 2 || city.length < 2) return;
          search(category, city);
        });

        document.querySelectorAll('[data-example-category]').forEach((button) => {
          button.addEventListener('click', () => {
            categoryInput.value = button.dataset.exampleCategory || '';
            cityInput.value = button.dataset.exampleCity || '';
            search(categoryInput.value, cityInput.value);
          });
        });

        resultsList.addEventListener('click', (event) => {
          const button = event.target.closest('[data-select]');
          if (!button) return;
          selectBusiness(button.dataset.select);
        });

        checkButton.addEventListener('click', async () => {
          if (!currentRun || !selected) return;
          checkButton.disabled = true;
          checkButton.querySelector('span').textContent = 'Preparo il Check…';

          try {
            const response = await fetch('/api/public-check', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                runId: currentRun.runId,
                prospectId: selected.id,
              }),
            });
            const data = await response.json();
            if (!response.ok || !data.shareUrl) throw new Error(data.error || 'check_failed');
            window.location.href = data.shareUrl;
          } catch {
            checkButton.disabled = false;
            checkButton.querySelector('span').textContent = 'Riprova';
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  :root{
    --ink:#101216;
    --ink-2:#1a1d22;
    --paper:#f5f5ef;
    --surface:#ffffff;
    --surface-2:#f8f8f5;
    --line:#e4e5df;
    --muted:#6d7278;
    --yellow:#ffc400;
    --yellow-soft:#fff5bf;
    --blue:#246bfe;
    --green:#169b62;
    --shadow:0 24px 70px rgba(17,20,24,.10);
    --shadow-soft:0 10px 30px rgba(17,20,24,.07);
    --radius:24px;
  }

  *{box-sizing:border-box}
  html{scroll-behavior:smooth;background:var(--paper);overflow-x:hidden}
  body{
    margin:0;
    background:
      radial-gradient(circle at 80% 8%,rgba(255,196,0,.11),transparent 28rem),
      var(--paper);
    color:var(--ink);
    font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  button,input{font:inherit}
  button{cursor:pointer}
  [hidden]{display:none!important}
  .brand{display:inline-flex;align-items:center;gap:6px;text-decoration:none;color:var(--ink);font-weight:900;letter-spacing:-.04em}
  .brand b{color:#d79f00}.inverse{color:#fff}

  .site-header{
    position:sticky;top:0;z-index:60;
    min-height:68px;
    padding:0 clamp(18px,5vw,76px);
    display:flex;align-items:center;justify-content:space-between;gap:20px;
    background:rgba(245,245,239,.87);
    border-bottom:1px solid rgba(16,18,22,.07);
    backdrop-filter:blur(18px);
  }

  .header-status{display:flex;align-items:center;gap:8px;color:#777d83;font-size:.72rem;font-weight:700}
  .status-dot{width:8px;height:8px;border-radius:50%;background:#21a46b;box-shadow:0 0 0 5px rgba(33,164,107,.10)}

  .hero{
    width:min(1240px,calc(100% - 36px));
    margin:0 auto;
    min-height:calc(100svh - 68px);
    padding:clamp(60px,8vw,112px) 0;
    display:grid;
    grid-template-columns:minmax(0,1.08fr) minmax(380px,.92fr);
    gap:clamp(44px,7vw,96px);
    align-items:center;
  }

  .hero-kicker{
    display:inline-flex;
    margin-bottom:20px;
    padding:7px 10px;
    border:1px solid #dedfd9;
    border-radius:999px;
    background:rgba(255,255,255,.72);
    color:#7a6a29;
    font-size:.66rem;
    font-weight:900;
    letter-spacing:.11em;
  }

  .hero h1{
    max-width:11ch;
    margin:0;
    font-size:clamp(4.5rem,8vw,8.4rem);
    line-height:.86;
    letter-spacing:-.075em;
  }

  .hero h1 em{font-style:normal;color:#b88700}
  .hero-lede{max-width:730px;margin:28px 0 0;color:#535960;font-size:clamp(1.06rem,2vw,1.36rem);line-height:1.58}
  .hero-lede strong{color:var(--ink)}
  .trust-row{display:flex;flex-wrap:wrap;gap:9px;margin-top:26px}
  .trust-row span{padding:8px 11px;border-radius:999px;background:#fff;border:1px solid var(--line);color:#62686e;font-size:.72rem;font-weight:800}

  .search-panel{
    padding:28px;
    border:1px solid rgba(16,18,22,.08);
    border-radius:30px;
    background:rgba(255,255,255,.94);
    box-shadow:var(--shadow);
  }

  .panel-progress{display:flex;align-items:center;gap:8px;margin-bottom:26px}
  .step-badge{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#eff0ec;color:#959a9f;font-size:.68rem;font-weight:900}
  .step-badge.active{background:var(--ink);color:#fff}
  .step-line{flex:1;height:1px;background:#e1e2dd}
  .panel-copy small,.section-step small{display:block;color:#9a9fa4;font-size:.58rem;font-weight:900;letter-spacing:.11em}
  .panel-copy h2{margin:7px 0 5px;font-size:1.65rem;letter-spacing:-.04em}
  .panel-copy p{margin:0;color:#777c81;font-size:.9rem}

  .search-form{display:grid;gap:12px;margin-top:26px}
  .search-form label{display:grid;gap:7px}
  .search-form label>span{font-size:.58rem;font-weight:900;letter-spacing:.1em;color:#73787d}
  .input-shell{min-height:58px;padding:0 15px;display:flex;align-items:center;gap:11px;border:1px solid #dddfda;border-radius:15px;background:#fafbf8;transition:.18s ease}
  .input-shell:focus-within{border-color:#b79c3a;background:#fff;box-shadow:0 0 0 4px rgba(255,196,0,.10)}
  .input-shell i{font-style:normal;color:#969b9f;font-size:1.2rem}
  .input-shell input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);font-size:1rem;font-weight:700}

  .primary-button,.cta-button{
    min-height:58px;
    padding:0 18px;
    border:0;border-radius:15px;
    display:flex;align-items:center;justify-content:space-between;gap:18px;
    background:var(--ink);color:#fff;
    font-weight:900;
    transition:transform .16s ease,box-shadow .16s ease,background .16s ease;
  }
  .primary-button:hover,.cta-button:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(16,18,22,.16);background:#1b1e23}
  .primary-button:disabled,.cta-button:disabled{opacity:.55;cursor:wait;transform:none}

  .examples{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin-top:18px}
  .examples>span{font-size:.56rem;font-weight:900;letter-spacing:.08em;color:#a0a4a8}
  .examples button{padding:7px 10px;border:1px solid #e2e3de;border-radius:999px;background:#fff;color:#6c7176;font-size:.68rem;font-weight:750}

  .proof-strip{
    min-height:78px;
    padding:16px clamp(18px,6vw,92px);
    display:flex;align-items:center;justify-content:space-between;gap:24px;
    background:var(--ink);color:#fff;
  }
  .proof-strip strong,.proof-strip span{display:block}
  .proof-strip strong{font-size:.9rem}
  .proof-strip span,.proof-strip-note{margin-top:3px;color:#aeb2b7;font-size:.72rem}
  .proof-strip-note{text-align:right}

  .loading-state{padding:34px clamp(18px,6vw,92px);background:#fff}
  .loading-inner{width:min(1140px,100%);margin:auto;display:flex;align-items:center;gap:18px}
  .pulse-ring{position:relative;width:46px;height:46px;border-radius:50%;border:1px solid #ddd;display:grid;place-items:center}
  .pulse-ring::after{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--yellow);animation:pulse 1s ease-in-out infinite}
