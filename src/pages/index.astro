---
import { benefits, brand, pricingPlans } from '../data/site';
import '../styles/global.css';

const formatPrice = (plan: (typeof pricingPlans)[number]) => {
  if (plan.amount === 0) return 'Gratis';
  if (plan.amount == null) return 'Prezzo personalizzato';
  return new Intl.NumberFormat('it-IT', {
    style: 'currency',
    currency: plan.currency ?? 'EUR',
    maximumFractionDigits: 0,
  }).format(plan.amount);
};

const locationLabel = (max: number | null) => {
  if (max == null) return 'Sedi senza limite predefinito';
  if (max === 1) return 'Una singola sede';
  if (max <= 10) return `Fino a ${max} sedi`;
  return 'Gestione multi-sede avanzata';
};
---

