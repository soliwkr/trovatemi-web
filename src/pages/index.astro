---
export const prerender = true;

import '@fontsource-variable/archivo';
import '@fontsource/anton';
import '../styles/search-funnel.css';

const instagramUrl = 'https://www.instagram.com/trovatemi.it/';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta
      name="description"
      content="Cercati come ti cerca un cliente. Trovatemi ti mostra come appari rispetto alle alternative locali e cosa sistemare prima."
    />
    <link rel="canonical" href="https://trovatemi.it/" />
    <title>Trovatemi.it — Ti troveresti?</title>
  </head>

  <body>
    <div class="app" data-stage="landing">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Trovatemi.it home">
          <strong>TROVATEMI.IT</strong><i>★</i>
        </a>
        <div class="stage-label" id="stageLabel">Cercati come ti cerca un cliente</div>
        <button class="restart" id="restartTop" type="button" hidden>Ricomincia</button>
      </header>
      <div class="progress" aria-hidden="true"><i id="progressBar"></i></div>

      <main>
        <section class="stage" id="landing">
          <div class="shell">
            <div class="hero">
              <p class="eyebrow">FATTI TROVARE · FATTI SCEGLIERE · FATTI CONTATTARE</p>
              <h1>TI <em>TROVERESTI?</em></h1>
              <p class="hero-copy">
                Cerca la tua attività come farebbe una persona che non ti conosce ancora.
                Vediamo chi incontra prima di te, cosa vede e quali segnali possono spostare la scelta.
              </p>

              <form class="search-card" id="searchForm">
                <div class="search-grid">
                  <div class="field">
                    <label for="businessInput">Nome attività</label>
                    <input id="businessInput" name="business" placeholder="es. Studio Aurora" autocomplete="organization" required />
                  </div>
                  <div class="field">
                    <label for="categoryInput">Cosa fai</label>
                    <input id="categoryInput" name="category" placeholder="es. parrucchiere" required />
                  </div>
                  <div class="field">
                    <label for="cityInput">Dove</label>
                    <input id="cityInput" name="city" placeholder="es. Formia" autocomplete="address-level2" required />
                  </div>
                  <button class="primary" id="searchButton" type="submit">Cercami</button>
                </div>
              </form>

              <p class="micro">
                <strong>Nessuna registrazione.</strong>
                La ricerca live usa Google Places quando configurato. Vuoi solo vedere il percorso?
                <button class="text-button" id="demoButton" type="button">Guarda la demo</button>
              </p>

              <div class="value-pills" aria-label="Le tre domande del funnel">
                <span>🔎 Mi trovano?</span>
                <span>⭐ Mi scelgono?</span>
                <span>↗ Riescono a passare all'azione?</span>
              </div>

              <div class="candidates" id="candidatePanel" hidden>
                <div class="candidates-head">
                  <strong>Quale di queste sei tu?</strong>
                  <span>Conferma l'attività corretta prima del confronto locale.</span>
                </div>
                <div id="candidateList"></div>
              </div>

              <div class="search-error" id="searchError" role="alert" hidden>
                <strong id="searchErrorTitle">Non riesco a completare la ricerca.</strong>
                <p id="searchErrorText"></p>
                <button class="secondary" id="errorDemoButton" type="button">Apri comunque la demo</button>
              </div>
            </div>
          </div>
        </section>

        <section class="stage" id="loading" hidden>
          <div class="shell">
            <div class="loading">
              <div class="loader-box">
                <div class="radar" aria-hidden="true"><div class="sweep"></div></div>
                <h2>Ti sto cercando.</h2>
                <p id="loadingQuery">Come farebbe una persona che non ti conosce ancora.</p>
                <div class="loading-list">
                  <div class="loading-row"><span class="tick">✓</span><span>Confermo la tua attività</span></div>
                  <div class="loading-row"><span class="tick">✓</span><span>Guardo chi appare nella stessa ricerca locale</span></div>
                  <div class="loading-row"><span class="tick">✓</span><span>Confronto rating e volume recensioni</span></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="stage" id="results" hidden>
          <div class="shell">
            <header class="results-head">
              <p class="step-kicker">1 · FATTI TROVARE <span class="demo-badge" id="demoBadgeResults" hidden>DEMO</span></p>
              <h2 class="section-title">ECCO CHI INCONTRA PRIMA.</h2>
              <p>
                Non è un “voto SEO”. È una fotografia della ricerca che abbiamo appena fatto:
                stesso bisogno, stessa città, alternative reali quando il motore live è attivo.
              </p>
              <div class="query-pill">
                <span class="glass" aria-hidden="true"></span>
                <span id="contextQuery">parrucchiere Formia</span>
              </div>
              <div class="tabs" aria-hidden="true">
                <div class="tab active">Risultati locali</div>
                <div class="tab">Dati attività</div>
                <div class="tab">Confronto</div>
              </div>
            </header>

            <div class="results-layout">
              <div class="local-card" id="localResults" aria-live="polite"></div>

              <aside class="insight-card">
                <div class="label">La prima cosa che conta</div>
                <h3 id="verdict">Ti trovano. Adesso devi farti scegliere.</h3>
                <p id="verdictDetail"></p>
                <button class="primary full" id="toDecision" type="button">Ora scegli come un cliente</button>
                <div class="quote">“Non è SEO. <span>È una decisione.</span>”</div>
                <p class="source-note">
                  Dati live: Google Places API. L'ordine mostrato può differire da Google Search o Maps
                  per posizione, personalizzazione e altri fattori.
                </p>
              </aside>
            </div>
          </div>
        </section>

        <section class="stage" id="decision" hidden>
          <div class="shell">
            <div class="decision">
              <p class="step-kicker">2 · FATTI SCEGLIERE <span class="demo-badge" id="demoBadgeDecision" hidden>DEMO</span></p>
              <h2 class="decision-title">ADESSO SCEGLI SENZA CONOSCERE NESSUNO.</h2>
              <p class="decision-sub">
                Due attività, stesso bisogno. Non stiamo dicendo chi lavora meglio:
                stiamo guardando quali segnali pubblici rendono la decisione più facile.
              </p>

              <div class="versus">
                <article class="vcard leader">
                  <div class="vhead">
                    <strong id="leaderName">Alternativa locale</strong>
                    <span class="badge">Prima alternativa visibile</span>
                  </div>
                  <div class="metric"><span>Valutazione</span><b id="leaderRating">—</b></div>
                  <div class="metric"><span>Recensioni</span><b id="leaderReviews">—</b></div>
                  <div class="metric"><span>Categoria</span><b id="leaderCategory">—</b></div>
                </article>

                <article class="vcard">
                  <div class="vhead">
                    <strong id="businessNameDecision">La tua attività</strong>
                    <span class="badge">Tu</span>
                  </div>
                  <div class="metric"><span>Valutazione</span><b id="businessRating">—</b></div>
                  <div class="metric"><span>Recensioni</span><b id="businessReviews">—</b></div>
                  <div class="metric"><span>Posizione in questa ricerca</span><b id="businessRank">—</b></div>
                </article>
              </div>

              <div class="decision-statement">
                NON DEVI SEMBRARE “PIÙ DIGITALE”.<br />
                DEVI ESSERE <em>PIÙ FACILE DA SCEGLIERE.</em>
              </div>

              <div class="action-row">
                <button class="primary dark" id="toPrescription" type="button">Fammi vedere cosa sistemare</button>
                <button class="text-button" id="backToResults" type="button">Torna ai risultati</button>
              </div>
            </div>
          </div>
        </section>

        <section class="stage" id="prescription" hidden>
          <div class="shell">
            <div class="prescription">
              <div class="prescription-head">
                <div>
                  <p class="step-kicker">3 · LA PRESCRIZIONE <span class="demo-badge" id="demoBadgePrescription" hidden>DEMO</span></p>
                  <h2 class="section-title">LE PRIME 3 COSE CHE GUARDEREI.</h2>
                </div>
                <p>
                  Solo ciò che possiamo sostenere con i dati appena visti.
                  Foto, risposte, categorie, orari, sito, telefono e WhatsApp vengono poi verificati manualmente nella sistemazione.
                </p>
              </div>

              <div class="issue-list" id="issueList"></div>

              <div class="offer">
                <div class="offer-copy">
                  <p class="step-kicker">SISTEMAZIONE LOCALE</p>
                  <h2 class="offer-title">HAI VISTO IL PROBLEMA. ORA LO SISTEMIAMO.</h2>
                  <p>
                    Non ti vendo “SEO”. Prendo ciò che una persona vede prima di scegliere
                    e sistemo le cose che stanno rendendo la tua attività meno trovabile, meno credibile o più difficile da contattare.
                  </p>
                  <div class="offer-list">
                    <div class="offer-row"><span class="ok">✓</span><span>Revisione completa della presenza locale</span></div>
                    <div class="offer-row"><span class="ok">✓</span><span>Categorie, servizi, descrizione, orari e contatti</span></div>
                    <div class="offer-row"><span class="ok">✓</span><span>Foto, risposte e segnali di attività da riordinare</span></div>
                    <div class="offer-row"><span class="ok">✓</span><span>Percorso semplice per raccogliere più recensioni reali</span></div>
                    <div class="offer-row"><span class="ok">✓</span><span>Verifica chiamata / WhatsApp / sito e attriti evidenti</span></div>
                    <div class="offer-row"><span class="ok">✓</span><span>Prima / dopo + tre mosse successive</span></div>
                  </div>
                </div>

                <aside class="price-box">
                  <div class="price-cap">Una sola sistemazione. Nessun abbonamento.</div>
                  <div class="price">€197</div>
                  <p class="once">una tantum</p>
                  <a class="primary dark full" href={instagramUrl} target="_blank" rel="noreferrer">
                    Sistemamelo →
                  </a>
                  <button class="secondary full" id="restartBottom" type="button">Rifai il check</button>
                  <p class="fine">
                    Non promettiamo una posizione specifica su Google.
                    Il check serve a rendere visibili differenze concrete prima della scelta.
                  </p>
                </aside>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div><strong>TROVATEMI.IT ★</strong><br />Cercati come ti cerca un cliente.</div>
        <div>
          Trovatemi non è affiliato a Google. Quando il motore live è attivo, usa Google Places API
          come fonte dati. L'ordine restituito non equivale a una promessa di ranking su Google Search o Maps.
        </div>
      </footer>
    </div>

    <script is:inline type="module" src="/search-funnel.js"></script>
  </body>
</html>
