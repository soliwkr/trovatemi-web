---
import V5Layout from '../../layouts/V5Layout.astro';

export const prerender = true;

const included = [
  ['01', 'Richieste al momento giusto', 'Invia il link con WhatsApp o email, oppure fallo aprire con NFC e QR.'],
  ['02', 'Recensioni in un solo posto', 'Segui le nuove recensioni e non perdere quelle a cui devi ancora rispondere.'],
  ['03', 'Aiuto nelle risposte', 'Parti da una risposta preparata e mantieni sempre l’ultima parola prima di pubblicare.'],
  ['04', 'Contatore verificabile', 'Vedi quante recensioni avevi all’inizio e quante ne hai raccolte nel tempo.'],
];

const faqs = [
  ['TROVATEMI è un servizio di marketing?', 'No. Il prodotto di partenza serve a chiedere, raccogliere e gestire recensioni vere. È un’attività precisa, con un numero pubblico che puoi controllare anche dal tuo telefono.'],
  ['Il cliente deve scaricare un’app?', 'No. Tocca l’NFC, inquadra il QR oppure apre il link ricevuto. Da lì continua sul percorso Google.'],
  ['Mostrate il link Google soltanto ai clienti soddisfatti?', 'No. Tutti i clienti reali arrivano allo stesso link. Non filtriamo le persone in base al voto e non compriamo recensioni.'],
  ['Le risposte vengono pubblicate senza controllo?', 'La demo mostra un aiuto alla scrittura. Sei tu a leggere, modificare e approvare la risposta prima che venga usata.'],
  ['Chi mi aiuta a configurarlo?', 'Chris prepara con te il collegamento, i materiali e il primo utilizzo. Se chiami, risponde Chris.'],
];
---

<V5Layout
  title="TROVATEMI.IT — Più recensioni vere, senza rincorrerle"
  description="TROVATEMI aiuta le attività a chiedere, raccogliere e gestire recensioni Google in un unico prodotto."
>
  <section class="v5-hero">
    <div class="v5-hero-grid"></div>
    <div class="v5-wrap v5-hero-layout">
      <div class="v5-hero-copy v5-reveal">
        <p class="v5-kicker"><span>★</span> REVIEW MANAGEMENT PER ATTIVITÀ LOCALI</p>
        <h1>PIÙ RECENSIONI VERE. <em>SENZA RINCORRERLE.</em></h1>
        <p class="v5-lede">TROVATEMI ti aiuta a chiedere una recensione nel momento giusto, seguirla e rispondere da un unico posto.</p>
        <div class="v5-hero-actions">
          <button class="v5-button js-v5-open" type="button">Provalo sulla tua attività <span>↗</span></button>
          <a href="#come-funziona">Guarda come funziona <span>↓</span></a>
        </div>
        <ul class="v5-proof-list" aria-label="Caratteristiche principali">
          <li><i>✓</i> Nessuna app per il cliente</li>
          <li><i>✓</i> Tutti allo stesso link Google</li>
          <li><i>✓</i> Numeri controllabili</li>
        </ul>
      </div>

      <div class="v5-hero-product v5-reveal" aria-label="Anteprima del prodotto TROVATEMI">
        <div class="v5-window-top">
          <div><i></i><i></i><i></i></div>
          <span>Panoramica</span>
          <b>DEMO</b>
        </div>
        <div class="v5-mini-app">
          <aside>
            <div class="v5-mini-logo">T<i>★</i></div>
            <nav aria-label="Anteprima navigazione prodotto">
              <span class="active">⌂</span><span>☆</span><span>↗</span><span>⌁</span>
            </nav>
            <b>CF</b>
          </aside>
          <div class="v5-mini-main">
            <header>
              <div><small>BUONGIORNO</small><h2 data-demo-business>Attività Demo</h2></div>
              <button type="button">+ Chiedi una recensione</button>
            </header>
            <div class="v5-mini-stats">
              <article class="primary">
                <span>RECENSIONI GOOGLE</span>
                <div><strong data-demo-reviews>24</strong><i>+6 questo mese</i></div>
                <svg viewBox="0 0 340 88" preserveAspectRatio="none" aria-hidden="true">
                  <defs><linearGradient id="v5Area" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#6857ff" stop-opacity=".3"/><stop offset="1" stop-color="#6857ff" stop-opacity="0"/></linearGradient></defs>
                  <path class="area" d="M0 77 C35 73 53 69 79 70 S121 53 153 56 S202 38 229 43 S284 20 340 12 L340 88 L0 88Z" />
                  <path class="line" d="M0 77 C35 73 53 69 79 70 S121 53 153 56 S202 38 229 43 S284 20 340 12" />
                </svg>
              </article>
              <article><span>MEDIA</span><strong>4,8 <i>★</i></strong><small>su Google</small></article>
              <article><span>DA RISPONDERE</span><strong>2</strong><small>recensioni</small></article>
            </div>
            <div class="v5-mini-bottom">
              <article>
                <header><span>ULTIME RECENSIONI</span><b>Vedi tutte</b></header>
                <div><i class="v5-avatar">MG</i><p><b>Maria G.</b><small>★★★★★</small></p><span>2 min</span></div>
                <div><i class="v5-avatar alt">LP</i><p><b>Luca P.</b><small>★★★★★</small></p><span>ieri</span></div>
              </article>
              <article class="v5-quick-request">
                <span>CHIEDI ADESSO</span>
                <div><button type="button">⌁<small>NFC</small></button><button type="button">▦<small>QR</small></button><button type="button">↗<small>LINK</small></button></div>
              </article>
            </div>
          </div>
        </div>
        <div class="v5-new-review"><i>★</i><p><b>Nuova recensione ricevuta</b><small>Il contatore è appena cresciuto.</small></p><span>ora</span></div>
      </div>
    </div>
    <div class="v5-wrap v5-hero-note">
      <span>IL PRODOTTO FA UNA COSA PRECISA.</span>
      <strong>TRASFORMA IL MOMENTO GIUSTO IN UNA RECENSIONE.</strong>
    </div>
  </section>

  <section id="come-funziona" class="v5-section v5-how">
    <div class="v5-wrap v5-section-heading v5-reveal">
      <span>COME FUNZIONA</span>
      <div><h2>DAL CLIENTE SODDISFATTO<br />A GOOGLE. <em>SENZA GIRI.</em></h2><p>Non è una campagna e non è un pacchetto di attività. È sempre lo stesso percorso, ripetuto bene.</p></div>
    </div>

    <div class="v5-wrap v5-how-grid v5-reveal">
      <article><span>01</span><div>⌁</div><h3>Chiedi</h3><p>Subito dopo il servizio, di persona o con un messaggio.</p></article>
      <i>→</i>
      <article><span>02</span><div>G</div><h3>Il cliente apre Google</h3><p>Un solo percorso, uguale per ogni cliente reale.</p></article>
      <i>→</i>
      <article><span>03</span><div>★</div><h3>Gestisci</h3><p>La recensione e la risposta restano sotto controllo.</p></article>
    </div>
  </section>

  <section id="product-demo" class="v5-section v5-demo-section">
    <div class="v5-wrap v5-demo-layout">
      <div class="v5-demo-copy v5-reveal">
        <span>PROVALO ADESSO</span>
        <h2>UN TOCCO.<br />UN PERCORSO.<br /><em>UN NUMERO IN PIÙ.</em></h2>
        <p>Questa simulazione mostra esattamente il pezzo di lavoro che TROVATEMI rende semplice. Non si collega a Google e non invia messaggi reali.</p>
        <button class="v5-demo-run" type="button">Simula il percorso</button>
        <small><i></i> DEMO LOCALE · NESSUN DATO INVIATO</small>
      </div>

      <div class="v5-live-demo v5-reveal" data-state="idle">
        <div class="v5-live-status"><span>DEMO PRODOTTO</span><b><i></i> PRONTA</b></div>
        <div class="v5-live-flow">
          <article class="request">
            <span>1 · RICHIESTA</span>
            <div class="v5-nfc-object"><i></i><b>★</b><small>TROVATEMI</small></div>
            <h3>Il cliente tocca.</h3>
            <p>NFC, QR o link: cambia il mezzo, non il percorso.</p>
            <em>Richiesta aperta ✓</em>
          </article>
          <article class="phone">
            <div class="v5-phone-notch"></div>
            <span data-demo-business>Attività Demo</span>
            <div class="v5-google-mark">G</div>
            <h3>Com’è stata la tua esperienza?</h3>
            <div class="v5-stars">★★★★★</div>
            <button type="button">Scrivi su Google</button>
            <em>Recensione completata ✓</em>
          </article>
          <article class="counter">
            <span>3 · PRODOTTO</span>
            <div><small>RECENSIONI GOOGLE</small><strong data-demo-reviews>24</strong><b><i>+1</i> ricevuta adesso</b></div>
            <h3>Tu la vedi arrivare.</h3>
            <p>Il contatore passa a <b data-demo-next>25</b>. Questa è la prova.</p>
            <em>Dashboard aggiornata ✓</em>
          </article>
        </div>
        <div class="v5-live-progress"><i></i><i></i><i></i></div>
      </div>
    </div>
  </section>

  <section id="prodotto" class="v5-section v5-product-section">
    <div class="v5-wrap v5-product-heading v5-reveal">
      <span>IL PRODOTTO</span>
      <h2>TUTTO CIÒ CHE SERVE ALLE RECENSIONI. <em>NIENTE CHE TI DISTRAGGA.</em></h2>
    </div>

    <div class="v5-wrap v5-included-grid v5-reveal">
      {included.map(([number, title, text]) => (
        <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>

    <div class="v5-wrap v5-product-window v5-reveal">
      <div class="v5-window-top dark">
        <div><i></i><i></i><i></i></div>
        <span>TROVATEMI · <b data-demo-business>Attività Demo</b></span>
        <em>DATI DEMO</em>
      </div>
      <div class="v5-product-app">
        <aside>
          <div class="v5-product-brand">T<i>★</i></div>
          <nav aria-label="Sezioni del prodotto">
            <button class="active" type="button" data-product-tab="overview" role="tab" aria-selected="true"><i>⌂</i><span>Panoramica</span></button>
            <button type="button" data-product-tab="requests" role="tab" aria-selected="false"><i>↗</i><span>Richieste</span></button>
            <button type="button" data-product-tab="reviews" role="tab" aria-selected="false"><i>☆</i><span>Recensioni</span></button>
          </nav>
          <div><b>CF</b><p><span>Chris</span><small>Supporto</small></p></div>
        </aside>
        <div class="v5-product-body">
          <div class="v5-product-mobile-tabs" role="tablist" aria-label="Sezioni del prodotto">
            <button class="active" type="button" data-product-tab="overview" aria-selected="true">Panoramica</button>
            <button type="button" data-product-tab="requests" aria-selected="false">Richieste</button>
            <button type="button" data-product-tab="reviews" aria-selected="false">Recensioni</button>
          </div>

          <section class="v5-product-panel active" data-product-panel="overview">
            <header><div><small>PANORAMICA</small><h3>Buongiorno, <span data-demo-business>Attività Demo</span>.</h3><p>Ecco cosa è successo alle tue recensioni.</p></div><button type="button">+ Nuova richiesta</button></header>
            <div class="v5-overview-stats">
              <article><span>RECENSIONI TOTALI</span><strong data-demo-reviews>24</strong><small><i>↑</i> 6 negli ultimi 30 giorni</small></article>
              <article><span>MEDIA GOOGLE</span><strong>4,8 <i>★</i></strong><small>Aggiornata oggi</small></article>
              <article><span>DA RISPONDERE</span><strong>2</strong><small>Apri le recensioni</small></article>
            </div>
            <div class="v5-overview-lower">
              <article class="v5-big-chart">
                <header><span>CRESCITA DEL CONTATORE</span><b>ULTIMI 90 GIORNI</b></header>
                <svg viewBox="0 0 640 210" preserveAspectRatio="none" aria-hidden="true">
                  <defs><linearGradient id="v5BigArea" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#6857ff" stop-opacity=".25"/><stop offset="1" stop-color="#6857ff" stop-opacity="0"/></linearGradient></defs>
                  <path class="area" d="M0 184 C58 179 80 162 129 166 S215 140 264 141 S345 109 399 118 S495 65 543 75 S603 35 640 28 L640 210 L0 210Z"/>
                  <path class="line" d="M0 184 C58 179 80 162 129 166 S215 140 264 141 S345 109 399 118 S495 65 543 75 S603 35 640 28"/>
                </svg>
                <footer><span>APR</span><span>MAG</span><span>GIU</span><span>OGGI</span></footer>
              </article>
              <article class="v5-today-list"><header><span>OGGI</span><b>LIVE</b></header><div><i>★</i><p><b>Nuova recensione</b><small>Maria G. · 5 stelle</small></p><span>10:42</span></div><div><i>↗</i><p><b>Richiesta aperta</b><small>Link diretto</small></p><span>09:18</span></div><div><i>✓</i><p><b>Risposta approvata</b><small>Luca P.</small></p><span>08:54</span></div></article>
            </div>
          </section>

          <section class="v5-product-panel" data-product-panel="requests">
            <header><div><small>RICHIESTE</small><h3>Chiedi senza improvvisare.</h3><p>Scegli il canale. Il cliente arriva sempre allo stesso percorso.</p></div><button type="button">+ Nuova richiesta</button></header>
            <div class="v5-request-builder">
              <article><span>NUOVA RICHIESTA</span><label>Nome del cliente<input type="text" value="Marco" readonly /></label><label>Canale</label><div><button class="active" type="button">WhatsApp</button><button type="button">Email</button><button type="button">Copia link</button></div><button type="button">Prepara richiesta →</button><small>Simulazione: nessun messaggio verrà inviato.</small></article>
              <article><header><span>MATERIALI IN LOCO</span><b>PRONTI</b></header><div class="v5-material"><i>⌁</i><p><b>NFC</b><small>Avvicina il telefono</small></p><span>ATTIVO</span></div><div class="v5-material"><i>▦</i><p><b>Codice QR</b><small>Stesso percorso Google</small></p><span>SCARICA</span></div><footer>Tutti i clienti reali vedono lo stesso link.</footer></article>
            </div>
          </section>

          <section class="v5-product-panel" data-product-panel="reviews">
            <header><div><small>RECENSIONI</small><h3>Leggi. Rispondi. Continua.</h3><p>Tutto il lavoro sulle recensioni resta in una schermata.</p></div><button type="button">Filtra ▾</button></header>
            <div class="v5-review-list">
              <article class="v5-review-row">
                <div class="v5-review-person"><i>MG</i><p><b>Maria G.</b><span>★★★★★</span><small>2 minuti fa · Google</small></p></div>
                <blockquote>“Servizio chiarissimo e molto più semplice di quanto pensassi. Mi sono sentita seguita dall’inizio alla fine.”</blockquote>
                <div class="v5-review-actions"><span>RISPOSTA MANCANTE</span><button class="v5-response-button" type="button">Aiutami a rispondere</button></div>
                <div class="v5-response-draft"><span>BOZZA DA CONTROLLARE</span><p>Grazie Maria. La chiarezza è parte del modo in cui vogliamo accompagnare ogni cliente, dall’inizio alla fine.</p><div><button type="button">Modifica</button><button type="button">Approva risposta</button></div></div>
              </article>
              <article class="v5-review-row compact"><div class="v5-review-person"><i class="alt">LP</i><p><b>Luca P.</b><span>★★★★★</span><small>ieri · Google</small></p></div><blockquote>“Veloci, disponibili e precisi.”</blockquote><div class="v5-review-actions done"><span>✓ RISPOSTA PUBBLICATA</span></div></article>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section class="v5-section v5-promise">
    <div class="v5-promise-star">★</div>
    <div class="v5-wrap v5-promise-inner v5-reveal">
      <span>PERCHÉ CONTA</span>
      <h2>NON DEVI DIVENTARE VIRALE.<br /><em>DEVI DIVENTARE INEVITABILE.</em></h2>
      <div><p>Quando qualcuno ti cerca, confronta ciò che trova. Le recensioni vere non sono “contenuti”: sono persone che stanno già spiegando perché scegliere te.</p><strong>IL CLIENTE TI STA GIÀ CERCANDO.<br />IL PROBLEMA È CHE TROVA UN ALTRO.</strong></div>
    </div>
  </section>

  <section id="prezzo" class="v5-section v5-price-section">
    <div class="v5-wrap v5-price-layout">
      <div class="v5-price-copy v5-reveal">
        <span>UN PRODOTTO. UNA CIFRA.</span>
        <h2>PARTI DAL NUMERO CHE TUTTI POSSONO <em>CONTROLLARE.</em></h2>
        <p>Niente pacchetti vaghi. Si parte dalle recensioni: le chiedi meglio, le gestisci da un solo posto e misuri il contatore pubblico.</p>
      </div>
      <article class="v5-price-card v5-reveal">
        <header><span>★ TROVATO</span><b>PRODOTTO COMPLETO</b></header>
        <div class="v5-price"><strong>€100</strong><span>/ mese</span></div>
        <p>€250 di configurazione iniziale · disdetta libera</p>
        <ul><li>Richieste recensione</li><li>NFC e QR collegati</li><li>Pannello recensioni</li><li>Aiuto nelle risposte</li><li>Contatore verificabile</li></ul>
        <button class="v5-button js-v5-open" type="button">Vedi la demo sulla tua attività <span>↗</span></button>
        <small>La demo non attiva abbonamenti e non raccoglie dati.</small>
      </article>
    </div>
  </section>

  <section id="chris" class="v5-section v5-chris-section">
    <div class="v5-wrap v5-chris-card v5-reveal">
      <div class="v5-chris-mark"><span>C</span><i>★</i></div>
      <div><span>UNA PERSONA VERA, PRIMA E DOPO IL SOFTWARE</span><h2>SE CHIAMI,<br /><em>RISPONDE CHRIS.</em></h2></div>
      <p>Ti mostra il prodotto sulla tua attività, prepara il primo percorso e resta il riferimento quando serve. Niente rimbalzi tra reparti.</p>
      <button class="v5-button js-v5-open" type="button">Prepara la demo <span>↗</span></button>
    </div>
  </section>

  <section class="v5-section v5-faq-section">
    <div class="v5-wrap v5-faq-layout">
      <div class="v5-faq-heading v5-reveal"><span>DOMANDE DIRETTE</span><h2>NIENTE ZONE <em>GRIGIE.</em></h2></div>
      <div class="v5-faqs v5-reveal">
        {faqs.map(([question, answer], index) => (
          <details open={index === 0}><summary><span>0{index + 1}</span>{question}<i>+</i></summary><p>{answer}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="v5-final">
    <div class="v5-final-grid"></div>
    <div class="v5-wrap v5-final-inner v5-reveal">
      <span>IL PROSSIMO NUMERO È QUELLO CHE CONTA.</span>
      <h2>FAI ARRIVARE LA<br /><em>PROSSIMA RECENSIONE.</em></h2>
      <button class="v5-button js-v5-open" type="button">Provalo sulla tua attività <span>↗</span></button>
      <small>Demo simulata · nessuna integrazione · nessun dato inviato</small>
    </div>
  </section>
</V5Layout>
