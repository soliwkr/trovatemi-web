---
import type { ClimboDemo } from '../../data/climbo-demos';

type Props = {
  demo: ClimboDemo;
  compact?: boolean;
  linkPrefix?: '/demo' | '/per' | '/link';
};

const { demo, compact = false, linkPrefix = '/demo' } = Astro.props;
const href = `${linkPrefix}/${demo.id}/`;
---

<article
  class:list={['v13-demo-card', compact && 'v13-demo-card--compact']}
  style={`--demo-accent:${demo.accent};--demo-accent-soft:${demo.accentSoft}`}
>
  <div class="v13-demo-card__top">
    <span>{demo.icon}</span>
    <small>{demo.sector}</small>
    <i aria-hidden="true">↗</i>
  </div>
  <div>
    <h2 class={compact ? 'v13-h3' : undefined}>{demo.name}</h2>
    {!compact && <p>{demo.summary}</p>}
  </div>
  {!compact && <ul>{demo.features.map((feature) => <li>{feature}</li>)}</ul>}
  <a href={href} aria-label={`Apri la demo ${demo.name}`}><span>{linkPrefix === '/link' ? 'Apri la biolink' : linkPrefix === '/per' ? 'Vedi il caso' : 'Entra nel pannello'}</span><b>→</b></a>
</article>

