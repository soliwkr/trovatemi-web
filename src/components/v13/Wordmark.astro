  class?: string;
};

const { href = '/brand-demo-v13/', compact = false, class: className = '' } = Astro.props;
---

<a class:list={['v13-wordmark', compact && 'v13-wordmark--compact', className]} href={href} aria-label="Trovatemi.it, homepage V13">
  <span aria-hidden="true">★</span>
  <strong>TROVΛTEMI</strong>
</a>

