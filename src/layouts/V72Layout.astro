---
import '@fontsource/anton/latin.css';
import '@fontsource-variable/archivo';
import '@fontsource-variable/space-grotesk';
import '../styles/v72.css';
import Wordmark from '../components/v72/Wordmark.astro';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const isPreview = Astro.url.pathname.startsWith('/brand-demo-v7-2');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Trovatemi.it',
  url: 'https://trovatemi.it/',
  description,
  areaServed: 'IT',
  knowsAbout: [
    'Raccolta recensioni',
    'Reputazione locale',
    'Presenza Google per attività locali',
  ],
};
---

<!doctype html>
<html lang="it" data-theme="trovatemi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12161B" />
    <meta name="description" content={description} />
    {isPreview ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://trovatemi.it/" />
      </>
    )}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-primary focus:px-4 focus:py-3 focus:font-bold" href="#contenuto">Vai al contenuto</a>

    <div class="bg-primary text-primary-content">
      <div class="brand-wrap type-micro flex min-h-8 items-center justify-between gap-3 text-[0.62rem] sm:text-[0.68rem]">
        {isPreview ? (
          <>
            <span>V7.2 · BRANDSHEET EDITION</span>
            <span>Preview privata · nessun dato inviato</span>
          </>
        ) : (
          <>
            <span>PROVA ASSISTITA · 14 GIORNI</span>
            <span>SULLA TUA ATTIVITÀ · CON CLIENTI REALI</span>
          </>
        )}
      </div>
    </div>

    <header class="sticky top-0 z-50 border-b-2 border-ink bg-paper/95 backdrop-blur" data-header>
      <div class="brand-wrap">
        <nav class="navbar min-h-20 px-0" aria-label="Navigazione principale">
          <div class="navbar-start">
            <Wordmark />
          </div>

          <div class="navbar-center hidden lg:flex">
            <ul class="menu menu-horizontal gap-1 p-0 font-metric text-xs font-bold tracking-[0.06em] uppercase">
              <li><a href="#problema">Il problema</a></li>
              <li><a href="#come-funziona">Come funziona</a></li>
              <li><a href="#trial">14 giorni</a></li>
              <li><a href="#piani">I piani</a></li>
            </ul>
          </div>

          <div class="navbar-end gap-2">
            <button class="btn btn-primary brand-btn hidden xl:inline-flex" type="button" data-audit-open>
              Guarda la mia attività <span aria-hidden="true">↗</span>
            </button>

            <div class="dropdown dropdown-end lg:hidden">
              <button class="btn btn-square btn-neutral" type="button" aria-label="Apri il menu" aria-expanded="false" data-menu-button>
                <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 17h18" /></svg>
              </button>
              <ul class="menu dropdown-content z-[60] mt-3 w-72 border-2 border-ink bg-paper p-3 shadow-[6px_6px_0_#12161B]" data-mobile-menu>
                <li><a href="#problema">Il problema</a></li>
                <li><a href="#come-funziona">Come funziona</a></li>
                <li><a href="#trial">14 giorni</a></li>
                <li><a href="#piani">I piani</a></li>
                <li class="mt-2"><button class="btn btn-primary brand-btn" type="button" data-audit-open>Guarda la mia attività ↗</button></li>
              </ul>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <main id="contenuto"><slot /></main>

    <footer class="border-t-2 border-paper/20 bg-ink py-14 text-paper">
      <div class="brand-wrap grid gap-12 md:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <Wordmark class="text-paper" />
          <p class="type-body-sm mt-5 max-w-[42ch] text-paper/65">Recensioni e presenza pubblica per attività locali che lavorano bene.</p>
        </div>
        <div class="grid content-start gap-3 text-sm">
          <span class="type-micro text-primary">Il percorso</span>
          <a class="link-hover link" href="#problema">Guarda il problema</a>
          <a class="link-hover link" href="#trial">Prova 14 giorni</a>
          <a class="link-hover link" href="#piani">Confronta i piani</a>
        </div>
        <div class="grid content-start gap-3 text-sm">
          <span class="type-micro text-primary">Le regole</span>
          <a class="link-hover link" href="#faq">Niente posizioni garantite</a>
          <a class="link-hover link" href="#faq">Niente recensioni filtrate</a>
          <button class="w-fit cursor-pointer underline-offset-4 hover:underline" type="button" data-audit-open>Parla con Chris</button>
        </div>
      </div>
      <div class="brand-wrap type-micro mt-14 flex flex-col gap-3 border-t border-paper/20 pt-5 sm:flex-row sm:items-center sm:justify-between">
        <span>© 2026 Trovatemi.it</span>
        <strong class="text-primary">Se chiami, risponde Chris.</strong>
        <span>{isPreview ? 'V7.2 · Noindex' : 'trovatemi.it'}</span>
      </div>
    </footer>

    <dialog class="modal" aria-labelledby="audit-title" data-audit-dialog>
      <div class="modal-box max-h-[92dvh] w-[min(94vw,72rem)] max-w-none overflow-y-auto border-2 border-ink bg-paper p-0 shadow-[10px_10px_0_#F5B301]">
        <form method="dialog" class="sticky top-0 z-10 flex justify-end bg-transparent p-3 pb-0">
          <button class="btn btn-square btn-neutral" aria-label="Chiudi">×</button>
        </form>

        <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
          <div class="bg-ink p-7 text-paper sm:p-10 lg:p-12">
            <span class="section-kicker text-primary">Prima guardiamo. Poi parliamo.</span>
            <h2 id="audit-title" class="type-modal-title mt-7">Cosa trova oggi un cliente?</h2>
            <p class="type-body mt-7 max-w-[48ch] text-paper/75">Chris apre il tuo profilo come farebbe una persona che non ti conosce. Guarda le prove, il confronto e i punti che meritano attenzione.</p>
            <blockquote class="type-emphasis mt-8 border-l-4 border-primary pl-5">Non partiamo da una presentazione. Partiamo da quello che vede il cliente.</blockquote>
            <small class="type-micro mt-10 flex items-center gap-2"><i class="size-2 bg-primary"></i> {isPreview ? 'Questa preview non invia né conserva dati' : 'Questo modulo prepara la richiesta sul dispositivo: non invia né conserva dati'}</small>
          </div>

          <form class="p-7 sm:p-10 lg:p-12" data-audit-form>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="fieldset"><span class="fieldset-legend font-metric font-bold uppercase">Nome</span><input class="input input-bordered w-full border-ink bg-white" name="name" type="text" autocomplete="name" placeholder="Il tuo nome" required /></label>
              <label class="fieldset"><span class="fieldset-legend font-metric font-bold uppercase">Attività</span><input class="input input-bordered w-full border-ink bg-white" name="business" type="text" autocomplete="organization" placeholder="Nome dell’attività" required /></label>
              <label class="fieldset"><span class="fieldset-legend font-metric font-bold uppercase">Città</span><input class="input input-bordered w-full border-ink bg-white" name="city" type="text" autocomplete="address-level2" placeholder="Dove lavori" required /></label>
              <label class="fieldset"><span class="fieldset-legend font-metric font-bold uppercase">Categoria</span><input class="input input-bordered w-full border-ink bg-white" name="category" type="text" placeholder="Es. dentista, ristorante" required /></label>
            </div>
            <label class="fieldset mt-5"><span class="fieldset-legend font-metric font-bold uppercase">Telefono o WhatsApp</span><input class="input input-bordered w-full border-ink bg-white" name="contact" type="tel" autocomplete="tel" placeholder="Il numero su cui ricontattarti" required /></label>
            <label class="fieldset mt-5"><span class="fieldset-legend font-metric font-bold uppercase">Link del profilo Google <small class="font-normal normal-case">facoltativo</small></span><input class="input input-bordered w-full border-ink bg-white" name="google" type="url" inputmode="url" placeholder="https://maps.google.com/..." /></label>
            <button class="btn btn-primary brand-btn mt-7 w-full" type="submit">Analizza la mia attività <span>→</span></button>
            <p class="mt-3 text-center text-xs text-ink/60">Nessuna promessa di primo posto. Guardiamo la situazione reale.</p>

            <div class="mt-7 border-2 border-ink bg-primary p-6" aria-live="polite" data-audit-result hidden>
              <span class="type-micro">Richiesta preparata</span>
              <h3 class="type-card-title mt-3">Chris guarderà il profilo e ti ricontatterà per mostrarti cosa vede oggi un cliente.</h3>
              <p class="type-body-sm mt-3"></p>
              <button class="btn btn-neutral brand-btn mt-5" type="button" data-copy-request>Copia la richiesta</button>
            </div>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>Chiudi</button></form>
    </dialog>

    <dialog class="modal" aria-labelledby="demo-title" data-demo-dialog>
      <div class="modal-box max-h-[92dvh] w-[min(94vw,72rem)] max-w-none overflow-y-auto border-2 border-ink bg-paper p-0 shadow-[10px_10px_0_#F5B301]">
        <form method="dialog" class="sticky top-0 z-20 flex justify-end bg-transparent p-3 pb-0"><button class="btn btn-square btn-neutral" aria-label="Chiudi">×</button></form>
        <div class="px-6 pb-8 sm:px-10 sm:pb-10">
          <span class="section-kicker">Dimostrazione · meno di 60 secondi</span>
          <h2 id="demo-title" class="type-modal-title mt-6">Dal “grazie” alla recensione.</h2>
          <p class="type-body-sm mt-4 max-w-[68ch] text-ink/70">Questa è una simulazione del percorso. Nessun messaggio viene inviato e nessuna recensione viene pubblicata.</p>

          <div class="mt-8 grid gap-8 border-y-2 border-ink py-8 lg:grid-cols-[1fr_0.72fr] lg:items-center">
            <figure class="relative hidden overflow-hidden bg-ink lg:block">
              <img class="aspect-[4/3] w-full object-cover" src="/images/nfc-review-counter-v7.webp" width="1536" height="1024" alt="Cliente che avvicina il telefono a un supporto NFC sul bancone" />
              <figcaption class="type-micro absolute right-0 bottom-0 bg-primary px-4 py-3">Esempio illustrativo</figcaption>
            </figure>

            <div class="demo-phone mx-auto w-full max-w-sm border-2 border-ink bg-white shadow-[7px_7px_0_#12161B]" data-demo-step="1">
              <div class="flex items-center justify-between border-b-2 border-ink bg-ink px-4 py-3 text-paper"><i class="size-2 bg-primary"></i><span class="type-micro normal-case">trovatemi.it</span><b class="size-2 bg-paper"></b></div>
              <section class="min-h-80 flex-col justify-center p-7" data-demo-panel="1"><small class="type-micro text-ink/55">01 · Il momento giusto</small><strong class="type-phone-title mt-6">Grazie per essere passato.</strong><p class="type-body-sm mt-3 text-ink/65">Ti va di raccontare com’è andata?</p><button class="btn btn-primary brand-btn mt-8" type="button" data-demo-next="2">Apri il percorso</button></section>
              <section class="min-h-80 flex-col justify-center p-7" data-demo-panel="2"><small class="type-micro text-ink/55">02 · Stesso percorso per tutti</small><strong class="type-phone-title mt-6">Com’è stata la tua esperienza?</strong><div class="review-stars mt-6 text-3xl">★★★★★</div><p class="type-body-sm mt-4 text-ink/65">La tua opinione resta tua. Nessun filtro sul voto.</p></section>
              <section class="min-h-80 flex-col justify-center p-7" data-demo-panel="3"><small class="type-micro text-ink/55">03 · Su Google</small><strong class="type-phone-title mt-6">Racconta la tua esperienza</strong><textarea class="textarea textarea-bordered mt-5 min-h-28 w-full border-ink bg-paper" readonly aria-label="Esempio di testo recensione">Servizio preciso e persone disponibili. Tornerei volentieri.</textarea><button class="btn btn-primary brand-btn mt-5" type="button" data-demo-next="4">Continua su Google</button></section>
              <section class="min-h-80 flex-col items-start justify-center p-7" data-demo-panel="4"><small class="type-micro text-ink/55">04 · Il titolare vede</small><strong class="type-phone-title mt-6">Nuova recensione pubblica</strong><p class="type-body-sm mt-4 text-ink/65">Ora puoi leggerla, rispondere e misurare l’output.</p><i class="mt-7 grid size-14 place-items-center bg-primary text-3xl font-bold not-italic">✓</i></section>
            </div>
          </div>

          <div class="mt-7 flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
            <div class="join grid grid-cols-4" role="group" aria-label="Passaggi della dimostrazione">
              <button class="btn join-item demo-control btn-active px-3 text-xs sm:px-5" type="button" data-demo-control="1" aria-pressed="true">1 · Chiedi</button>
              <button class="btn join-item demo-control px-3 text-xs sm:px-5" type="button" data-demo-control="2" aria-pressed="false">2 · Apre</button>
              <button class="btn join-item demo-control px-3 text-xs sm:px-5" type="button" data-demo-control="3" aria-pressed="false">3 · Scrive</button>
              <button class="btn join-item demo-control px-3 text-xs sm:px-5" type="button" data-demo-control="4" aria-pressed="false">4 · Gestisci</button>
            </div>
            <button class="btn btn-primary brand-btn" type="button" data-audit-from-demo>Fallo sulla mia attività <span>↗</span></button>
          </div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>Chiudi</button></form>
    </dialog>

    <script is:inline>
      const auditDialog = document.querySelector('[data-audit-dialog]');
      const demoDialog = document.querySelector('[data-demo-dialog]');
      const menuButton = document.querySelector('[data-menu-button]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');

      document.querySelectorAll('[data-audit-open]').forEach((button) => button.addEventListener('click', () => {
        mobileMenu?.classList.remove('dropdown-open');
        menuButton?.setAttribute('aria-expanded', 'false');
        auditDialog?.showModal();
      }));
      mobileMenu?.querySelectorAll('a[href^="#"]').forEach((link) => link.addEventListener('click', () => {
        requestAnimationFrame(() => {
          if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
          menuButton?.setAttribute('aria-expanded', 'false');
        });
      }));
      document.querySelectorAll('[data-demo-open]').forEach((button) => button.addEventListener('click', () => demoDialog?.showModal()));
      document.querySelector('[data-audit-from-demo]')?.addEventListener('click', () => {
        demoDialog?.close();
        auditDialog?.showModal();
      });

      const demoPhone = document.querySelector('.demo-phone');
      const setDemoStep = (step) => {
        demoPhone?.setAttribute('data-demo-step', step);
        document.querySelectorAll('[data-demo-control]').forEach((button) => {
          const active = button.getAttribute('data-demo-control') === step;
          button.classList.toggle('btn-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
      };
      document.querySelectorAll('[data-demo-control]').forEach((button) => button.addEventListener('click', () => setDemoStep(button.getAttribute('data-demo-control') || '1')));
      document.querySelectorAll('[data-demo-next]').forEach((button) => button.addEventListener('click', () => setDemoStep(button.getAttribute('data-demo-next') || '1')));

      const form = document.querySelector('[data-audit-form]');
      const result = document.querySelector('[data-audit-result]');
      const resultText = result?.querySelector('p');
      let requestMessage = '';

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        requestMessage = `Ciao Chris, sono ${data.get('name')} di ${data.get('business')}, ${data.get('category')} a ${data.get('city')}. Puoi guardare cosa trova oggi un cliente? Puoi ricontattarmi al ${data.get('contact')}.${data.get('google') ? ` Profilo Google: ${data.get('google')}` : ''}`;
        if (resultText) resultText.textContent = requestMessage;
        if (result) result.hidden = false;
        window.dispatchEvent(new CustomEvent('trovatemi:audit-prepared', { detail: Object.fromEntries(data.entries()) }));
      });

      document.querySelector('[data-copy-request]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget;
        try {
          await navigator.clipboard.writeText(requestMessage);
          button.textContent = 'Richiesta copiata ✓';
        } catch {
          button.textContent = 'Seleziona e copia il testo';
        }
      });

      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }), { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll('.reveal').forEach((element) => element.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
