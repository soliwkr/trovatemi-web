---
import '../styles/v5.css';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="v5-preview" role="note">
      <span>V5 · PRODUCT DEMO</span>
      <span>SIMULAZIONE INTERATTIVA</span>
      <span>NESSUN DATO VIENE INVIATO</span>
    </div>

    <header class="v5-header">
      <nav class="v5-wrap v5-nav" aria-label="Navigazione principale">
        <a class="v5-logo" href="/brand-demo-v5/" aria-label="TROVATEMI.IT, torna alla home">
          TROVATEM<span>I<i>★</i></span>.IT
        </a>
        <div class="v5-navlinks">
          <a href="#come-funziona">Come funziona</a>
          <a href="#prodotto">Il prodotto</a>
          <a href="#prezzo">Prezzo</a>
        </div>
        <button class="v5-button v5-button-small js-v5-open" type="button">
          Provalo sulla tua attività <span>↗</span>
        </button>
        <button class="v5-menu" type="button" aria-label="Apri il menu" aria-expanded="false">
          <span></span><span></span>
        </button>
      </nav>
      <div class="v5-mobile-nav">
        <a href="#come-funziona">Come funziona</a>
        <a href="#prodotto">Il prodotto</a>
        <a href="#prezzo">Prezzo</a>
        <button class="v5-button js-v5-open" type="button">Provalo sulla tua attività</button>
      </div>
    </header>

    <main><slot /></main>

    <footer class="v5-footer">
      <div class="v5-wrap v5-footer-main">
        <div>
          <a class="v5-logo v5-logo-light" href="/brand-demo-v5/">TROVATEM<span>I<i>★</i></span>.IT</a>
          <p>Più recensioni vere.<br />Più motivi per scegliere te.</p>
        </div>
        <div>
          <span>PRODOTTO</span>
          <a href="#come-funziona">Come funziona</a>
          <a href="#prodotto">Cosa include</a>
          <a href="#prezzo">Prezzo</a>
        </div>
        <div>
          <span>PROSSIMO PASSO</span>
          <button class="js-v5-open" type="button">Apri la demo</button>
          <a href="#chris">Parla con Chris</a>
        </div>
      </div>
      <div class="v5-wrap v5-footer-bottom">
        <span>© 2026 TROVATEMI.IT</span>
        <span>TI FACCIAMO TROVARE DOVE CONTA.</span>
        <span>PROTOTIPO V5 · NOINDEX</span>
      </div>
    </footer>

    <dialog class="v5-dialog" aria-labelledby="v5-dialog-title">
      <button class="v5-dialog-close" type="button" aria-label="Chiudi">×</button>
      <div class="v5-dialog-grid">
        <div class="v5-dialog-copy">
          <span>DEMO LOCALE · 30 SECONDI</span>
          <h2 id="v5-dialog-title">VEDI TROVATEMI CON I TUOI NUMERI.</h2>
          <p>Inserisci soltanto il nome dell’attività e il numero attuale di recensioni. La pagina si aggiorna nel browser: non salviamo né inviamo nulla.</p>
          <div><i></i> Nessuna integrazione attiva</div>
        </div>
        <form class="v5-simulator-form">
          <label>
            Nome dell’attività
            <input name="business" type="text" autocomplete="organization" value="Attività Demo" required />
          </label>
          <label>
            Recensioni Google attuali
            <input name="reviews" type="number" inputmode="numeric" min="0" max="9999" value="24" required />
          </label>
          <button class="v5-button v5-simulator-submit" type="submit">Apri la mia demo <span>→</span></button>
          <small>Demo simulata. Non effettua ricerche e non si collega a Google.</small>
        </form>
      </div>
    </dialog>

    <script is:inline>
      const menuButton = document.querySelector('.v5-menu');
      const mobileNav = document.querySelector('.v5-mobile-nav');
      menuButton?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('open') ?? false;
        menuButton.setAttribute('aria-expanded', String(open));
      });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        menuButton?.setAttribute('aria-expanded', 'false');
      }));

      const dialog = document.querySelector('.v5-dialog');
      document.querySelectorAll('.js-v5-open').forEach((button) => {
        button.addEventListener('click', () => dialog?.showModal());
      });
      document.querySelector('.v5-dialog-close')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      const setDemoNumbers = (reviews, nextReviews = reviews + 1) => {
        document.querySelectorAll('[data-demo-reviews]').forEach((element) => {
          element.textContent = String(reviews);
        });
        document.querySelectorAll('[data-demo-next]').forEach((element) => {
          element.textContent = String(nextReviews);
        });
      };

      const form = document.querySelector('.v5-simulator-form');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const business = String(data.get('business') || 'Attività Demo').trim();
        const reviews = Math.max(0, Number(data.get('reviews') || 0));
        document.querySelectorAll('[data-demo-business]').forEach((element) => {
          element.textContent = business;
        });
        setDemoNumbers(reviews);
        document.body.dataset.baseReviews = String(reviews);
        dialog.close();
        document.querySelector('#product-demo')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      const demo = document.querySelector('.v5-live-demo');
      const demoButton = document.querySelector('.v5-demo-run');
      let demoTimer;
      demoButton?.addEventListener('click', () => {
        clearTimeout(demoTimer);
        const reviews = Number(document.body.dataset.baseReviews || 24);
        demo?.setAttribute('data-state', 'request');
        demoButton.disabled = true;
        demoButton.textContent = 'Richiesta inviata…';
        setTimeout(() => demo?.setAttribute('data-state', 'review'), 850);
        setTimeout(() => {
          demo?.setAttribute('data-state', 'done');
          setDemoNumbers(reviews + 1, reviews + 1);
          demoButton.textContent = 'Recensione ricevuta ✓';
        }, 1700);
        demoTimer = setTimeout(() => {
          demo?.setAttribute('data-state', 'idle');
          setDemoNumbers(reviews);
          demoButton.disabled = false;
          demoButton.textContent = 'Simula il percorso';
        }, 4300);
      });

      document.querySelectorAll('[data-product-tab]').forEach((button) => {
        button.addEventListener('click', () => {
          const tab = button.getAttribute('data-product-tab');
          document.querySelectorAll('[data-product-tab]').forEach((item) => {
            item.classList.toggle('active', item === button);
            item.setAttribute('aria-selected', String(item === button));
          });
          document.querySelectorAll('[data-product-panel]').forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-product-panel') === tab);
          });
        });
      });

      const responseButton = document.querySelector('.v5-response-button');
      responseButton?.addEventListener('click', () => {
        responseButton.closest('.v5-review-row')?.classList.toggle('response-open');
        responseButton.textContent = responseButton.textContent.includes('Aiutami') ? 'Nascondi risposta' : 'Aiutami a rispondere';
      });

      if ('IntersectionObserver' in window) {
        const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            reveal.unobserve(entry.target);
          }
        }), { threshold: 0.1 });
        document.querySelectorAll('.v5-reveal').forEach((element) => reveal.observe(element));
      } else {
        document.querySelectorAll('.v5-reveal').forEach((element) => element.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
