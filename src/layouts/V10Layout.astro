---
import '@fontsource-variable/archivo';
import '@fontsource-variable/space-grotesk';
import '@fontsource/anton/latin.css';
import '../styles/v10.css';
import Wordmark from '../components/v72/Wordmark.astro';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const previewUrl = 'https://trovatemi-web-v10-preview.soliwkr.workers.dev/brand-demo-v10/';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Trovatemi.it',
  url: 'https://trovatemi.it/',
  description,
  areaServed: 'IT',
  knowsAbout: ['Recensioni reali', 'Reputazione locale', 'Presenza Google per attività locali'],
};
---

<!doctype html>
<html lang="it" data-theme="trovatemi-v10">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b0d" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Trovatemi.it" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={previewUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body>
    <a class="v10-skip" href="#contenuto">Vai al contenuto</a>

    <div class="v10-preview-bar" role="status">
      <div class="v10-shell">
        <span>V10 · direzione creativa isolata</span>
        <span>V9 e produzione restano intatte</span>
      </div>
    </div>

    <header class="v10-header" data-v10-header>
      <div class="v10-shell">
        <nav class="v10-nav" aria-label="Navigazione principale">
          <Wordmark href="/brand-demo-v10/" />

          <ul class="v10-nav__links">
            <li><a href="#problema">Perché</a></li>
            <li><a href="#sistema">Il sistema</a></li>
            <li><a href="#trial">14 giorni</a></li>
            <li><a href="#piani">I piani</a></li>
          </ul>

          <button class="btn v10-btn v10-btn--yellow v10-nav__cta" type="button" data-audit-open data-source="header">
            Guarda la mia attività <span aria-hidden="true">↗</span>
          </button>

          <details class="v10-menu" data-mobile-menu>
            <summary aria-label="Apri il menu"><span></span><span></span></summary>
            <div class="v10-menu__panel">
              <a href="#problema">Perché</a>
              <a href="#sistema">Il sistema</a>
              <a href="#trial">14 giorni</a>
              <a href="#piani">I piani</a>
              <button class="btn v10-btn v10-btn--yellow" type="button" data-audit-open data-source="menu">Guarda la mia attività ↗</button>
              <button class="v10-plain-link" type="button" data-whatsapp-open>Scrivi a Chris</button>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main id="contenuto"><slot /></main>

    <footer class="v10-footer">
      <div class="v10-shell v10-footer__top">
        <div class="v10-footer__statement">
          <Wordmark href="/brand-demo-v10/" />
          <p>La qualità c’è già.<br />Noi facciamo in modo che si veda.</p>
        </div>
        <div class="v10-footer__links">
          <div><strong>Il percorso</strong><a href="#problema">Il problema</a><a href="#sistema">Il sistema</a><a href="#trial">La prova</a></div>
          <div><strong>Le regole</strong><a href="#faq">Niente promesse facili</a><button type="button" data-whatsapp-open>Parla con Chris</button></div>
        </div>
      </div>
      <div class="v10-shell v10-footer__bottom">
        <span>© 2026 Trovatemi.it</span>
        <b>Ti facciamo trovare dove conta.</b>
        <span>V10 · noindex</span>
      </div>
    </footer>

    <aside class="v10-mobile-cta" data-mobile-audit hidden>
      <button type="button" class="v10-mobile-cta__close" aria-label="Nascondi" data-mobile-audit-close>×</button>
      <button class="btn v10-btn v10-btn--yellow" type="button" data-audit-open data-source="sticky-mobile">Fammi vedere cosa trova un cliente ↗</button>
    </aside>

    <dialog class="modal v10-modal" aria-labelledby="v10-audit-title" data-audit-dialog>
      <div class="v10-modal__shell v10-audit">
        <button class="v10-modal__close" type="button" aria-label="Chiudi" data-dialog-close>×</button>
        <div class="v10-audit__intro">
          <span class="v10-kicker v10-kicker--yellow">Prima guardiamo. Poi parliamo.</span>
          <h2 id="v10-audit-title">Cosa trova oggi un cliente?</h2>
          <p>Chris apre il tuo profilo come farebbe una persona che non ti conosce. Guarda cosa ispira fiducia, cosa manca e chi appare più facile da scegliere.</p>
          <div class="v10-audit__steps"><span>01 · Profilo</span><span>02 · Confronto</span><span>03 · Prossimo passo</span></div>
          <small>Preview: nessun dato viene inviato o conservato.</small>
        </div>

        <form class="v10-audit__form" data-audit-form>
          <div class="v10-form-grid">
            <label><span>Nome</span><input name="name" type="text" autocomplete="name" placeholder="Il tuo nome" required /></label>
            <label><span>Attività</span><input name="business" type="text" autocomplete="organization" placeholder="Nome dell’attività" required /></label>
            <label><span>Città</span><input name="city" type="text" autocomplete="address-level2" placeholder="Dove lavori" required /></label>
            <label><span>Categoria</span><input name="category" type="text" placeholder="Es. dentista, ristorante" required /></label>
          </div>
          <label><span>Telefono o WhatsApp</span><input name="contact" type="tel" autocomplete="tel" placeholder="Il numero su cui ricontattarti" required /></label>
          <label><span>Link del profilo Google <small>facoltativo</small></span><input name="google" type="url" inputmode="url" placeholder="https://maps.google.com/..." /></label>
          <button class="btn v10-btn v10-btn--yellow" type="submit">Analizza la mia attività →</button>
          <p class="v10-form-note">Nessuna promessa di primo posto. Guardiamo la situazione reale.</p>

          <div class="v10-audit__result" aria-live="polite" data-audit-result hidden>
            <span class="v10-kicker">Richiesta preparata</span>
            <h3>Chris guarderà il profilo e ti ricontatterà per mostrarti cosa vede oggi un cliente.</h3>
            <p data-audit-summary></p>
            <button class="btn v10-btn v10-btn--dark" type="button" data-copy-request>Copia la richiesta</button>
          </div>
        </form>
      </div>
    </dialog>

    <dialog class="modal v10-modal" aria-labelledby="v10-demo-title" data-demo-dialog>
      <div class="v10-modal__shell v10-demo">
        <button class="v10-modal__close v10-modal__close--dark" type="button" aria-label="Chiudi" data-dialog-close>×</button>
        <header>
          <span class="v10-kicker v10-kicker--yellow">Demo interattiva · esempio illustrativo</span>
          <h2 id="v10-demo-title">Un gesto. Una recensione. Una prova pubblica.</h2>
          <p>Nessun messaggio viene inviato e nessuna recensione viene pubblicata.</p>
        </header>
        <div class="v10-demo__grid">
          <ol class="v10-demo__controls">
            <li><button class="is-active" type="button" data-demo-control="1" aria-pressed="true"><b>01</b><span>Il momento giusto</span></button></li>
            <li><button type="button" data-demo-control="2" aria-pressed="false"><b>02</b><span>Il gesto</span></button></li>
            <li><button type="button" data-demo-control="3" aria-pressed="false"><b>03</b><span>L’esperienza</span></button></li>
            <li><button type="button" data-demo-control="4" aria-pressed="false"><b>04</b><span>La prova pubblica</span></button></li>
          </ol>
          <div class="v10-demo-phone" data-demo-phone data-step="1">
            <div class="v10-demo-phone__top"><i></i><span>trovatemi.it</span><b></b></div>
            <section data-demo-panel="1"><small>01 · Il momento giusto</small><strong>“Tutto perfetto, grazie.”</strong><p>È qui che una buona esperienza può diventare visibile.</p><button class="btn v10-btn v10-btn--yellow" type="button" data-demo-next="2">Avvicina il telefono</button></section>
            <section data-demo-panel="2"><small>02 · NFC o QR</small><strong>Un gesto. Nessuna ricerca.</strong><div class="v10-demo-tap"><i>)))</i><b>TOCCA QUI</b></div><button class="btn v10-btn v10-btn--yellow" type="button" data-demo-next="3">Apri il percorso</button></section>
            <section data-demo-panel="3"><small>03 · Stesso percorso per tutti</small><strong>Racconta com’è andata.</strong><div class="v10-demo-stars">★★★★★</div><p>L’opinione resta del cliente. Nessun filtro sul voto.</p><button class="btn v10-btn v10-btn--yellow" type="button" data-demo-next="4">Continua su Google</button></section>
            <section data-demo-panel="4"><small>04 · Il titolare vede</small><strong>Nuova recensione pubblica.</strong><article><span>★★★★★</span><p>Servizio preciso. Mi hanno spiegato tutto con chiarezza.</p></article><i class="v10-demo-check">✓</i></section>
          </div>
          <div class="v10-demo__side">
            <span>Esempio illustrativo</span>
            <p>Trovatemi non chiede al cliente di imparare nulla. Riduce la distanza tra il momento in cui è soddisfatto e quello in cui lo racconta.</p>
            <button class="btn v10-btn v10-btn--yellow" type="button" data-audit-from-demo>Fallo sulla mia attività ↗</button>
          </div>
        </div>
      </div>
    </dialog>

    <dialog class="modal v10-modal" aria-labelledby="v10-whatsapp-title" data-whatsapp-dialog>
      <div class="v10-modal__shell v10-whatsapp">
        <button class="v10-modal__close" type="button" aria-label="Chiudi" data-dialog-close>×</button>
        <span class="v10-kicker">Contatto diretto</span>
        <h2 id="v10-whatsapp-title">Se scrivi, risponde Chris.</h2>
        <p>Il numero WhatsApp ufficiale non è collegato in questa preview. Il messaggio è pronto.</p>
        <blockquote data-whatsapp-message>Ciao Chris, vorrei vedere cosa trova oggi un cliente quando cerca la mia attività.</blockquote>
        <button class="btn v10-btn v10-btn--dark" type="button" data-copy-whatsapp>Copia il messaggio</button>
      </div>
    </dialog>

    <script is:inline>
      (() => {
        const $ = (selector, root = document) => root.querySelector(selector);
        const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
        const auditDialog = $('[data-audit-dialog]');
        const demoDialog = $('[data-demo-dialog]');
        const whatsappDialog = $('[data-whatsapp-dialog]');
        const mobileAudit = $('[data-mobile-audit]');
        const mobileMenu = $('[data-mobile-menu]');
        let heroVisible = true;
        let auditBarDismissed = false;

        const syncOverlay = () => {
          const open = $$('dialog[open]').length > 0 || Boolean(mobileMenu?.open);
          document.documentElement.classList.toggle('v10-overlay-open', open);
          mobileAudit?.toggleAttribute('hidden', open || heroVisible || auditBarDismissed);
        };

        const openDialog = (dialog) => {
          if (!dialog || typeof dialog.showModal !== 'function') return;
          if (!dialog.open) dialog.showModal();
          syncOverlay();
        };

        $$('[data-audit-open]').forEach((button) => button.addEventListener('click', () => {
          mobileMenu?.removeAttribute('open');
          openDialog(auditDialog);
        }));
        $$('[data-demo-open]').forEach((button) => button.addEventListener('click', () => openDialog(demoDialog)));
        $$('[data-whatsapp-open]').forEach((button) => button.addEventListener('click', () => {
          mobileMenu?.removeAttribute('open');
          openDialog(whatsappDialog);
        }));
        $$('[data-dialog-close]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
        $$('dialog').forEach((dialog) => {
          dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
          dialog.addEventListener('close', syncOverlay);
        });
        mobileMenu?.addEventListener('toggle', syncOverlay);
        $$('[data-mobile-menu] a').forEach((link) => link.addEventListener('click', () => mobileMenu?.removeAttribute('open')));

        $('[data-mobile-audit-close]')?.addEventListener('click', () => {
          auditBarDismissed = true;
          mobileAudit?.setAttribute('hidden', '');
        });

        const hero = $('[data-v10-hero]');
        const syncHero = () => {
          if (!hero) return;
          heroVisible = hero.getBoundingClientRect().bottom > Math.max(110, innerHeight * 0.22);
          syncOverlay();
        };
        syncHero();
        addEventListener('scroll', syncHero, { passive: true });
        addEventListener('resize', syncHero);

        const header = $('[data-v10-header]');
        const syncHeader = () => header?.classList.toggle('is-scrolled', scrollY > 20);
        syncHeader();
        addEventListener('scroll', syncHeader, { passive: true });

        const demoPhone = $('[data-demo-phone]');
        const setDemoStep = (step) => {
          if (!demoPhone) return;
          demoPhone.dataset.step = String(step);
          $$('[data-demo-control]').forEach((button) => {
            const active = button.dataset.demoControl === String(step);
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          });
        };
        $$('[data-demo-control]').forEach((button) => button.addEventListener('click', () => setDemoStep(button.dataset.demoControl)));
        $$('[data-demo-next]').forEach((button) => button.addEventListener('click', () => setDemoStep(button.dataset.demoNext)));
        $('[data-audit-from-demo]')?.addEventListener('click', () => { demoDialog?.close(); openDialog(auditDialog); });

        $$('[data-story-tab]').forEach((button) => button.addEventListener('click', () => {
          const target = button.dataset.storyTab;
          $$('[data-story-tab]').forEach((item) => {
            const active = item.dataset.storyTab === target;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', String(active));
          });
          $$('[data-story-panel]').forEach((panel) => panel.toggleAttribute('hidden', panel.dataset.storyPanel !== target));
        }));

        $$('[data-plan-answer]').forEach((button) => button.addEventListener('click', () => {
          const target = button.dataset.planAnswer;
          $$('[data-plan-answer]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          $$('[data-plan-result]').forEach((result) => result.toggleAttribute('hidden', result.dataset.planResult !== target));
        }));

        const reveals = $$('[data-reveal]');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12 });
          reveals.forEach((item) => observer.observe(item));
        } else reveals.forEach((item) => item.classList.add('is-visible'));

        let auditCopy = '';
        const auditForm = $('[data-audit-form]');
        auditForm?.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!auditForm.reportValidity()) return;
          const data = new FormData(auditForm);
          const name = String(data.get('name') || '');
          const business = String(data.get('business') || '');
          const city = String(data.get('city') || '');
          const category = String(data.get('category') || '');
          const contact = String(data.get('contact') || '');
          const google = String(data.get('google') || 'non disponibile');
          auditCopy = `Ciao Chris, sono ${name}. Vorrei l’analisi di ${business}, ${category} a ${city}. Contatto: ${contact}. Profilo Google: ${google}.`;
          $('[data-audit-summary]').textContent = `${business} · ${category} · ${city}`;
          $('[data-audit-result]').hidden = false;
        });

        const copyText = async (text, button) => {
          try {
            await navigator.clipboard.writeText(text);
            const original = button.textContent;
            button.textContent = 'Copiato ✓';
            setTimeout(() => { button.textContent = original; }, 1800);
          } catch { button.textContent = 'Seleziona e copia'; }
        };
        $('[data-copy-request]')?.addEventListener('click', (event) => copyText(auditCopy, event.currentTarget));
        $('[data-copy-whatsapp]')?.addEventListener('click', (event) => copyText($('[data-whatsapp-message]')?.textContent || '', event.currentTarget));
      })();
    </script>
  </body>
</html>
