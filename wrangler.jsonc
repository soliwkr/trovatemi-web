{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trovatemi-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "trovatemi.it",
      "custom_domain": true
    },
    {
      "pattern": "www.trovatemi.it",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "services": [
    {
      "binding": "RADAR",
      "service": "trovatemi-radar-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "EVENTS_DB",
      "database_name": "trovatemi-events",
      "database_id": "90ff95e5-b4df-418d-bb75-024c1441fa8b",
      "migrations_dir": "migrations"
    }
  ]
}
