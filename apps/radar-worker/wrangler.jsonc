{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trovatemi-radar-preview",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "APP_ENV": "preview",
    "RUN_LIMIT": "12",
    "ACTIVATION_PRICE_EUR": "197",
    "PUBLIC_CHECK_BASE_URL": "https://check.trovatemi.it",
    "PUBLIC_HOME_URL": "https://trovatemi.it"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR_STORE",
        "class_name": "RadarStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RadarStore"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/c/*",
      "/go/*",
      "/health"
    ],
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "radar.trovatemi.it",
      "custom_domain": true
    },
    {
      "pattern": "check.trovatemi.it",
      "custom_domain": true
    }
  ]
}
